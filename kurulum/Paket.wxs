<!--
  Muhasebe Yönetim Sistemi kurulum paketi (WiX 5). Paketle.ps1 tarafından derlenir; elle derlemek için:
    dotnet wix build kurulum\Paket.wxs -ext WixToolset.Util.wixext -ext WixToolset.UI.wixext -d Kaynak=<uygulama klasörü> -d Surum=1.0.0 -o Kurulum.msi
  Program Files'a kurulur; ayarlar, loglar ve veritabanı C:\ProgramData\MuhasebeYonetim altında tutulur ve
  kaldırmada SİLİNMEZ (müşterinin verisi korunur). Yeni sürüm eski sürümün üzerine kurulur (MajorUpgrade).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Muhasebe Yönetim Sistemi"
           Manufacturer="Muhasebe Yönetim"
           Version="$(var.Surum)"
           UpgradeCode="6B1D2E1A-6F0C-4C7E-9B4E-3B2F6A9C5D11"
           Language="1055" Codepage="1254"
           Scope="perMachine" Compressed="yes">
    <SummaryInformation Description="Muhasebe Yönetim Sistemi Kurulumu" Codepage="1254" />

    <MajorUpgrade DowngradeErrorMessage="Bu bilgisayarda daha yeni bir sürüm kurulu. Kurulum durduruldu." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="WIXUI_INSTALLDIR" Value="UYGULAMAKLASORU" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)Lisans.rtf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <!-- Klasör adı Türkçe karaktersizdir: gömülü PostgreSQL'in ilk kurulumu (initdb) yolda "ö" gibi harfleri kabul etmez. -->
      <Directory Id="UYGULAMAKLASORU" Name="MuhasebeYonetim" />
    </StandardDirectory>

    <!-- Ortak veri klasörü: her Windows kullanıcısı ayar/log/veritabanı yazabilsin; kaldırmada silinmez. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="VERIKLASORU" Name="MuhasebeYonetim">
        <Component Id="VeriKlasoruIzinleri" Guid="9C3A7E52-1B6D-4F0E-8A2C-5D4B7E1F9A30" Permanent="yes">
          <CreateFolder>
            <util:PermissionEx User="Users" GenericAll="yes" />
          </CreateFolder>
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="BaslatMenusu" Name="Muhasebe Yönetim Sistemi">
        <Component Id="BaslatMenusuKisayolu" Guid="2E8F4A61-7C3B-4D9A-B1E5-6F0A2C8D4B72">
          <Shortcut Id="BaslatKisayolu" Name="Muhasebe Yönetim Sistemi" Target="[UYGULAMAKLASORU]Masaustu.exe" WorkingDirectory="UYGULAMAKLASORU" />
          <RemoveFolder Id="BaslatMenusuKaldir" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\MuhasebeYonetim" Name="BaslatKisayolu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="MasaustuKisayolu" Guid="5A1C9E37-3D6B-4E2F-8C4A-7B9D1E0F2A63">
        <Shortcut Id="MasaustuKisayoluOge" Name="Muhasebe Yönetim Sistemi" Target="[UYGULAMAKLASORU]Masaustu.exe" WorkingDirectory="UYGULAMAKLASORU" />
        <RegistryValue Root="HKLM" Key="Software\MuhasebeYonetim" Name="MasaustuKisayolu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Ağ sunucusu modunda veritabanı Windows hizmeti olarak çalışır (Ayarlar > Ağ). Kurulum/güncelleme sırasında
         dosyaları değiştirilebilsin diye durdurulur; program açılınca yeniden başlatır. Hizmet yoksa adım atlanır. -->
    <Component Id="VeritabaniHizmetiDenetimi" Directory="UYGULAMAKLASORU" Guid="3F6B2D84-9E1A-4C7D-A5B3-8D2E6F1C0B97">
      <RegistryValue Root="HKLM" Key="Software\MuhasebeYonetim" Name="HizmetDenetimi" Type="integer" Value="1" KeyPath="yes" />
      <ServiceControl Id="VeritabaniHizmetiDurdur" Name="MuhasebeYonetimVeritabani" Stop="both" Wait="yes" />
    </Component>

    <!-- Program tamamen kaldırılınca (güncellemede değil) hizmet kaydı ve güvenlik duvarı kuralı silinir; veriler kalır. -->
    <CustomAction Id="HizmetiSil" Directory="System64Folder" ExeCommand="&quot;[System64Folder]sc.exe&quot; delete MuhasebeYonetimVeritabani"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="GuvenlikDuvariKuraliniSil" Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule &quot;name=Muhasebe Yönetim Veritabanı&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="HizmetiSil" After="StopServices" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="GuvenlikDuvariKuraliniSil" After="HizmetiSil" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Feature Id="Uygulama" Title="Muhasebe Yönetim Sistemi" Level="1">
      <ComponentRef Id="VeritabaniHizmetiDenetimi" />
      <!-- Yayınlanan uygulama ve gömülü PostgreSQL (pgsql) klasörünün tamamı -->
      <Files Directory="UYGULAMAKLASORU" Include="$(var.Kaynak)\**" />
      <ComponentRef Id="VeriKlasoruIzinleri" />
      <ComponentRef Id="BaslatMenusuKisayolu" />
      <ComponentRef Id="MasaustuKisayolu" />
    </Feature>
  </Package>
</Wix>
