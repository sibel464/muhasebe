<Window x:Class="Masaustu.Gorunumler.Ana.AnaPencere"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gm="clr-namespace:Masaustu.GorunumModelleri"
        xmlns:sayfa="clr-namespace:Masaustu.Gorunumler.Sayfa"
        Title="Muhasebe Yönetim Sistemi"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- DataTemplate - Navigasyon eşleştirmesi -->
            <DataTemplate DataType="{x:Type gm:DashboardGorunumModeli}">
                <sayfa:DashboardSayfasi/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type gm:MusteriGorunumModeli}">
                <sayfa:MusteriSayfasi/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type gm:TedarikciGorunumModeli}">
                <sayfa:TedarikciSayfasi/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type gm:UrunGorunumModeli}">
                <sayfa:UrunSayfasi/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type gm:FaturaGorunumModeli}">
                <sayfa:FaturaSayfasi/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type gm:KasaGorunumModeli}">
                <sayfa:KasaSayfasi/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type gm:BankaGorunumModeli}">
                <sayfa:BankaSayfasi/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type gm:RaporGorunumModeli}">
                <sayfa:RaporSayfasi/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type gm:AyarlarGorunumModeli}">
                <sayfa:AyarlarSayfasi/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="5" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════
                 SOL MENÜ
            ═══════════════════════════════════════════ -->
            <Border Grid.Column="0" Background="{StaticResource MenuGradient}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <Border Grid.Row="0" Padding="20,24,20,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="36" Height="36" CornerRadius="10"
                                        Background="#2AFFFFFF" Margin="0,0,12,0">
                                    <TextBlock Text="M" FontSize="18" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Muhasebe" FontSize="15" FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock Text="Yönetim Sistemi" FontSize="10"
                                               Foreground="#80FFFFFF"/>
                                </StackPanel>
                            </StackPanel>
                            <Separator Style="{StaticResource MenuAyirici}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Menü Öğeleri -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="0,8">

                            <Button Command="{Binding DashboardKomutu}" Height="48"
                                    Style="{StaticResource MenuOgeDugme}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="CARİ" Foreground="#50FFFFFF" FontSize="10"
                                       FontWeight="SemiBold" Margin="28,16,0,4"/>

                            <Button Command="{Binding MusteriKomutu}" Height="48"
                                    Style="{StaticResource MenuOgeDugme}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👥" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Müşteriler" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding TedarikciKomutu}" Height="48"
                                    Style="{StaticResource MenuOgeDugme}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏭" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tedarikçiler" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="STOK" Foreground="#50FFFFFF" FontSize="10"
                                       FontWeight="SemiBold" Margin="28,16,0,4"/>

                            <Button Command="{Binding UrunKomutu}" Height="48"
                                    Style="{StaticResource MenuOgeDugme}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ürünler" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="FİNANS" Foreground="#50FFFFFF" FontSize="10"
                                       FontWeight="SemiBold" Margin="28,16,0,4"/>

                            <Button Command="{Binding FaturaKomutu}" Height="48"
                                    Style="{StaticResource MenuOgeDugme}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧾" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Faturalar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding KasaKomutu}" Height="48"
                                    Style="{StaticResource MenuOgeDugme}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kasa" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding BankaKomutu}" Height="48"
                                    Style="{StaticResource MenuOgeDugme}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏦" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Banka" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="DİĞER" Foreground="#50FFFFFF" FontSize="10"
                                       FontWeight="SemiBold" Margin="28,16,0,4"/>

                            <Button Command="{Binding RaporKomutu}" Height="48"
                                    Style="{StaticResource MenuOgeDugme}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Raporlar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding AyarlarKomutu}" Height="48"
                                    Style="{StaticResource MenuOgeDugme}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ayarlar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Alt Kullanıcı Bilgisi -->
                    <Border Grid.Row="2" Padding="16,12" Background="#15FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{StaticResource LacivertVurguFirca}">
                                <TextBlock Text="A" FontSize="14" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock Text="{Binding KullaniciAdi}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Yönetici" FontSize="10" Foreground="#70FFFFFF"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="⏻"
                                    Command="{Binding CikisKomutu}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#70FFFFFF" FontSize="16" Cursor="Hand"
                                    ToolTip="Çıkış Yap"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════
                 SAĞ İÇERİK ALANI
            ═══════════════════════════════════════════ -->
            <Grid Grid.Column="1" Background="{StaticResource GriAcikFirca}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Üst Bar -->
                <Border Grid.Row="0" Background="White"
                        BorderBrush="{StaticResource GriOrtaFirca}" BorderThickness="0,0,0,1">
                    <Grid Margin="24,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='dd.MM.yyyy'}"
                                       FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"
                                       Margin="0,0,16,0"
                                       xmlns:sys="clr-namespace:System;assembly=mscorlib"/>
                            <!-- Pencere kontrol düğmeleri -->
                            <Button Content="—" Background="Transparent" BorderThickness="0"
                                    Foreground="#9CA3AF" FontSize="14" Width="32" Height="32"
                                    Cursor="Hand" Click="KucultDugmeTiklandi"/>
                            <Button Content="□" Background="Transparent" BorderThickness="0"
                                    Foreground="#9CA3AF" FontSize="14" Width="32" Height="32"
                                    Cursor="Hand" Click="BuyutDugmeTiklandi"/>
                            <Button Content="✕" Background="Transparent" BorderThickness="0"
                                    Foreground="#9CA3AF" FontSize="14" Width="32" Height="32"
                                    Cursor="Hand" Click="KapatDugmeTiklandi"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- İçerik (ContentControl + DataTemplate ile navigasyon) -->
                <ContentControl Grid.Row="1"
                                Content="{Binding MevcutSayfa}"
                                Margin="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
