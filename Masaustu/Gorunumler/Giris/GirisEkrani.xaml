<Window x:Class="Masaustu.Gorunumler.Giris.GirisEkrani"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
        Title="Muhasebe Yönetim Sistemi - Giriş"
        Width="900" MinHeight="600" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="White"
        ShowInTaskbar="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Sol Panel - Marka -->
            <Border Grid.Column="0" Background="{StaticResource MenuGradient}">
                <Grid>
                    <!-- Dekoratif Daireler -->
                    <Ellipse Width="300" Height="300" Fill="#0AFFFFFF"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-100,-100,0,0"/>
                    <Ellipse Width="200" Height="200" Fill="#0AFFFFFF"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-80,-80"/>

                    <StackPanel VerticalAlignment="Center" Margin="50,0">
                        <!-- Logo Alanı -->
                        <Border Width="64" Height="64" CornerRadius="16"
                                Background="#2AFFFFFF" HorizontalAlignment="Left" Margin="0,0,0,24">
                            <TextBlock Text="M" FontSize="32" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Muhasebe" FontSize="32" FontWeight="Bold"
                                   Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="Yönetim Sistemi" FontSize="18"
                                   Foreground="#80FFFFFF" Margin="0,0,0,32"/>

                        <Separator Background="#30FFFFFF" Height="1" Margin="0,0,0,32"/>

                        <TextBlock Text="✓  Fatura Yönetimi" Foreground="#A0FFFFFF"
                                   FontSize="13" Margin="0,0,0,12"/>
                        <TextBlock Text="✓  Cari Hesap Takibi" Foreground="#A0FFFFFF"
                                   FontSize="13" Margin="0,0,0,12"/>
                        <TextBlock Text="✓  Stok Yönetimi" Foreground="#A0FFFFFF"
                                   FontSize="13" Margin="0,0,0,12"/>
                        <TextBlock Text="✓  Kasa &amp; Banka İşlemleri" Foreground="#A0FFFFFF"
                                   FontSize="13" Margin="0,0,0,12"/>
                        <TextBlock Text="✓  Gelir Gider Raporları" Foreground="#A0FFFFFF"
                                   FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sağ Panel - Giriş Formu -->
            <Border Grid.Column="1" Background="White">
                <Grid VerticalAlignment="Center" Margin="48,44,48,28">
                    <StackPanel>
                        <TextBlock Text="Hoş Geldiniz" FontSize="26" FontWeight="Bold"
                                   Foreground="#1A2F5E" Margin="0,0,0,4"/>
                        <TextBlock Text="Hesabınıza giriş yapın" FontSize="13"
                                   Foreground="#6B7280" Margin="0,0,0,40"/>

                        <!-- Kullanıcı Adı -->
                        <TextBlock Text="Kullanıcı Adı" Style="{StaticResource EtiketMetin}"/>
                        <TextBox x:Name="KullaniciAdiKutusu"
                                 Style="{StaticResource ModernMetinKutusu}"
                                 Text="{Binding KullaniciAdi, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16"
                                 Height="44"/>

                        <!-- Şifre -->
                        <TextBlock Text="Şifre" Style="{StaticResource EtiketMetin}"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="SifreKutusu"
                                         Style="{StaticResource ModernSifreKutusu}"
                                         Height="44" Padding="12,0,8,0"
                                         PasswordChanged="SifreDegisti"
                                         KeyDown="KlavyeTusuBasildi"/>

                            <TextBox x:Name="AcikSifreKutusu"
                                     Style="{StaticResource ModernMetinKutusu}"
                                     Height="44" Padding="12,0,8,0"
                                     Visibility="Collapsed"
                                     TextChanged="AcikSifreDegisti"
                                     KeyDown="KlavyeTusuBasildi"/>

                            <Button Grid.Column="1" x:Name="SifreGosterDugmesi"
                                    Content="👁️" FontSize="16" Foreground="#9CA3AF"
                                    Background="Transparent" BorderThickness="0"
                                    Margin="4,0" Cursor="Hand" ToolTip="Şifreyi Göster"
                                    Click="SifreGosterGizleTiklandi"/>

                            <Button Grid.Column="2" x:Name="SifreTemizleDugmesi"
                                    Content="✕" FontSize="14" Foreground="#9CA3AF"
                                    Background="Transparent" BorderThickness="0"
                                    Margin="4,0,8,0" Cursor="Hand" ToolTip="Temizle"
                                    Click="SifreTemizleTiklandi"/>
                        </Grid>

                        <!-- Caps Lock Uyarısı -->
                        <Border x:Name="CapsLockUyarisi" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                                CornerRadius="6" Padding="8" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Caps Lock Açık. Parolanızı girmeden önce Caps Lock tuşunun kapalı olduğundan emin olun."
                                           Foreground="#D97706" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Hata Mesajı -->
                        <TextBlock Text="{Binding HataMesaji}"
                                   Foreground="#EF4444"
                                   FontSize="12" Margin="0,0,0,16"
                                   Visibility="{Binding HataMesaji, Converter={StaticResource BosBoslukDonusturucu}}"/>

                        <!-- Giriş Düğmesi -->
                        <Button Content="Giriş Yap"
                                Command="{Binding GirisKomutu}"
                                Style="{StaticResource AnaDugme}"
                                Height="48" Margin="0,8,0,16"
                                x:Name="GirisDugmesi"
                                IsDefault="True"/>

                        <!-- Örnek verilerle tanıtım / gerçek verilere dönüş (kod tarafında doldurulur) -->
                        <StackPanel x:Name="OrnekPaneli" Margin="0,0,0,4"/>

                        <!-- Dokunmatik ekranlar için tuş takımı: varsayılan kapalı, son tercih hatırlanır -->
                        <Button x:Name="TusTakimiDugmesi" Click="TusTakimiDugmesi_Click" HorizontalAlignment="Center" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Foreground="#6B7280" FontSize="12" Padding="4" Margin="0,0,0,8"
                                Content="🔢 Tuş takımını göster" ToolTip="Dokunmatik ekranda şifreyi ekrandaki tuşlarla girin"/>

                        <!-- Sanal Numpad -->
                        <Grid x:Name="TusTakimi" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Margin" Value="3"/>
                                    <Setter Property="Height" Value="42"/>
                                    <Setter Property="FontSize" Value="18"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#1F2937"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <EventSetter Event="Click" Handler="NumpadTusaBasildi"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F3F4F6"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#E5E7EB"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>

                            <Button Grid.Row="0" Grid.Column="0" Content="1" Tag="1"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="2" Tag="2"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="3" Tag="3"/>

                            <Button Grid.Row="1" Grid.Column="0" Content="4" Tag="4"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="5" Tag="5"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="6" Tag="6"/>

                            <Button Grid.Row="2" Grid.Column="0" Content="7" Tag="7"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="8" Tag="8"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="9" Tag="9"/>

                            <Button Grid.Row="3" Grid.Column="0" Content="⌫" Tag="BACK" ToolTip="Son haneyi sil" FontSize="18" Foreground="#6B7280"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="0" Tag="0"/>
                            <Button Grid.Row="3" Grid.Column="2" Content="Temizle" Tag="CLEAR" ToolTip="Şifreyi temizle" FontSize="13" Foreground="#6B7280"/>
                        </Grid>

                        <TextBlock x:Name="SurumMetni" Text="Muhasebe Yönetim Sistemi"
                                   Foreground="#9CA3AF" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Kapat Düğmesi -->
            <Button Grid.Column="1" Content="✕"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,12,0"
                    Width="32" Height="32"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#9CA3AF" FontSize="14" Cursor="Hand"
                    Click="KapatDugmeTiklandi"/>
        </Grid>
    </Border>
</Window>
