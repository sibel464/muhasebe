<Window x:Class="Masaustu.Gorunumler.Pencere.FinansTransferPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finansal Transfer / Virman" Height="420" Width="520" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Kasa ↔ Banka ↔ Virman Transfer İşlemi" Style="{StaticResource SayfaBasligi}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Transfer Türü:" Style="{StaticResource EtiketMetin}"/>
            <ComboBox SelectedValue="{Binding TransferTuru}" SelectedValuePath="Tag" Style="{StaticResource FormAcilirKutu}" Margin="0,0,0,12">
                <ComboBoxItem Content="Kasa Virman (Kasa → Kasa)" Tag="KasaVirman"/>
                <ComboBoxItem Content="Banka Virman (Banka → Banka)" Tag="BankaVirman"/>
                <ComboBoxItem Content="Kasa → Banka Transferi (Para Yatırma)" Tag="KasaBanka"/>
                <ComboBoxItem Content="Banka → Kasa Transferi (Para Çekme)" Tag="BankaKasa"/>
            </ComboBox>

            <!-- Kaynak Seçimi -->
            <TextBlock Text="Kaynak:" Style="{StaticResource EtiketMetin}"/>
            <ComboBox ItemsSource="{Binding Kasalar}" DisplayMemberPath="KasaAdi" SelectedValuePath="Id" SelectedValue="{Binding SeciliKaynakKasaId}" Style="{StaticResource FormAcilirKutu}" Margin="0,0,0,12"/>

            <!-- Hedef Seçimi -->
            <TextBlock Text="Hedef:" Style="{StaticResource EtiketMetin}"/>
            <ComboBox ItemsSource="{Binding BankaHesaplari}" DisplayMemberPath="HesapAdi" SelectedValuePath="Id" SelectedValue="{Binding SeciliHedefBankaHesapId}" Style="{StaticResource FormAcilirKutu}" Margin="0,0,0,12"/>

            <!-- Tutar -->
            <TextBlock Text="Transfer Tutarı (₺):" Style="{StaticResource EtiketMetin}"/>
            <TextBox Text="{Binding Tutar, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Style="{StaticResource FormGirisKutusu}" Margin="0,0,0,12"/>

            <!-- Açıklama -->
            <TextBlock Text="Açıklama:" Style="{StaticResource EtiketMetin}"/>
            <TextBox Text="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}" Margin="0,0,0,12"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="İptal" Click="KapatClick" Style="{StaticResource IkinciDugme}" Width="90" Margin="0,0,8,0"/>
            <Button Command="{Binding KaydetKomutu}" Style="{StaticResource BirinciDugme}" Content="💾 Kaydet" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
