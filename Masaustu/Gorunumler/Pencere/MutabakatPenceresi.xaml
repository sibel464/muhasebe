<Window x:Class="Masaustu.Gorunumler.Pencere.MutabakatPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
        Title="Kasa / Banka Mutabakatı" SizeToContent="Height" Width="480" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimci:ParaTutariDonusturucu x:Key="ParaTutariDonusturucu"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Kasa Mutabakat İşlemi" Style="{StaticResource SayfaBasligi}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Kasa Seçiniz:" Style="{StaticResource EtiketMetin}"/>
            <ComboBox ItemsSource="{Binding Kasalar}" DisplayMemberPath="KasaAdi" SelectedValuePath="Id" SelectedValue="{Binding SeciliKasaId}" Style="{StaticResource FormAcilirKutu}" Margin="0,0,0,12"/>

            <TextBlock Text="Sistem Bakiyesi (₺):" Style="{StaticResource EtiketMetin}"/>
            <TextBox Text="{Binding SistemBakiyesi, Mode=OneWay, StringFormat={}{0:N2}}" Style="{StaticResource FormGirisKutusu}" IsReadOnly="True" Background="#F1F5F9" Margin="0,0,0,12"/>

            <TextBlock Text="Fiili Sayım Miktarı (₺):" Style="{StaticResource EtiketMetin}"/>
            <TextBox Text="{Binding FiiliSayim, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ParaTutariDonusturucu}}" Style="{StaticResource FormGirisKutusu}" Margin="0,0,0,12"/>

            <TextBlock Text="Fark Miktarı (₺):" Style="{StaticResource EtiketMetin}"/>
            <TextBox Text="{Binding Fark, Mode=OneWay, StringFormat={}{0:N2}}" Style="{StaticResource FormGirisKutusu}" IsReadOnly="True" FontWeight="Bold" Foreground="{StaticResource DangerDarkFirca}" Margin="0,0,0,12"/>

            <CheckBox Content="Fark Varsa Düzeltme Hareketi Oluştur" IsChecked="{Binding DuzeltmeHareketOlustur}" Margin="0,0,0,12"/>

            <TextBlock Text="Açıklama:" Style="{StaticResource EtiketMetin}"/>
            <TextBox Text="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}" Margin="0,0,0,12"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="İptal" Click="KapatClick" Style="{StaticResource IkinciDugme}" Width="90" Margin="0,0,8,0"/>
            <Button Command="{Binding KaydetKomutu}" Style="{StaticResource BirinciDugme}" Content="⚖️ Mutabakat Kaydet" Width="140"/>
        </StackPanel>
    </Grid>
</Window>
