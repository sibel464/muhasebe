<Window x:Class="Masaustu.Gorunumler.Pencere.Banka360Penceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Banka 360°" Height="680" Width="1080" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık Panel -->
        <Border Grid.Row="0" Background="#F8FAFC" Padding="14" CornerRadius="8" Margin="0,0,0,12" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding BankaHesapOzet.BankaAdi}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                        <TextBlock Text="{Binding BankaHesapOzet.HesapAdi, StringFormat=' - {0}'}" FontSize="16" Foreground="{StaticResource TextSecondaryFirca}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding BankaHesapOzet.Iban, StringFormat='IBAN: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryFirca}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="HESAP BAKİYESİ" FontSize="11" Style="{StaticResource EtiketMetin}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding BankaHesapOzet.Bakiye, StringFormat={}{0:N2} ₺}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 9 SEKMELİ BANKA 360 -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SeciliSekmeIndeksi}">
            <!-- 1. Genel -->
            <TabItem Header="1. Genel">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Banka Adı:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BankaHesapOzet.BankaAdi}" Margin="0,0,0,10"/>

                        <TextBlock Text="Hesap Kodu / Adı:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BankaHesapOzet.HesapAdi}" Margin="0,0,0,10"/>

                        <TextBlock Text="Hesap No:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BankaHesapOzet.HesapNo}" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="IBAN:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BankaHesapOzet.Iban}" Margin="0,0,0,10"/>

                        <TextBlock Text="Şube:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BankaHesapOzet.Sube}" Margin="0,0,0,10"/>

                        <TextBlock Text="Para Birimi:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BankaHesapOzet.ParaBirimi}" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 2. Hareketler -->
            <TabItem Header="2. Hareketler">
                <DataGrid ItemsSource="{Binding TumHareketler}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                        <DataGridTextColumn Header="SAAT" Binding="{Binding Saat}" Width="65"/>
                        <DataGridTextColumn Header="İŞLEM NO" Binding="{Binding IslemNo}" Width="100"/>
                        <DataGridTextColumn Header="İŞLEM TÜRÜ" Binding="{Binding IslemTuru}" Width="110"/>
                        <DataGridTextColumn Header="CARİ" Binding="{Binding CariUnvan}" Width="*"/>
                        <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="1.5*"/>
                        <DataGridTextColumn Header="GİRİŞ" Binding="{Binding Giris, StringFormat={}{0:N2} ₺}" Width="100"/>
                        <DataGridTextColumn Header="ÇIKIŞ" Binding="{Binding Cikis, StringFormat={}{0:N2} ₺}" Width="100"/>
                        <DataGridTextColumn Header="BAKİYE" Binding="{Binding Bakiye, StringFormat={}{0:N2} ₺}" Width="110" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- 3. Tahsilatlar -->
            <TabItem Header="3. Tahsilatlar">
                <DataGrid ItemsSource="{Binding Tahsilatlar}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                        <DataGridTextColumn Header="CARİ" Binding="{Binding CariUnvan}" Width="*"/>
                        <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="1.5*"/>
                        <DataGridTextColumn Header="TUTAR" Binding="{Binding Giris, StringFormat={}{0:N2} ₺}" Width="120" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- 4. Ödemeler -->
            <TabItem Header="4. Ödemeler">
                <DataGrid ItemsSource="{Binding Odemeler}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                        <DataGridTextColumn Header="CARİ" Binding="{Binding CariUnvan}" Width="*"/>
                        <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="1.5*"/>
                        <DataGridTextColumn Header="TUTAR" Binding="{Binding Cikis, StringFormat={}{0:N2} ₺}" Width="120" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- 5. Transferler -->
            <TabItem Header="5. Transferler">
                <DataGrid ItemsSource="{Binding Transferler}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                        <DataGridTextColumn Header="İŞLEM TÜRÜ" Binding="{Binding IslemTuru}" Width="120"/>
                        <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="*"/>
                        <DataGridTextColumn Header="TUTAR" Binding="{Binding Tutar, StringFormat={}{0:N2} ₺}" Width="120" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- 6. POS/Kart -->
            <TabItem Header="6. POS/Kart">
                <DataGrid ItemsSource="{Binding PosIslemleri}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="POS CİHAZI" Binding="{Binding PosCihazi}" Width="120"/>
                        <DataGridTextColumn Header="BRÜT TUTAR" Binding="{Binding BrutTutar, StringFormat={}{0:N2} ₺}" Width="110"/>
                        <DataGridTextColumn Header="KOMİSYON" Binding="{Binding KomisyonTutari, StringFormat={}{0:N2} ₺}" Width="100"/>
                        <DataGridTextColumn Header="NET TUTAR" Binding="{Binding NetTutar, StringFormat={}{0:N2} ₺}" Width="120" FontWeight="Bold"/>
                        <DataGridTextColumn Header="DURUM" Binding="{Binding Durum}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- 7. Mutabakat -->
            <TabItem Header="7. Mutabakat">
                <TextBlock Text="Banka Ekstre / Sistem Bakiyesi Mutabakat Bilgisi" Margin="16" Style="{StaticResource EtiketMetin}"/>
            </TabItem>

            <!-- 8. Belgeler -->
            <TabItem Header="8. Belgeler">
                <TextBlock Text="Banka Dekontları ve Belgeler" Margin="16" Style="{StaticResource EtiketMetin}"/>
            </TabItem>

            <!-- 9. Audit -->
            <TabItem Header="9. Audit">
                <TextBlock Text="Banka Hesap Günlük Değişiklik İzi" Margin="16" Style="{StaticResource EtiketMetin}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
