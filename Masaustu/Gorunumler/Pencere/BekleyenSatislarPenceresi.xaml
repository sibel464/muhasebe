<Window x:Class="Masaustu.Gorunumler.Pencere.BekleyenSatislarPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bekleyen Satışlar" Width="900" Height="540" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F5F7FB">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><TextBlock Text="BEKLEYEN SATIŞLAR" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A"/>
            <TextBlock x:Name="Durum" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#64748B"/>
        </Grid>
        <DataGrid x:Name="SatisGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="44"
                  AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" MouseDoubleClick="SatisGrid_MouseDoubleClick" KeyDown="SatisGrid_KeyDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Bekletme No" Binding="{Binding FaturaNo}" Width="175"/>
                <DataGridTextColumn Header="Tarih / Saat" Binding="{Binding Tarih, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="145"/>
                <DataGridTextColumn Header="Cari" Binding="{Binding CariKart.Unvan}" Width="2*"/>
                <DataGridTemplateColumn Header="Kullanıcı" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="Sistem" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Ürün" Binding="{Binding Kalemler.Count}" Width="70"/>
                <DataGridTextColumn Header="Toplam" Binding="{Binding GenelToplam, StringFormat={}{0:N2} ₺}" Width="125"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Bekleyeni Sil" Width="125" Height="38" Margin="0,0,8,0" Click="Sil_Click" Background="#FEF2F2" Foreground="#B91C1C" BorderBrush="#FECACA"/>
            <Button Content="Satışı Aç" Width="120" Height="38" Click="Ac_Click" Background="#1D4ED8" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
