<Window x:Class="Masaustu.Gorunumler.Pencere.CekSenetDurumPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Çek / Senet Durum Güncelleme &amp; İşlem" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="#FAFAFA">

    <Border Padding="25">
        <StackPanel>
            <TextBlock Text="Belge İşlemleri &amp; Durum Güncelleme" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

            <!-- Belge Özet Bilgisi -->
            <Border Background="#EFF6FF" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#BFDBFE" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="BelgeOzetTxt" Text="Çek / Senet Özet Bilgisi" FontWeight="Bold" Foreground="#1E40AF" FontSize="14"/>
                        <TextBlock x:Name="CariOzetTxt" Text="Cari Ünvanı" Foreground="#3B82F6" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TutarOzetTxt" Grid.Column="1" Text="0.00 ₺" FontWeight="Bold" Foreground="#1E3A8A" FontSize="18" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Yeni Durum Seçimi -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Yeni Durum *" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="DurumCombo" Height="38" FontSize="14" SelectionChanged="DurumCombo_SelectionChanged">
                    <ComboBoxItem Content="Tahsil Edildi (Kasaya / Bankaya Para Girişi)"/>
                    <ComboBoxItem Content="Ciro Edildi (Tedarikçiye Borç Kapatma)"/>
                    <ComboBoxItem Content="Tahsile Verildi (Bankaya Takasa)"/>
                    <ComboBoxItem Content="Ödendi (Verilen Çek Ödemesi)"/>
                    <ComboBoxItem Content="Karşılıksız İşaretle"/>
                    <ComboBoxItem Content="İade Edildi"/>
                </ComboBox>
            </StackPanel>

            <!-- Kasa / Banka Hesabı Seçimi (Tahsil Edildi / Ödendi ise Görünür) -->
            <StackPanel x:Name="FinansHesapPanel" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="FinansLabel" Text="İşlem Yapılacak Kasa / Banka Hesabı *" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="FinansHesapCombo" Height="38" FontSize="14"/>
            </StackPanel>

            <!-- Ciro Edilecek Cari (Ciro Edildi ise Görünür) -->
            <StackPanel x:Name="CiroCariPanel" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Text="Çekin Verileceği Cari (Tedarikçi) *" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CiroCariTxt" Height="38" FontSize="14" Padding="8,0" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F1F5F9"/>
                    <Button Grid.Column="1" Content="Cari Seç..." Width="100" Height="38" Margin="8,0,0,0" Click="CiroCariSec_Click" Background="#3B82F6" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                </Grid>
            </StackPanel>

            <!-- Açıklama -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="İşlem Açıklaması / Not" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="AciklamaTxt" Height="60" FontSize="14" Padding="8" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Butonlar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="İptal" Width="100" Height="40" Margin="0,0,10,0" Click="Iptal_Click" Background="#E2E8F0" Foreground="#475569" BorderThickness="0" FontWeight="Bold"/>
                <Button Content="İşlemi Tamamla" Width="140" Height="40" Click="Kaydet_Click" Background="#3B82F6" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
