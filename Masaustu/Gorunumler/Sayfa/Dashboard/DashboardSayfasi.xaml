<UserControl x:Class="Masaustu.Gorunumler.Sayfa.DashboardSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 1. Başlık Alanı -->
                <RowDefinition Height="Auto"/> <!-- Başlarken (yeni kurulum) -->
                <RowDefinition Height="Auto"/> <!-- 2. KPI Kartları -->
                <RowDefinition Height="Auto"/> <!-- 3. Hızlı İşlemler & Aksiyonlar -->
                <RowDefinition Height="*"/>    <!-- 4. Bilgi ve Durum Paneli -->
            </Grid.RowDefinitions>

            <!-- 1. ÜST BAŞLIK ALANI -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource BaslikIkonKutusu}">
                        <TextBlock Text="📊" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Genel Bakış" Style="{StaticResource SayfaBasligi}"/>
                        <TextBlock Text="Güncel finansal göstergeler, operasyonel özetler ve hızlı erişim menüsü." Style="{StaticResource SayfaAltBaslik}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1">
            <!-- Zamanı gelmiş tekrarlayan faturalar (kira, aidat...): program kendiliğinden kesmez, hatırlatır -->
            <Border Background="{StaticResource WarningLightFirca}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                    BorderBrush="{StaticResource WarningDarkFirca}" BorderThickness="1"
                    Visibility="{Binding TekrarlayanUyarisiGorunur, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding TekrarlayanFaturalarKomutu}" Style="{StaticResource BirinciDugme}" VerticalAlignment="Center">
                        <TextBlock Text="🔁 Faturaları Gör ve Kes"/>
                    </Button>
                    <TextBlock Text="{Binding TekrarlayanUyarisi}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryFirca}"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                </DockPanel>
            </Border>

            <!-- BAŞLARKEN: yeni kurulumda eksik tanımlar; hepsi tamamlanınca gizlenir -->
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,24"
                    BorderBrush="{StaticResource WarningDarkFirca}" BorderThickness="1"
                    Visibility="{Binding BaslangicGorunur, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding BaslangicOzeti}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryFirca}" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="🚀 Başlarken" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                            <TextBlock Text="Programı kullanmaya başlamadan önce aşağıdaki tanımları tamamlayın. Bir adıma tıklayınca ilgili ekran açılır."
                                       FontSize="11" Foreground="{StaticResource TextSecondaryFirca}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding BaslangicAdimlari}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.AdimaGitKomutu, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Sayfa}" Cursor="Hand" Margin="0,0,0,6"
                                        ToolTip="İlgili ekranı açmak için tıklayın">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Kutu" Background="White" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1"
                                                    CornerRadius="8" Padding="12,8">
                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Kutu" Property="Background" Value="{StaticResource InfoLightFirca}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tamam}" Value="True">
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="16" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="⬜"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tamam}" Value="True">
                                                            <Setter Property="Text" Value="✅"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Baslik}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryFirca}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Aciklama}" FontSize="11" Foreground="{StaticResource TextSecondaryFirca}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- 2. KPI / ÖZET KARTLARI -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,24">
                <!-- Müşteri Kartı -->
                <Border Style="{StaticResource KpiKarti}" Margin="0,0,12,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="TOPLAM CARİ KART" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding MusteriSayisi}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                            <TextBlock Text="Kayıtlı Müşteri &amp; Tedarikçi" FontSize="11" Foreground="{StaticResource TextMutedFirca}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource InfoLightFirca}" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Ürün Kartı -->
                <Border Style="{StaticResource KpiKarti}" Margin="0,0,12,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="AKTİF STOK KARTLARI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding UrunSayisi}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Kritik Stok: " FontSize="11" Foreground="{StaticResource TextMutedFirca}"/>
                                <TextBlock Text="{Binding KritikStokSayisi}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningDarkFirca}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource WarningLightFirca}" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Fatura Kartı -->
                <Border Style="{StaticResource KpiKarti}" Margin="0,0,12,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="BU AYKİ FATURALAR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding AylikFatura}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryFirca}"/>
                            <TextBlock Text="Onaylanan Resmi Belge" FontSize="11" Foreground="{StaticResource TextMutedFirca}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource PrimaryLightFirca}" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="🧾" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Kasa Kartı -->
                <Border Style="{StaticResource KpiKarti}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="KASA NAKİT BAKİYESİ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding KasaBakiyesi, StringFormat='₺{0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessDarkFirca}"/>
                            <TextBlock Text="Aktif Nakit Durumu" FontSize="11" Foreground="{StaticResource SuccessFirca}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource SuccessLightFirca}" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- 3. HIZLI İŞLEMLER (Quick Action Cards) -->
            <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,24"
                    BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="⚡ Hızlı İşlemler &amp; Kısayollar" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}" Margin="0,0,0,16"/>

                    <UniformGrid Columns="3">
                        <!-- Yeni Müşteri / Cari -->
                        <Button Command="{Binding YeniMusteriKomutu}" Style="{StaticResource IkinciDugme}" Height="64" Margin="0,0,12,0" HorizontalContentAlignment="Left" Padding="16,0">
                            <Grid Width="220">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource InfoLightFirca}" Margin="0,0,12,0">
                                    <TextBlock Text="👥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Yeni Cari Kart Ekle" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryFirca}"/>
                                    <TextBlock Text="Müşteri / Tedarikçi Tanımla" FontSize="11" Foreground="{StaticResource TextSecondaryFirca}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Yeni Stok -->
                        <Button Command="{Binding YeniUrunKomutu}" Style="{StaticResource IkinciDugme}" Height="64" Margin="0,0,12,0" HorizontalContentAlignment="Left" Padding="16,0">
                            <Grid Width="220">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource WarningLightFirca}" Margin="0,0,12,0">
                                    <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Yeni Ürün / Stok Kartı" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryFirca}"/>
                                    <TextBlock Text="Stok &amp; Fiyat Girişi" FontSize="11" Foreground="{StaticResource TextSecondaryFirca}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Hızlı Satış (POS) -->
                        <Button Command="{Binding HizliSatisKomutu}" Style="{StaticResource BirinciDugme}" Height="64" HorizontalContentAlignment="Left" Padding="16,0">
                            <Grid Width="220">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="8" Background="#3B82F6" Margin="0,0,12,0">
                                    <TextBlock Text="🛒" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Hızlı Satış (POS Ekranı)" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                    <TextBlock Text="Barkodlu Satış &amp; Fiş Basımı" FontSize="11" Foreground="#DBEAFE"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 4. SİSTEM BİLGİ & GÜVENLİK DURUMU -->
            <Border Grid.Row="4" Background="White" CornerRadius="12" Padding="20"
                    BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="YEDEKLEME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}"/>
                        <TextBlock Text="{Binding SonYedekMetni}" FontWeight="Bold" FontSize="13" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessDarkFirca}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding YedekUyarisi}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerDarkFirca}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Program her gün otomatik yedek alır. Ayarlar &gt; Yedekleme bölümünden elle de alabilirsiniz." FontSize="11" Foreground="{StaticResource TextMutedFirca}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="KAYIT GÜVENLİĞİ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}"/>
                        <TextBlock Text="🛡️ Değişiklik geçmişi tutuluyor" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryFirca}" Margin="0,4,0,0"/>
                        <TextBlock Text="Her ekleme, düzeltme ve silme, yapan kullanıcıyla birlikte kaydedilir." FontSize="11" Foreground="{StaticResource TextMutedFirca}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ÇOK KULLANICILI ÇALIŞMA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}"/>
                        <TextBlock Text="🔒 Aynı anda işlem koruması açık" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryFirca}" Margin="0,4,0,0"/>
                        <TextBlock Text="İki kasada aynı anda satış yapılsa da stok ve bakiye doğru kalır." FontSize="11" Foreground="{StaticResource TextMutedFirca}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
