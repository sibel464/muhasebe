<UserControl x:Class="Masaustu.Gorunumler.Sayfa.TahsilatOdemeSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Masaustu.Yardimcilar"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <local:FinansMetinDonusturucu x:Key="FinansMetin"/>

        <!-- Kart stili -->
        <Style x:Key="Kart" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.07" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Etiket stili -->
        <Style x:Key="Alan" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Input stili -->
        <Style x:Key="Girdi" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="GirdiCB" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Bölüm başlık -->
        <Style x:Key="BolumBaslik" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Tutar info kutusu -->
        <Style x:Key="InfoKart" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#F1F5F9" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ████ BAŞLIK ████ -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding Baslik}" FontSize="30" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="{Binding AltBaslik}" Foreground="#64748B" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ████ ÜST BÖLÜM: CARİ + FORM ████ -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <!-- SOL: Cari Kart -->
                <Border Grid.Column="0" Style="{StaticResource Kart}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="CARİ HESAP" Style="{StaticResource BolumBaslik}"/>

                        <Button Content="🔍  Cari Hesap Seç" Command="{Binding CariSecKomutu}"
                                IsEnabled="{Binding IsCariSecilebilir}"
                                Visibility="{Binding IsCariSecilebilir, Converter={StaticResource BoolVis}}"
                                HorizontalAlignment="Left" Padding="18,9"
                                Background="#1E40AF" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>

                        <Border Visibility="{Binding IsCariKilitli, Converter={StaticResource BoolVis}}" 
                                Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="12,8" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔒  Sabit Cari Kilitli:" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SecilenCari.Unvan}" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>

                        <!-- Cari seçilmişse göster -->
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding SecilenCari, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding SecilenCari.Unvan}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding SecilenCari.Kod}" Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>

                            <Separator Margin="0,16" Background="#E2E8F0"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource InfoKart}" Background="#EFF6FF" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="MEVCUT BAKİYE" Style="{StaticResource Alan}"/>
                                        <TextBlock Text="{Binding MevcutBakiye, StringFormat={}{0:N2} ₺}"
                                                   FontSize="20" FontWeight="Bold" Foreground="#1D4ED8"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource InfoKart}" Background="#F0FDF4" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="İŞLEM SONRASI" Style="{StaticResource Alan}"/>
                                        <TextBlock Text="{Binding YeniBakiye, StringFormat={}{0:N2} ₺}"
                                                   FontSize="20" FontWeight="Bold" Foreground="#16A34A"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource InfoKart}" Background="#FEF3C7" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="AÇIK BELGE" Style="{StaticResource Alan}"/>
                                        <TextBlock Text="{Binding AcikBelgeler.Count, StringFormat={}{0} adet}"
                                                   FontSize="20" FontWeight="Bold" Foreground="#D97706"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Açık belgeler arama motorlu panel -->
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding AcikBelgeler.Count, Converter={StaticResource BoolVis}}">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="AÇIK BELGELER" Style="{StaticResource Alan}" VerticalAlignment="Center"/>
                                    <Button Content="✖ Tümünü Kaldır" Command="{Binding TumSeciliBelgeleriKaldirKomutu}"
                                            DockPanel.Dock="Right" Padding="8,4"
                                            Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"
                                            FontSize="10" Cursor="Hand" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                </DockPanel>

                                <!-- Arama Kutusu -->
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔍" Padding="10,9,4,9" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding BelgeArama, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="4,8" BorderThickness="0" Background="Transparent"
                                                 FontSize="12" Foreground="#334155"
                                                 VerticalContentAlignment="Center">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                                        <VisualBrush.Visual>
                                                                            <TextBlock Text="Belge no, açıklama, tarih, tutar ara..."
                                                                                       Foreground="#94A3B8" FontSize="11" Margin="4,9"/>
                                                                        </VisualBrush.Visual>
                                                                    </VisualBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </Border>

                                <!-- Çift Liste Paneli -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- SOL: Tüm Açık Belgeler (Filtrelenmiş) -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Foreground="#64748B" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4">
                                            <TextBlock.Text>
                                                <Binding Path="AcikBelgeler.Count" StringFormat="TÜM BELGELER ({0} adet)"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="White" Height="200">
                                            <ListBox ItemsSource="{Binding AcikBelgelerFiltreli}"
                                                     Background="Transparent" BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="10,8"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#EFF6FF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition/>
                                                                    <RowDefinition/>
                                                                </Grid.RowDefinitions>
                                                                <DockPanel>
                                                                    <TextBlock Text="{Binding Tarih, StringFormat=dd.MM.yy}"
                                                                               Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                                                                    <Border DockPanel.Dock="Right" Background="#FEE2E2" CornerRadius="4" Padding="5,2" Margin="6,0,0,0">
                                                                        <TextBlock Text="{Binding AcikTutar, StringFormat={}{0:N2} ₺}"
                                                                                   Foreground="#DC2626" FontWeight="Bold" FontSize="11"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding BelgeNo}" FontWeight="SemiBold" FontSize="12"
                                                                               Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                                                                </DockPanel>
                                                                <TextBlock Grid.Row="1" Text="{Binding Aciklama}" Foreground="#64748B"
                                                                           FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                                <!-- Seç Butonu (Mouse Over) -->
                                                                <Button Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                        Command="{Binding DataContext.BelgeSecKomutu, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Opacity="0" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                        <TextBlock Text="👆 Belgeye tıklayarak seçin" Foreground="#94A3B8"
                                                   FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- ORTA: Ok İkonu -->
                                    <TextBlock Grid.Column="1" Text="→" FontSize="18" Foreground="#94A3B8"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <!-- SAĞ: Seçilen Belgeler -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Foreground="#16A34A" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4">
                                            <TextBlock.Text>
                                                <Binding Path="SeciliBelgeler.Count" StringFormat="SEÇİLENLER ({0} adet)"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <Border BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Background="#F0FDF4" Height="200">
                                            <ListBox ItemsSource="{Binding SeciliBelgeler}"
                                                     Background="Transparent" BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="8,6"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="✕"
                                                                    Command="{Binding DataContext.BelgeKaldirKomutu, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="#DC2626" FontWeight="Bold"
                                                                    Padding="4,2" Cursor="Hand" FontSize="11"/>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding BelgeNo}" FontWeight="SemiBold"
                                                                           FontSize="11" Foreground="#166534" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding AcikTutar, StringFormat={}{0:N2} ₺}"
                                                                           Foreground="#16A34A" FontSize="11" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>

                                        <!-- Seçilen Toplam Tutar -->
                                        <Border Background="#DCFCE7" CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                                                BorderBrush="#86EFAC" BorderThickness="1">
                                            <DockPanel>
                                                <TextBlock Text="TOPLAM:" Foreground="#166534" FontSize="11"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ToplamSeciliBelgeTutar, StringFormat={}{0:N2} ₺}"
                                                           DockPanel.Dock="Right"
                                                           Foreground="#15803D" FontSize="14" FontWeight="Bold"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SAĞ: İşlem Formu -->
                <Border Grid.Column="2" Style="{StaticResource Kart}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="İŞLEM DETAYLARI" Style="{StaticResource BolumBaslik}"/>

                        <!-- Tarih ve Ödeme Yöntemi -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="İŞLEM TARİHİ" Style="{StaticResource Alan}"/>
                                <DatePicker SelectedDate="{Binding Tarih}" BorderBrush="#CBD5E1" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ÖDEME YÖNTEMİ" Style="{StaticResource Alan}"/>
                                <ComboBox ItemsSource="{Binding OdemeYontemleri}"
                                          SelectedItem="{Binding OdemeYontemi}"
                                          Style="{StaticResource GirdiCB}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource FinansMetin}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- PARANIN GİRDİĞİ / ÇIKTIĞI KASA veya BANKA HESABI -->
                        <StackPanel Margin="0,0,0,14" Visibility="{Binding KasaGorunur, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="KASA" Style="{StaticResource Alan}"/>
                            <ComboBox ItemsSource="{Binding Kasalar}" SelectedItem="{Binding SeciliKasa}"
                                      DisplayMemberPath="Ad" Style="{StaticResource GirdiCB}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14" Visibility="{Binding BankaHesabiGorunur, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="BANKA HESABI" Style="{StaticResource Alan}"/>
                            <ComboBox ItemsSource="{Binding BankaHesaplari}" SelectedItem="{Binding SeciliBankaHesabi}"
                                      DisplayMemberPath="Ad" Style="{StaticResource GirdiCB}"/>
                        </StackPanel>

                        <!-- BANKA / HAVALE PANELİ -->
                        <Border Visibility="{Binding BankaHavaleGorunur, Converter={StaticResource BoolVis}}"
                                Background="#EFF6FF" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                                BorderBrush="#BFDBFE" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🏦  KARŞI TARAFIN BANKA BİLGİLERİ (isteğe bağlı)" Style="{StaticResource Alan}" Foreground="#1D4ED8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="BANKA ADI" Style="{StaticResource Alan}"/>
                                        <TextBox Text="{Binding BankaAdi}" Style="{StaticResource Girdi}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="HESAP NO / IBAN" Style="{StaticResource Alan}"/>
                                        <TextBox Text="{Binding HesapNo}" Style="{StaticResource Girdi}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- KREDİ KARTI PANELİ -->
                        <Border Visibility="{Binding KrediKartiGorunur, Converter={StaticResource BoolVis}}"
                                Background="#F5F3FF" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                                BorderBrush="#DDD6FE" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💳  KREDİ KARTI BİLGİLERİ" Style="{StaticResource Alan}" Foreground="#7C3AED"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="POS / BANKA" Style="{StaticResource Alan}"/>
                                        <TextBox Text="{Binding PosAdi}" Style="{StaticResource Girdi}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="TAKSİT SAYISI" Style="{StaticResource Alan}"/>
                                        <ComboBox ItemsSource="{Binding TaksitSecenekleri}" SelectedItem="{Binding TaksitSayisi}" Style="{StaticResource GirdiCB}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="KOMİSYON ORANI (%)" Style="{StaticResource Alan}"/>
                                        <TextBox Text="{Binding KomisyonOrani}" Style="{StaticResource Girdi}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="NET HESABA GEÇECEK" Style="{StaticResource Alan}"/>
                                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,8" CornerRadius="4">
                                            <TextBlock Text="{Binding NetTutar, StringFormat={}{0:N2} ₺}"
                                                       FontWeight="Bold" Foreground="#16A34A" FontSize="14"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ÇEK / SENET PANELİ -->
                        <Border Visibility="{Binding CekSenetGorunur, Converter={StaticResource BoolVis}}"
                                Background="#FFF7ED" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                                BorderBrush="#FED7AA" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📄  ÇEK / SENET BİLGİLERİ" Style="{StaticResource Alan}" Foreground="#C2410C"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ÇEK / SENET NO" Style="{StaticResource Alan}"/>
                                        <TextBox Text="{Binding CekSenetNo}" Style="{StaticResource Girdi}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="VADE TARİHİ" Style="{StaticResource Alan}"/>
                                        <DatePicker SelectedDate="{Binding VadeTarihi}" BorderBrush="#CBD5E1" Padding="8,6"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel>
                                    <TextBlock Text="KESİDECİ / BORÇLU" Style="{StaticResource Alan}"/>
                                    <TextBox Text="{Binding Kesideci}" Style="{StaticResource Girdi}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- TUTAR + BELGE -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TUTAR (₺)" Style="{StaticResource Alan}"/>
                                <TextBox Text="{Binding Tutar, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Girdi}"
                                         FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="BELGE / MAKBUZ NO" Style="{StaticResource Alan}"/>
                                <TextBox Text="{Binding BelgeNo}" Style="{StaticResource Girdi}"/>
                            </StackPanel>
                        </Grid>

                        <!-- AÇIKLAMA -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="AÇIKLAMA" Style="{StaticResource Alan}"/>
                            <TextBox Text="{Binding Aciklama}" Style="{StaticResource Girdi}"
                                     MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>

                        <!-- KAYDET BUTONU -->
                        <Button Content="✔  Kaydet" Command="{Binding KaydetKomutu}"
                                HorizontalAlignment="Stretch" Padding="0,12"
                                Background="#16A34A" Foreground="White" BorderThickness="0"
                                FontWeight="Bold" FontSize="14" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ████ İŞLEM GEÇMİŞİ ████ -->
            <Border Grid.Row="3" Style="{StaticResource Kart}" Padding="24" Margin="0,0,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="İŞLEM GEÇMİŞİ" Style="{StaticResource BolumBaslik}" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="🔄  Yenile" Command="{Binding YenileKomutu}"
                                    Padding="14,7" Margin="0,0,8,0"
                                    Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="⛔  İptal / Ters Kayıt" Command="{Binding IptalKomutu}"
                                    Padding="14,7"
                                    Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid ItemsSource="{Binding Gecmis}"
                              SelectedItem="{Binding SecilenKayit}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              BorderThickness="0"
                              RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                            <DataGridTextColumn Header="Cari Kod" Binding="{Binding CariKod}" Width="90"/>
                            <DataGridTextColumn Header="Cari Unvan" Binding="{Binding CariUnvan}" Width="*"/>
                            <DataGridTextColumn Header="Yöntem" Binding="{Binding OdemeYontemi, Converter={StaticResource FinansMetin}}" Width="100"/>
                            <DataGridTextColumn Header="Tutar (₺)" Binding="{Binding Tutar, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="Belge No" Binding="{Binding BelgeNo}" Width="100"/>
                            <DataGridTextColumn Header="Durum" Binding="{Binding Durum, Converter={StaticResource FinansMetin}}" Width="100"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
