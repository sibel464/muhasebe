<UserControl x:Class="Masaustu.Gorunumler.Sayfa.FaturaEkleSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
             xmlns:fatura="clr-namespace:EtkiAlani.Modeller.Fatura;assembly=EtkiAlani"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Üst Başlık & Tür Seçimi -->
            <RowDefinition Height="*"/>    <!-- Ana Form & Kalemler & Özet -->
        </Grid.RowDefinitions>

        <!-- 1. ÜST PANEL: Başlık ve Tür Seçimi -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource BaslikIkonKutusu}">
                    <TextBlock Text="🧾" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="YENİ FATURA" Style="{StaticResource SayfaBasligi}"/>
                    <TextBlock Text="Satış / Alış faturası oluşturma" Style="{StaticResource SayfaAltBaslik}"/>
                </StackPanel>
            </StackPanel>

            <!-- Fatura Türü Seçim Butonları -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="📤 Satış Faturası" IsChecked="{Binding IsSatisFaturasi, Mode=OneWay}" Command="{Binding SatisTuruSecKomutu}"
                             GroupName="FaturaTuruGroup" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <RadioButton Content="📥 Alış Faturası" IsChecked="{Binding IsAlisFaturasi, Mode=OneWay}" Command="{Binding AlisTuruSecKomutu}"
                             GroupName="FaturaTuruGroup" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SuccessDarkFirca}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 2. ANA İÇERİK ALANI -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ÜST BİLGİLER KARTI -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16"
                        BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ödeme Şekli -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Ödeme Şekli *" Style="{StaticResource EtiketMetin}"/>
                            <ComboBox SelectedValue="{Binding OdemeSekli}" SelectedValuePath="Tag" Style="{StaticResource FormAcilirKutu}"
                                      IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True">
                                <ComboBoxItem Content="Açık Hesap" Tag="{x:Static fatura:FaturaOdemeSekli.AcikHesap}"/>
                                <ComboBoxItem Content="Nakit" Tag="{x:Static fatura:FaturaOdemeSekli.Nakit}"/>
                                <ComboBoxItem Content="Kredi Kartı" Tag="{x:Static fatura:FaturaOdemeSekli.KrediKarti}"/>
                                <ComboBoxItem Content="Banka" Tag="{x:Static fatura:FaturaOdemeSekli.Banka}"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Tarih -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Tarih *" Style="{StaticResource EtiketMetin}"/>
                            <DatePicker SelectedDate="{Binding Tarih}" Height="38" FontSize="13" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Vade -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Vade Tarihi" Style="{StaticResource EtiketMetin}"/>
                            <DatePicker SelectedDate="{Binding VadeTarihi}" Height="38" FontSize="13" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Cari Seçimi -->
                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,12,0">
                            <TextBlock Text="Müşteri / Tedarikçi (Cari) *" Style="{StaticResource EtiketMetin}"/>
                            <DockPanel>
                                <Button Content="Cari Seç" Command="{Binding CariSecKomutu}" 
                                        IsEnabled="{Binding IsCariSecilebilir}" 
                                        Visibility="{Binding IsCariSecilebilir, Converter={StaticResource BoolToVis}}" 
                                        Style="{StaticResource IkinciDugme}" Width="85" Margin="0,0,8,0"/>
                                <Border Visibility="{Binding IsCariKilitli, Converter={StaticResource BoolToVis}}" 
                                        Background="{StaticResource InfoLightFirca}" CornerRadius="6" Padding="6,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="🔒 Sabit Cari" Foreground="{StaticResource PrimaryDarkFirca}" FontWeight="Bold" FontSize="11"/>
                                </Border>
                                <TextBlock Text="{Binding SeciliCari.Unvan, TargetNullValue=Cari seçilmedi}" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryDarkFirca}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- Açıklama -->
                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="Açıklama / Not" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,12,0">
                            <TextBlock Text="Para Birimi" Style="{StaticResource EtiketMetin}"/>
                            <TextBlock Text="{Binding ParaBirimi}" VerticalAlignment="Center" Height="30" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,12,0">
                            <TextBlock Text="Kur" Style="{StaticResource EtiketMetin}"/>
                            <TextBlock Text="{Binding Kur, StringFormat=N4}" VerticalAlignment="Center" Height="30" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,14,12,0">
                            <TextBlock Text="Referans No" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding ReferansNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- BİLDİRİM BANNER'LARI -->
                <Border Background="{StaticResource SuccessLightFirca}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                        BorderBrush="{StaticResource SuccessDarkFirca}" BorderThickness="1"
                        Visibility="{Binding BasariMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                    <TextBlock Text="{Binding BasariMesaji}" Foreground="{StaticResource SuccessDarkFirca}" FontWeight="Bold" FontSize="13"/>
                </Border>

                <Border Background="{StaticResource DangerLightFirca}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                        BorderBrush="{StaticResource DangerDarkFirca}" BorderThickness="1"
                        Visibility="{Binding HataMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                    <TextBlock Text="{Binding HataMesaji}" Foreground="{StaticResource DangerDarkFirca}" FontWeight="Bold" FontSize="13"/>
                </Border>

                <!-- ÜRÜN KALEMİ EKLEME BARI -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16"
                        BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ürün Seçimi -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Eklenecek Ürün / Stok *" Style="{StaticResource EtiketMetin}"/>
                            <Button Content="{Binding SeciliUrunMetni}" Command="{Binding UrunSecKomutu}" Style="{StaticResource BirinciDugme}" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Miktar -->
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Miktar *" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding KalemMiktarMetni, UpdateSourceTrigger=PropertyChanged, TargetNullValue='', FallbackValue=''}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>

                        <!-- Birim Fiyat -->
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Birim Fiyat (₺) *" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding KalemBirimFiyatMetni, UpdateSourceTrigger=PropertyChanged, TargetNullValue='', FallbackValue=''}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>

                        <!-- KDV Oranı -->
                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                            <TextBlock Text="KDV (%)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding KalemKdvOraniMetni, UpdateSourceTrigger=PropertyChanged, TargetNullValue='', FallbackValue=''}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>

                        <!-- Kalem Ekle Butonu -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                            <Button Command="{Binding KalemEkleKomutu}" Style="{StaticResource BirinciDugme}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" Margin="0,0,6,0"/>
                                    <TextBlock Text="Listeye Ekle"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- LİSTE BAŞLIĞI VEYA DETAY BAŞLIĞI -->
                <Grid Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ListeBaslikMetni}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding HasKalemler, Converter={StaticResource BoolToVis}}">
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ToplamKalemSayisi, StringFormat={}📦 {0} Çeşit Ürün}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryFirca}"/>
                        </Border>
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ToplamUrunMiktari, StringFormat={}📊 {0:N2} Toplam Adet}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryFirca}"/>
                        </Border>
                        <Border Background="{StaticResource PrimaryLightFirca}" CornerRadius="6" Padding="10,5">
                            <TextBlock Text="{Binding GenelToplam, StringFormat={}💰 {0:N2} ₺ Toplam Tutar}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryDarkFirca}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- FATURA KALEMLERİ TABLOSU -->
                <Border Background="White" CornerRadius="12" Padding="0" Margin="0,0,0,16"
                        BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
                    <StackPanel>
                        <!-- BOŞ LİSTE UYARI BANT'I -->
                        <Border Visibility="{Binding IsKalemlerEmpty, Converter={StaticResource BoolToVis}}" 
                                Background="#F8FAFC" Padding="24" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🛒 Henüz listeye ürün eklenmedi" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Faturaya ürün eklemek için yukarıdaki '+ Ürün Ekle' butonuna basarak stok ürününüzü ve miktarını belirleyiniz." FontSize="12" Foreground="{StaticResource TextMutedFirca}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    <DataGrid ItemsSource="{Binding Kalemler}"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                              MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KOD" Binding="{Binding Urun.Kod}" Width="90" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="BARKOD" Binding="{Binding Urun.Barkod}" Width="115"/>
                            <DataGridTextColumn Header="ÜRÜN ADI" Binding="{Binding Urun.Ad}" Width="2*"/>
                            <DataGridTextColumn Header="BİRİM" Binding="{Binding Urun.Birim}" Width="70"/>
                            
                            <DataGridTextColumn Header="MİKTAR" Binding="{Binding Miktar, StringFormat={}{0:N2}}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="STOK KAYNAĞI" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StokDagilimiOzeti, TargetNullValue=Seçilmedi}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Width="78"/>
                                            <Button Content="Seç" Command="{Binding DataContext.StokDagilimiKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MikroSilDugme}" Width="52" ToolTip="Stok kaynağı seç"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="BİRİM FİYAT" Binding="{Binding BirimFiyat, StringFormat={}{0:N2} ₺, UpdateSourceTrigger=PropertyChanged}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="İSKONTO %" Binding="{Binding IskontoOrani, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="90"/>

                            <DataGridTextColumn Header="KDV (%)" Binding="{Binding KdvOrani, StringFormat=%{0}}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="KDV TUTARI" Binding="{Binding KdvTutari, StringFormat={}{0:N2} ₺}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryFirca}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="TOPLAM TUTAR" Binding="{Binding ToplamTutar, StringFormat={}{0:N2} ₺}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryDarkFirca}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Sil İşlemi -->
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.KalemSilKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MikroSilDugme}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ALT TOPLAM ÖZETİ VE AKSİYONLAR -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol Durum ve Vazgeç -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding HataMesaji}" Foreground="{StaticResource DangerDarkFirca}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding BasariMesaji}" Foreground="{StaticResource SuccessDarkFirca}" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                        <Button Command="{Binding IptalKomutu}" Style="{StaticResource IkinciDugme}" HorizontalAlignment="Left" Width="140">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕" Margin="0,0,6,0"/>
                                <TextBlock Text="Vazgeç"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Sağ Finansal Toplam Kartı -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Brüt Toplam:" FontSize="13" Foreground="{StaticResource TextSecondaryFirca}"/>
                                <TextBlock Text="{Binding AraToplam, StringFormat={}{0:N2} ₺}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="İskonto:" FontSize="13" Foreground="{StaticResource TextSecondaryFirca}"/>
                                <TextBlock Text="{Binding SatirIskontosuToplam, StringFormat={}{0:N2} ₺}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Ara Toplam:" FontSize="13" Foreground="{StaticResource TextSecondaryFirca}"/>
                                <TextBlock Text="{Binding AraToplam, StringFormat={}{0:N2} ₺}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Hesaplanan KDV:" FontSize="13" Foreground="{StaticResource TextSecondaryFirca}"/>
                                <TextBlock Text="{Binding KdvToplam, StringFormat={}{0:N2} ₺}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Margin="0,4,0,8" Background="{StaticResource BorderFirca}"/>

                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="GENEL TOPLAM:" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                                <TextBlock Text="{Binding GenelToplam, StringFormat={}{0:N2} ₺}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Button Command="{Binding KaydetKomutu}" Style="{StaticResource BirinciDugme}" Height="42">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" Margin="0,0,6,0"/>
                                    <TextBlock Text="Faturayı Kaydet ve Oluştur"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
