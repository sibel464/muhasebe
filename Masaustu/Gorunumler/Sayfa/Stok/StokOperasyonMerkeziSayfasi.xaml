<UserControl x:Class="Masaustu.Gorunumler.Sayfa.Stok.StokOperasyonMerkeziSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Üst Başlık & Aksiyonlar -->
            <RowDefinition Height="Auto"/> <!-- Özet KPI Kartları -->
            <RowDefinition Height="Auto"/> <!-- Arama ve Filtrele Barları -->
            <RowDefinition Height="*"/>    <!-- Ürün Lokasyon Matris Tablosu -->
            <RowDefinition Height="Auto"/> <!-- Alt Durum Barları -->
        </Grid.RowDefinitions>

        <!-- 1. ÜST PANEL: Başlık ve Hızlı İşlem Butonları -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource BaslikIkonKutusu}">
                    <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="STOK OPERASYON MERKEZİ" Style="{StaticResource SayfaBasligi}"/>
                    <TextBlock Text="Ürün 360°, Lokasyon Stokları, Transfer ve Sayım Yönetimi" Style="{StaticResource SayfaAltBaslik}"/>
                </StackPanel>
            </StackPanel>

            <!-- Hızlı Aksiyon Butonları -->
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                <Button Command="{Binding YeniUrunKomutu}" Style="{StaticResource BirinciDugme}" Margin="0,3,8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" Margin="0,0,6,0"/>
                        <TextBlock Text="Yeni Ürün"/>
                    </StackPanel>
                </Button>
                <Button Click="ExceldenAktar_Click" Style="{StaticResource IkinciDugme}" Margin="0,3,8,3"
                        ToolTip="Başka programdan geçiş: ürün listesini açılış stoklarıyla Excel/CSV'den aktarır">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥" Margin="0,0,6,0"/>
                        <TextBlock Text="Excel'den Aktar"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding UrunDuzenleKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,3,8,3"
                        ToolTip="Seçili ürünün kartını (ad, fiyat, kategori...) düzenler">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✏️" Margin="0,0,6,0"/>
                        <TextBlock Text="Ürünü Düzenle"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding Stok360AcKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,3,8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" Margin="0,0,6,0"/>
                        <TextBlock Text="Stok 360°"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding StokGirisiKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,3,8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥" Margin="0,0,6,0"/>
                        <TextBlock Text="Stok Girişi"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding StokCikisiKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,3,8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📤" Margin="0,0,6,0"/>
                        <TextBlock Text="Stok Çıkışı"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding TransferKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,3,8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0"/>
                        <TextBlock Text="Transfer Yap"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SayimKomutu}" Style="{StaticResource IkinciDugme}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" Margin="0,0,6,0"/>
                        <TextBlock Text="Stok Sayımı"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <!-- 2. ÖZET KPI KARTLARI -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,16">
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,8,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Toplam Stok" Style="{StaticResource EtiketMetin}" FontSize="11"/>
                    <TextBlock Text="{Binding ToplamFizikselStok, StringFormat={}{0:#,##0.##}}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,8,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Kullanılabilir" Style="{StaticResource EtiketMetin}" FontSize="11"/>
                    <TextBlock Text="{Binding ToplamKullanilabilirStok, StringFormat={}{0:#,##0.##}}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,8,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Rezerve" Style="{StaticResource EtiketMetin}" FontSize="11"/>
                    <TextBlock Text="{Binding ToplamRezerveStok, StringFormat={}{0:#,##0.##}}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource WarningDarkFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,8,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Mağaza" Style="{StaticResource EtiketMetin}" FontSize="11"/>
                    <TextBlock Text="{Binding MagazaToplamStok, StringFormat={}{0:#,##0.##}}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,8,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Depo 1" Style="{StaticResource EtiketMetin}" FontSize="11"/>
                    <TextBlock Text="{Binding Depo1ToplamStok, StringFormat={}{0:#,##0.##}}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,8,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Depo 2" Style="{StaticResource EtiketMetin}" FontSize="11"/>
                    <TextBlock Text="{Binding Depo2ToplamStok, StringFormat={}{0:#,##0.##}}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Kritik Stok" Style="{StaticResource EtiketMetin}" FontSize="11"/>
                    <TextBlock Text="{Binding KritikStokSayisi, StringFormat={}{0} Ürün}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource DangerDarkFirca}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 3. ARAMA VE FİLTRE BARI -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Arama Kutusu -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Arama (Kod, Barkod, Ad, Kategori, Marka)" Style="{StaticResource EtiketMetin}"/>
                    <TextBox Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AraKomutu}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <!-- Depo Seçimi -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Lokasyon Filtresi" Style="{StaticResource EtiketMetin}"/>
                    <ComboBox ItemsSource="{Binding Depolar}" DisplayMemberPath="Ad" SelectedValuePath="Id" SelectedValue="{Binding SeciliDepoId}" Style="{StaticResource FormAcilirKutu}"/>
                </StackPanel>

                <!-- Kritik Stok / Pasif Filtresi -->
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,12,2">
                    <CheckBox Content="Sadece Kritik Stok" IsChecked="{Binding SadeceKritikStok}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <CheckBox Content="Pasif Ürünleri Göster" IsChecked="{Binding PasifleriGoster}" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>

                <!-- Butonlar -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Command="{Binding AraKomutu}" Style="{StaticResource BirinciDugme}" Margin="0,0,8,0" Width="90">
                        <TextBlock Text="🔍 Ara"/>
                    </Button>
                    <Button Command="{Binding TemizleKomutu}" Style="{StaticResource IkinciDugme}" Width="90" Margin="0,0,8,0">
                        <TextBlock Text="Temizle"/>
                    </Button>
                    <Button Command="{Binding ExcelAktarKomutu}" Style="{StaticResource IkinciDugme}" ToolTip="Listelenen ürünleri Excel'de açılabilen dosyaya aktarır">
                        <TextBlock Text="📊 Excel'e Aktar"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. LOKASYON STOK MATRİS TABLOSU -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="0" Margin="0,0,0,12"
                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Urunler}" SelectedItem="{Binding SeciliSatir}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          MouseDoubleClick="TabloCiftTik">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Aktif}" Value="False">
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                    <Setter Property="ToolTip" Value="Pasif ürün: satış ve faturada seçilemez"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KOD" Binding="{Binding UrunKodu}" Width="85" FontWeight="Bold"/>
                        <DataGridTextColumn Header="BARKOD" Binding="{Binding Barkod}" Width="100"/>
                        <DataGridTextColumn Header="ÜRÜN ADI" Binding="{Binding UrunAdi}" Width="2*" MinWidth="180"/>
                        <DataGridTextColumn Header="KATEGORİ" Binding="{Binding Kategori}" Width="95"/>
                        <DataGridTextColumn Header="MARKA" Binding="{Binding Marka}" Width="85"/>
                        <DataGridTextColumn Header="BİRİM" Binding="{Binding Birim}" Width="55"/>

                        <DataGridTextColumn Header="MAĞAZA" Binding="{Binding MagazaFiziksel, StringFormat={}{0:#,##0.##}}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="DEPO 1" Binding="{Binding Depo1Fiziksel, StringFormat={}{0:#,##0.##}}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="DEPO 2" Binding="{Binding Depo2Fiziksel, StringFormat={}{0:#,##0.##}}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="TOPLAM STOK" Binding="{Binding ToplamFiziksel, StringFormat={}{0:#,##0.##}}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryDarkFirca}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="KULLANILABİLİR" Binding="{Binding ToplamKullanilabilir, StringFormat={}{0:#,##0.##}}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="ALIŞ FİYATI" Binding="{Binding AlisFiyati, StringFormat={}{0:N2} ₺}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="SATIŞ FİYATI" Binding="{Binding SatisFiyati, StringFormat={}{0:N2} ₺}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="DURUM" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="5" Padding="6,2" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SuccessLightFirca}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StokDurumu}" Value="Kritik Stok">
                                                        <Setter Property="Background" Value="{StaticResource WarningLightFirca}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StokDurumu}" Value="Stok Yok">
                                                        <Setter Property="Background" Value="{StaticResource DangerLightFirca}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Aktif}" Value="False">
                                                        <Setter Property="Background" Value="#E5E7EB"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding StokDurumu}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Aktif}" Value="False">
                                                            <Setter Property="Text" Value="Pasif"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 5. ALT DURUM BARI -->
        <DockPanel Grid.Row="4" Margin="4,0">
            <Button Content="🔄 Yenile" Command="{Binding YenileKomutu}" Style="{StaticResource IkinciDugme}" DockPanel.Dock="Right" Width="80"/>
            <TextBlock Text="{Binding DurumMesaji}" Foreground="{StaticResource TextSecondaryFirca}" VerticalAlignment="Center" FontSize="12"/>
        </DockPanel>
    </Grid>
</UserControl>
