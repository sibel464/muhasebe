<Window x:Class="Masaustu.Gorunumler.Sayfa.Stok.StokTransferPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Depolar Arası Transfer Fişi" Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="White" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔄 DEPOLAR ARASI STOK TRANSFERİ" Style="{StaticResource SayfaBasligi}" FontSize="18"/>
            <TextBlock Text="Kaynak lokasyondan hedef lokasyona atomik stok aktarımı" Style="{StaticResource SayfaAltBaslik}"/>
        </StackPanel>

        <!-- FORM -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Kaynak Lokasyon *" Style="{StaticResource EtiketMetin}"/>
                        <ComboBox ItemsSource="{Binding Depolar}" DisplayMemberPath="Ad" SelectedValuePath="Id" SelectedValue="{Binding KaynakDepoId}" Style="{StaticResource FormAcilirKutu}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Hedef Lokasyon *" Style="{StaticResource EtiketMetin}"/>
                        <ComboBox ItemsSource="{Binding Depolar}" DisplayMemberPath="Ad" SelectedValuePath="Id" SelectedValue="{Binding HedefDepoId}" Style="{StaticResource FormAcilirKutu}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Transfer Edilecek Ürün *" Style="{StaticResource EtiketMetin}"/>
                    <ComboBox ItemsSource="{Binding Urunler}" DisplayMemberPath="Ad" SelectedItem="{Binding SeciliUrun}" Style="{StaticResource FormAcilirKutu}"/>
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Miktar *" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Text="{Binding Miktar, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Transfer Tarihi" Style="{StaticResource EtiketMetin}"/>
                        <DatePicker SelectedDate="{Binding Tarih}" Height="38" FontSize="13" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Transfer Fiş No (İsteğe Bağlı)" Style="{StaticResource EtiketMetin}"/>
                    <TextBox Text="{Binding TransferNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Açıklama" Style="{StaticResource EtiketMetin}"/>
                    <TextBox Text="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- BİLDİRİM & AKSİYONLAR -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{Binding HataMesaji}" Foreground="{StaticResource DangerDarkFirca}" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding BasariMesaji}" Foreground="{StaticResource SuccessDarkFirca}" FontWeight="Bold" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding IptalKomutu}" Style="{StaticResource IkinciDugme}" Content="Vazgeç" Width="100"/>
                <Button Grid.Column="1" Command="{Binding KaydetKomutu}" Style="{StaticResource BirinciDugme}" Content="Transferi Kaydet" Width="140"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
