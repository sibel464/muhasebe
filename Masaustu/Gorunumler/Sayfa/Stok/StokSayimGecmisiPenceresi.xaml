<Window x:Class="Masaustu.Gorunumler.Sayfa.Stok.StokSayimGecmisiPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sayım Geçmişi" Width="1000" Height="600" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="White">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🗂 SAYIM GEÇMİŞİ" Style="{StaticResource SayfaBasligi}" FontSize="18"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource SayfaAltBaslik}"
                       Text="Onaylanan, iptal edilen ve yarım kalan sayımlar. Tutanak yazdırabilir, yarım sayıma kaldığı yerden devam edebilirsiniz. Tutarlar alış fiyatıyladır."/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Sayimlar}" SelectedItem="{Binding Secili}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SAYIM NO" Binding="{Binding SayimNo}" Width="130" FontWeight="Bold"/>
                    <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                    <DataGridTextColumn Header="DEPO" Binding="{Binding DepoAdi}" Width="*"/>
                    <DataGridTextColumn Header="DURUM" Binding="{Binding DurumMetni}" Width="110"/>
                    <DataGridTextColumn Header="ÜRÜN" Binding="{Binding KalemSayisi}" Width="65"/>
                    <DataGridTextColumn Header="FAZLA" Binding="{Binding FazlaKalem}" Width="65"/>
                    <DataGridTextColumn Header="EKSİK" Binding="{Binding EksikKalem}" Width="65"/>
                    <DataGridTextColumn Header="NET FARK (TL)" Binding="{Binding NetFarkTutari, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding HataMesaji}" Foreground="{StaticResource DangerDarkFirca}" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding YenileKomutu}" Style="{StaticResource IkinciDugme}" Content="Yenile" Padding="12,0" Margin="0,0,8,0"/>
                <Button Command="{Binding IptalEtKomutu}" Style="{StaticResource IkinciDugme}" Content="Yarım Sayımı İptal Et" Padding="12,0" Margin="0,0,8,0"/>
                <Button Command="{Binding DevamEtKomutu}" Style="{StaticResource IkinciDugme}" Content="Kaldığı Yerden Devam Et" Padding="12,0" Margin="0,0,8,0"/>
                <Button Command="{Binding YazdirKomutu}" Style="{StaticResource BirinciDugme}" Content="🖨 Sayım Tutanağı" Padding="16,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
