<Window x:Class="Masaustu.Gorunumler.Sayfa.Stok.StokSayimPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stok Sayımı Ve Düzeltme Fişi" Width="960" Height="620"
        WindowStartupLocation="CenterOwner" Background="White">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="📋 LOKASYON STOK SAYIMI VE DÜZELTME" Style="{StaticResource SayfaBasligi}" FontSize="18"/>
            <TextBlock Text="Fiziksel stok sayımı yaparak sistem stok farklarını otomatik güncelleyin" Style="{StaticResource SayfaAltBaslik}"/>
        </StackPanel>

        <!-- ÜST SEÇİMLER VE BARKOD -->
        <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Sayım Yapılacak Depo *" Style="{StaticResource EtiketMetin}"/>
                    <ComboBox ItemsSource="{Binding Depolar}" DisplayMemberPath="Ad" SelectedValuePath="Id" SelectedValue="{Binding SeciliDepoId}" Style="{StaticResource FormAcilirKutu}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                    <TextBlock Text="Sayım Tarihi" Style="{StaticResource EtiketMetin}"/>
                    <DatePicker SelectedDate="{Binding Tarih}" Height="38" FontSize="13" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                    <TextBlock Text="🔍 Barkod / Ürün Kodu Okut (Enter)" Style="{StaticResource EtiketMetin}"/>
                    <TextBox Text="{Binding BarkodArama, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding BarkodOkutKomutu}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABLO -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Kalemler}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="KOD" Binding="{Binding UrunKodu}" Width="100" IsReadOnly="True" FontWeight="Bold"/>
                    <DataGridTextColumn Header="BARKOD" Binding="{Binding Barkod}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="ÜRÜN ADI" Binding="{Binding UrunAdi}" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="SİSTEM STOK" Binding="{Binding SistemMiktari, StringFormat={}{0:N0}}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="SAYILAN STOK" Binding="{Binding SayilanMiktar, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Width="120" FontWeight="Bold"/>
                    <DataGridTextColumn Header="FARK" Binding="{Binding FarkMiktari, StringFormat={}{0:N0}}" Width="90" IsReadOnly="True" FontWeight="Bold"/>
                    <DataGridTextColumn Header="DURUM" Binding="{Binding FarkTuru}" Width="100" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- FOOTER -->
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding HataMesaji}" Foreground="{StaticResource DangerDarkFirca}" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding BasariMesaji}" Foreground="{StaticResource SuccessDarkFirca}" FontWeight="Bold" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding IptalKomutu}" Style="{StaticResource IkinciDugme}" Content="Vazgeç" Width="100"/>
                <Button Grid.Column="1" Command="{Binding SayimOnaylaKomutu}" Style="{StaticResource BirinciDugme}" Content="Sayımı Onayla Ve Stokları Güncelle" Width="230"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
