<Window x:Class="Masaustu.Gorunumler.Sayfa.Stok.UrunStok360Penceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ürün &amp; Stok 360° Merkez" Width="1280" Height="740" MinWidth="1050" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" Language="tr-TR">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid MaxWidth="1680" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Üst Başlık & Ürün Kartı -->
            <RowDefinition Height="Auto"/> <!-- Özet KPI Kartları -->
            <RowDefinition Height="*"/>    <!-- 12 Sekmeli İçerik -->
            <RowDefinition Height="Auto"/> <!-- Alt Durum Barları -->
        </Grid.RowDefinitions>

        <!-- 1. ÜST PANEL -->
        <StackPanel Grid.Row="0">
            <DockPanel Margin="0,0,0,8">
                <Button Content="← Stok Yönetimi" Command="{Binding KapatKomutu}" DockPanel.Dock="Left" Style="{StaticResource IkinciDugme}"/>
                <TextBlock Text="ÜRÜN / STOK 360° HESAP MERKEZİ" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0"/>
            </DockPanel>

            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Left" MinWidth="300">
                    <TextBlock Text="{Binding Ozet.Ad, TargetNullValue=Ürün Yükleniyor...}" FontSize="21" FontWeight="Bold" Foreground="#142C50"/>
                    <TextBlock Foreground="#64748B" FontSize="12">
                        <Run Text="{Binding Ozet.Kod, TargetNullValue='—'}"/>
                        <Run Text="  •  Barkod: "/>
                        <Run Text="{Binding Ozet.Barkod, TargetNullValue='—'}"/>
                        <Run Text="  •  Kategori: "/>
                        <Run Text="{Binding Ozet.Kategori, TargetNullValue='—'}"/>
                        <Run Text="  •  Birim: "/>
                        <Run Text="{Binding Ozet.Birim, TargetNullValue='—'}"/>
                    </TextBlock>
                </StackPanel>

                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border CornerRadius="6" Padding="10,5" Background="{StaticResource PrimaryLightFirca}" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Ozet.StokDurumu, StringFormat={}Durum: {0}}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}"/>
                    </Border>
                </WrapPanel>
            </DockPanel>
        </StackPanel>

        <!-- 2. ÖZET KPI KARTLARI -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,10">
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,6,0" Padding="10,7">
                <StackPanel>
                    <TextBlock Text="Toplam Stok" Style="{StaticResource EtiketMetin}" FontSize="11"/>
                    <TextBlock Text="{Binding Ozet.ToplamFizikselStok, StringFormat={}{0:N0}}" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,6,0" Padding="10,7">
                <StackPanel>
                    <TextBlock Text="Kullanılabilir" Style="{StaticResource EtiketMetin}" FontSize="11"/>
                    <TextBlock Text="{Binding Ozet.ToplamKullanilabilirStok, StringFormat={}{0:N0}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,6,0" Padding="10,7">
                <StackPanel>
                    <TextBlock Text="Rezerve Stok" Style="{StaticResource EtiketMetin}" FontSize="11"/>
                    <TextBlock Text="{Binding Ozet.ToplamRezerveStok, StringFormat={}{0:N0}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WarningDarkFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,6,0" Padding="10,7">
                <StackPanel>
                    <TextBlock Text="Minimum Stok" Style="{StaticResource EtiketMetin}" FontSize="11"/>
                    <TextBlock Text="{Binding Ozet.MinimumStok, StringFormat={}{0:N0}}" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,6,0" Padding="10,7">
                <StackPanel>
                    <TextBlock Text="Alış Fiyatı" Style="{StaticResource EtiketMetin}" FontSize="11"/>
                    <TextBlock Text="{Binding Ozet.AlisFiyati, StringFormat={}{0:N2} ₺}" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,6,0" Padding="10,7">
                <StackPanel>
                    <TextBlock Text="Satış Fiyati" Style="{StaticResource EtiketMetin}" FontSize="11"/>
                    <TextBlock Text="{Binding Ozet.PerakendeSatisFiyati, StringFormat={}{0:N2} ₺}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Padding="10,7">
                <StackPanel>
                    <TextBlock Text="KDV Oranı" Style="{StaticResource EtiketMetin}" FontSize="11"/>
                    <TextBlock Text="{Binding Ozet.KdvOrani, StringFormat={}%{0}}" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 3. MAIN 12-TAB CONTENT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sekme Seçim Listesi -->
            <ListBox ItemsSource="{Binding Sekmeler}" SelectedItem="{Binding SeciliSekme}" DisplayMemberPath="Ad"
                     Background="#142C50" Foreground="White" BorderThickness="0" Padding="4" Margin="0,0,10,0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Sekme İçerikleri -->
            <Grid Grid.Column="1" Background="White">

                <!-- 1. GENEL İÇERİK -->
                <ScrollViewer Visibility="{Binding GenelAcik, Converter={StaticResource BoolVis}}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Ürün Detaylı Kimlik Kartı" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}" Margin="0,0,0,12"/>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,16,12"><TextBlock Text="Ürün Kodu" Style="{StaticResource EtiketMetin}"/><TextBlock Text="{Binding Ozet.Kod}" FontWeight="Bold" FontSize="14"/></StackPanel>
                            <StackPanel Margin="0,0,16,12"><TextBlock Text="Ürün Adı" Style="{StaticResource EtiketMetin}"/><TextBlock Text="{Binding Ozet.Ad}" FontWeight="Bold" FontSize="14"/></StackPanel>
                            <StackPanel Margin="0,0,16,12"><TextBlock Text="Barkod" Style="{StaticResource EtiketMetin}"/><TextBlock Text="{Binding Ozet.Barkod, TargetNullValue='—'}" FontSize="14"/></StackPanel>

                            <StackPanel Margin="0,0,16,12"><TextBlock Text="Kategori" Style="{StaticResource EtiketMetin}"/><TextBlock Text="{Binding Ozet.Kategori, TargetNullValue='—'}" FontSize="14"/></StackPanel>
                            <StackPanel Margin="0,0,16,12"><TextBlock Text="Marka" Style="{StaticResource EtiketMetin}"/><TextBlock Text="{Binding Ozet.Marka, TargetNullValue='—'}" FontSize="14"/></StackPanel>
                            <StackPanel Margin="0,0,16,12"><TextBlock Text="Ölçü Birimi" Style="{StaticResource EtiketMetin}"/><TextBlock Text="{Binding Ozet.Birim}" FontSize="14"/></StackPanel>

                            <StackPanel Margin="0,0,16,12"><TextBlock Text="Son Alış Tarihi" Style="{StaticResource EtiketMetin}"/><TextBlock Text="{Binding Ozet.SonAlisTarihi, StringFormat=dd.MM.yyyy, TargetNullValue='—'}" FontSize="14"/></StackPanel>
                            <StackPanel Margin="0,0,16,12"><TextBlock Text="Son Satış Tarihi" Style="{StaticResource EtiketMetin}"/><TextBlock Text="{Binding Ozet.SonSatisTarihi, StringFormat=dd.MM.yyyy, TargetNullValue='—'}" FontSize="14"/></StackPanel>
                            <StackPanel Margin="0,0,16,12"><TextBlock Text="Toptan Satış Fiyatı" Style="{StaticResource EtiketMetin}"/><TextBlock Text="{Binding Ozet.ToptanSatisFiyati, StringFormat={}{0:N2} ₺}" FontSize="14"/></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. LOKASYON STOKLARI -->
                <Grid Visibility="{Binding LokasyonAcik, Converter={StaticResource BoolVis}}" Margin="12">
                    <DataGrid ItemsSource="{Binding LokasyonStoklari}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="LOKASYON KODU" Binding="{Binding DepoKodu}" Width="120" FontWeight="Bold"/>
                            <DataGridTextColumn Header="LOKASYON ADI" Binding="{Binding DepoAdi}" Width="2*"/>
                            <DataGridTextColumn Header="TÜRÜ" Binding="{Binding DepoTuru}" Width="100"/>
                            <DataGridTextColumn Header="FİZİKSEL STOK" Binding="{Binding FizikselStok, StringFormat={}{0:N0}}" Width="120"/>
                            <DataGridTextColumn Header="REZERVE STOK" Binding="{Binding RezerveStok, StringFormat={}{0:N0}}" Width="120"/>
                            <DataGridTextColumn Header="KULLANILABİLİR" Binding="{Binding KullanilabilirStok, StringFormat={}{0:N0}}" Width="130" FontWeight="Bold"/>
                            <DataGridTextColumn Header="DURUM" Binding="{Binding Durum}" Width="100"/>
                            <DataGridTextColumn Header="SON HAREKET" Binding="{Binding SonHareketTarihi, StringFormat=dd.MM.yyyy HH:mm, TargetNullValue='—'}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 3. STOK HAREKETLERİ (Yürüyen Bakiye) -->
                <Grid Visibility="{Binding HareketAcik, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="8,6">
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="Başlangıç" FontSize="10"/><DatePicker SelectedDate="{Binding Baslangic}" Width="114"/></StackPanel>
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="Bitiş" FontSize="10"/><DatePicker SelectedDate="{Binding Bitis}" Width="114"/></StackPanel>
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="Belge No" FontSize="10"/><TextBox Text="{Binding BelgeNo}" Width="104"/></StackPanel>
                        <Button Content="Filtrele" Command="{Binding FiltreleKomutu}" VerticalAlignment="Bottom" Style="{StaticResource BirinciDugme}" Margin="0,0,4,0"/>
                        <Button Content="Temizle" Command="{Binding TemizleKomutu}" VerticalAlignment="Bottom" Style="{StaticResource IkinciDugme}"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Hareketler}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy HH:mm}" Width="125"/>
                            <DataGridTextColumn Header="FİŞ NO" Binding="{Binding FisNo}" Width="120"/>
                            <DataGridTextColumn Header="BELGE NO" Binding="{Binding BelgeNo}" Width="110"/>
                            <DataGridTextColumn Header="İŞLEM TÜRÜ" Binding="{Binding IslemTuruText}" Width="120"/>
                            <DataGridTextColumn Header="YÖN" Binding="{Binding HareketTuruText}" Width="70"/>
                            <DataGridTextColumn Header="GİRİŞ" Binding="{Binding GirisMiktar, StringFormat={}{0:N0}}" Width="75"/>
                            <DataGridTextColumn Header="ÇIKIŞ" Binding="{Binding CikisMiktar, StringFormat={}{0:N0}}" Width="75"/>
                            <DataGridTextColumn Header="YÜRÜYEN BAKİYE" Binding="{Binding YuruyenBakiye, StringFormat={}{0:N0}}" Width="120" FontWeight="Bold"/>
                            <DataGridTextColumn Header="DEPO" Binding="{Binding DepoAdi}" Width="120"/>
                            <DataGridTextColumn Header="CARİ" Binding="{Binding CariUnvan}" Width="1.5*"/>
                            <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 4. SATIŞ GEÇMİŞİ -->
                <Grid Visibility="{Binding SatisAcik, Converter={StaticResource BoolVis}}">
                    <DataGrid ItemsSource="{Binding Satislar}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy}" Width="110"/>
                            <DataGridTextColumn Header="FATURA NO" Binding="{Binding FaturaNo}" Width="120"/>
                            <DataGridTextColumn Header="MÜŞTERİ (CARİ)" Binding="{Binding CariUnvan}" Width="2*"/>
                            <DataGridTextColumn Header="MİKTAR" Binding="{Binding Miktar, StringFormat={}{0:N0}}" Width="90"/>
                            <DataGridTextColumn Header="BİRİM FİYAT" Binding="{Binding BirimFiyat, StringFormat={}{0:N2} ₺}" Width="110"/>
                            <DataGridTextColumn Header="NET FİYAT" Binding="{Binding NetFiyat, StringFormat={}{0:N2} ₺}" Width="110"/>
                            <DataGridTextColumn Header="KDV" Binding="{Binding KdvTutari, StringFormat={}{0:N2} ₺}" Width="100"/>
                            <DataGridTextColumn Header="TOPLAM" Binding="{Binding ToplamTutar, StringFormat={}{0:N2} ₺}" Width="120" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 5. ALIŞ GEÇMİŞİ -->
                <Grid Visibility="{Binding AlisAcik, Converter={StaticResource BoolVis}}">
                    <DataGrid ItemsSource="{Binding Alislar}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy}" Width="110"/>
                            <DataGridTextColumn Header="FATURA NO" Binding="{Binding FaturaNo}" Width="120"/>
                            <DataGridTextColumn Header="TEDARİKÇİ" Binding="{Binding TedarikciUnvan}" Width="2*"/>
                            <DataGridTextColumn Header="MİKTAR" Binding="{Binding Miktar, StringFormat={}{0:N0}}" Width="90"/>
                            <DataGridTextColumn Header="BİRİM FİYAT" Binding="{Binding BirimFiyat, StringFormat={}{0:N2} ₺}" Width="110"/>
                            <DataGridTextColumn Header="NET FİYAT" Binding="{Binding NetFiyat, StringFormat={}{0:N2} ₺}" Width="110"/>
                            <DataGridTextColumn Header="TOPLAM" Binding="{Binding ToplamTutar, StringFormat={}{0:N2} ₺}" Width="120" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 6. SİPARİŞ / REZERVASYON -->
                <Grid Visibility="{Binding SiparisAcik, Converter={StaticResource BoolVis}}">
                    <DataGrid ItemsSource="{Binding SiparisRezervasyonlar}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy}" Width="110"/>
                            <DataGridTextColumn Header="SİPARİŞ NO" Binding="{Binding SiparisNo}" Width="120"/>
                            <DataGridTextColumn Header="MÜŞTERİ" Binding="{Binding CariUnvan}" Width="2*"/>
                            <DataGridTextColumn Header="SİPARİŞ MİKTARI" Binding="{Binding SiparisMiktari, StringFormat={}{0:N0}}" Width="120"/>
                            <DataGridTextColumn Header="REZERVE MİKTAR" Binding="{Binding RezerveMiktari, StringFormat={}{0:N0}}" Width="120" FontWeight="Bold"/>
                            <DataGridTextColumn Header="KALAN SEVK" Binding="{Binding KalanSevkMiktari, StringFormat={}{0:N0}}" Width="110"/>
                            <DataGridTextColumn Header="DURUM" Binding="{Binding Durum}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 7. TRANSFERLER -->
                <Grid Visibility="{Binding TransferAcik, Converter={StaticResource BoolVis}}">
                    <DataGrid ItemsSource="{Binding Transferler}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy HH:mm}" Width="125"/>
                            <DataGridTextColumn Header="TRANSFER FİŞ NO" Binding="{Binding FisNo}" Width="140"/>
                            <DataGridTextColumn Header="ÇIKIŞ DEPO" Binding="{Binding DepoAdi}" Width="140"/>
                            <DataGridTextColumn Header="GİRİŞ DEPO" Binding="{Binding HedefDepoAdi}" Width="140"/>
                            <DataGridTextColumn Header="MİKTAR" Binding="{Binding GirisMiktar, StringFormat={}{0:N0}}" Width="100" FontWeight="Bold"/>
                            <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 8. SAYIM / DÜZELTME -->
                <Grid Visibility="{Binding SayimAcik, Converter={StaticResource BoolVis}}">
                    <DataGrid ItemsSource="{Binding Sayimlar}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy HH:mm}" Width="125"/>
                            <DataGridTextColumn Header="SAYIM NO" Binding="{Binding FisNo}" Width="130"/>
                            <DataGridTextColumn Header="DEPO" Binding="{Binding DepoAdi}" Width="140"/>
                            <DataGridTextColumn Header="FARK MİKTARI" Binding="{Binding GirisMiktar, StringFormat={}{0:N0}}" Width="110" FontWeight="Bold"/>
                            <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 9. FİYATLAR & TAKSİTLER -->
                <Grid Visibility="{Binding FiyatAcik, Converter={StaticResource BoolVis}}" Margin="16">
                    <StackPanel>
                        <TextBlock Text="Taksitli Satış Fiyatları Tablosu" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding SatisFiyatlari}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True" MaxWidth="500" HorizontalAlignment="Left">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FİYAT TÜRÜ / SEÇENEK" Binding="{Binding FiyatTuru}" Width="220" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="FİYAT (₺)" Binding="{Binding Fiyat, StringFormat={}{0:N2} ₺}" Width="180" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>

                <!-- 10. MALİYET & KÂRLILIK -->
                <ScrollViewer Visibility="{Binding MaliyetAcik, Converter={StaticResource BoolVis}}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Maliyet &amp; Brüt Kârlılık Analizi" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}" Margin="0,0,0,16"/>
                        <UniformGrid Columns="2" MaxWidth="700" HorizontalAlignment="Left">
                            <Border Style="{StaticResource KpiKarti}" Margin="0,0,12,12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Son Alış Maliyeti" Style="{StaticResource EtiketMetin}"/>
                                    <TextBlock Text="{Binding MaliyetKarlilik.SonAlisMaliyeti, StringFormat={}{0:N2} ₺}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiKarti}" Margin="0,0,0,12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Ağırlıklı Ortalama Maliyet" Style="{StaticResource EtiketMetin}"/>
                                    <TextBlock Text="{Binding MaliyetKarlilik.AgirlikliOrtalamaMaliyet, StringFormat={}{0:N2} ₺}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiKarti}" Margin="0,0,12,12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Toplam Satış Cirosu" Style="{StaticResource EtiketMetin}"/>
                                    <TextBlock Text="{Binding MaliyetKarlilik.ToplamSatisCirosu, StringFormat={}{0:N2} ₺}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiKarti}" Margin="0,0,0,12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Toplam Satış Maliyeti" Style="{StaticResource EtiketMetin}"/>
                                    <TextBlock Text="{Binding MaliyetKarlilik.ToplamSatisMaliyeti, StringFormat={}{0:N2} ₺}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiKarti}" Margin="0,0,12,0" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Brüt Kâr (₺)" Style="{StaticResource EtiketMetin}"/>
                                    <TextBlock Text="{Binding MaliyetKarlilik.BrutKar, StringFormat={}{0:N2} ₺}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessDarkFirca}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiKarti}" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Brüt Kâr Oranı (%)" Style="{StaticResource EtiketMetin}"/>
                                    <TextBlock Text="{Binding MaliyetKarlilik.BrutKarYuzdesi, StringFormat={}%{0:N2}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessDarkFirca}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 11. BELGE GEÇMİŞİ -->
                <Grid Visibility="{Binding BelgeAcik, Converter={StaticResource BoolVis}}" Margin="16">
                    <TextBlock Text="İlişkili Faturalar, İrsaliyeler ve Siparişler mevcuttur." Foreground="#64748B"/>
                </Grid>

                <!-- 12. SİSTEM BİLGİSİ -->
                <Grid Visibility="{Binding SistemAcik, Converter={StaticResource BoolVis}}" Margin="16">
                    <StackPanel>
                        <TextBlock Text="Sistem İzi ve İşlem Geçmişi" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}" Margin="0,0,0,12"/>
                        <TextBlock Text="Ürün kaydı oluşturulma ve güncelleme tarihçeleri kaydedilmiştir." Foreground="#64748B"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>

        <!-- 4. ALT BİLGİ BARI -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button Content="Yenile" Command="{Binding YenileKomutu}" DockPanel.Dock="Right" Style="{StaticResource IkinciDugme}"/>
            <TextBlock Text="{Binding DurumMesaji}" Foreground="#475569" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
