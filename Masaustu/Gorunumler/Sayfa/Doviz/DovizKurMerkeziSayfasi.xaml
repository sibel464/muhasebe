<UserControl x:Class="Masaustu.Gorunumler.Sayfa.Doviz.DovizKurMerkeziSayfasi"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="768" d:DesignWidth="1366"
      >

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Banner Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="DÖVİZ &amp; KUR MERKEZİ 360°" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="TCMB Resmi Kurlar • Manuel Kur Girişi • Dövizli Cari &amp; Bankalar • Dönem Sonu Revalüasyon" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="TCMB Güncelle" Command="{Binding TcmbGuncelleKomutu}" Height="36" Padding="16,0" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <Button Content="Yenile" Command="{Binding YenileKomutu}" Height="36" Padding="16,0" Background="#475569" Foreground="White"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status Message Bar -->
        <Border Grid.Row="1" Background="#E2E8F0" CornerRadius="4" Padding="10,6" Margin="0,0,0,12" Visibility="{Binding DurumMesaji, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding DurumMesaji}" Foreground="#334155" FontWeight="SemiBold" FontSize="12"/>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="2" Background="White">
            <!-- TAB 1: Güncel Kurlar -->
            <TabItem Header="Güncel Kurlar">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Tarih:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding SeciliTarih}" Width="140"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding GunlukKurlar}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DÖVİZ" Binding="{Binding ParaBirimiKodu}" Width="90" FontWeight="Bold"/>
                            <DataGridTextColumn Header="KUR TARİHİ" Binding="{Binding KurTarihi, StringFormat=dd.MM.yyyy}" Width="110"/>
                            <DataGridTextColumn Header="DÖVİZ ALIŞ" Binding="{Binding DovizAlis, StringFormat=N4}" Width="120"/>
                            <DataGridTextColumn Header="DÖVİZ SATIŞ" Binding="{Binding DovizSatis, StringFormat=N4}" Width="120"/>
                            <DataGridTextColumn Header="EFEKTİF ALIŞ" Binding="{Binding EfektifAlis, StringFormat=N4}" Width="120"/>
                            <DataGridTextColumn Header="EFEKTİF SATIŞ" Binding="{Binding EfektifSatis, StringFormat=N4}" Width="120"/>
                            <DataGridTextColumn Header="KAYNAK" Binding="{Binding Kaynak}" Width="110"/>
                            <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: Manuel Kur Girişi -->
            <TabItem Header="Manuel Kur Girişi">
                <Grid Margin="16" MaxWidth="600" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Para Birimi Kodu:" VerticalAlignment="Center" Margin="0,8"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding YeniParaBirimi}" Margin="0,8" Height="32"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Döviz Alış Kuru:" VerticalAlignment="Center" Margin="0,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding YeniDovizAlis}" Margin="0,8" Height="32"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Döviz Satış Kuru:" VerticalAlignment="Center" Margin="0,8"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding YeniDovizSatis}" Margin="0,8" Height="32"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Açıklama / Neden:" VerticalAlignment="Center" Margin="0,8"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding YeniAciklama}" Margin="0,8" Height="32"/>

                    <Button Grid.Row="4" Grid.Column="1" Content="Manuel Kuru Kaydet (Audit)" Command="{Binding ManuelKurKaydetKomutu}" Height="38" Background="#16A34A" Foreground="White" FontWeight="Bold" Margin="0,16,0,0"/>
                </Grid>
            </TabItem>

            <!-- TAB 3: Dövizli Bakiyeler -->
            <TabItem Header="Dövizli Pozisyon &amp; Bakiyeler">
                <DataGrid ItemsSource="{Binding DovizliBakiyeler}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DÖVİZ" Binding="{Binding ParaBirimiKodu}" Width="100" FontWeight="Bold"/>
                        <DataGridTextColumn Header="TOPLAM DÖVİZ BAKİYE" Binding="{Binding ToplamDovizBakiye, StringFormat=N2}" Width="180"/>
                        <DataGridTextColumn Header="GÜNCEL KUR" Binding="{Binding GuncelKur, StringFormat=N4}" Width="130"/>
                        <DataGridTextColumn Header="GÜNCEL TRY DEĞERİ" Binding="{Binding GuncelDegerTRY, StringFormat=N2}" Width="180" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="POTANSİYEL KUR FARKI" Binding="{Binding PotansiyelKurFarki, StringFormat=N2}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 4: Dönem Sonu Revalüasyon -->
            <TabItem Header="Dönem Sonu Revalüasyon (Değerleme)">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Döviz:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding RevaluasyonParaBirimi}" Width="80" Height="30" Margin="0,0,16,0"/>
                        <TextBlock Text="Değerleme Tarihi:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding RevaluasyonTarihi}" Width="140" Margin="0,0,16,0"/>
                        <Button Content="Revalüasyon Önizle" Command="{Binding RevaluasyonOnizleKomutu}" Height="32" Padding="16,0" Background="#2563EB" Foreground="White" Margin="0,0,8,0"/>
                        <Button Content="Revalüasyonu Uygula (Yevmiye Kaydı)" Command="{Binding RevaluasyonUygulaKomutu}" Height="32" Padding="16,0" Background="#059669" Foreground="White" FontWeight="Bold"/>
                    </WrapPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RevaluasyonOnizleme.Kalemler}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KAYNAK TÜRÜ" Binding="{Binding KaynakTuru}" Width="110"/>
                            <DataGridTextColumn Header="KAYNAK KODU" Binding="{Binding KaynakKodu}" Width="120" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding KaynakAciklama}" Width="*"/>
                            <DataGridTextColumn Header="HESAP" Binding="{Binding HesapKodu}" Width="90"/>
                            <DataGridTextColumn Header="DÖVİZ BAKİYE" Binding="{Binding DovizBakiye, StringFormat=N2}" Width="130"/>
                            <DataGridTextColumn Header="ESKİ DEFTER DEĞERİ (TRY)" Binding="{Binding EskiDefterDegeri, StringFormat=N2}" Width="160"/>
                            <DataGridTextColumn Header="ÖNCEKİ KUR" Binding="{Binding OncekiDegerlemeKuru, StringFormat=N4}" Width="110"/>
                            <DataGridTextColumn Header="YENİ KUR" Binding="{Binding YeniDegerlemeKuru, StringFormat=N4}" Width="110"/>
                            <DataGridTextColumn Header="YENİ YEREL DEĞER" Binding="{Binding YeniYerelDeger, StringFormat=N2}" Width="150" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="KUR FARKI (TRY)" Binding="{Binding KurFarki, StringFormat=N2}" Width="140" FontWeight="Bold"/>
                            <DataGridTextColumn Header="YÖN" Binding="{Binding Yön}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#F8FAFC" Padding="12" Margin="0,8,0,0" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Toplam Kur Farkı Etkisi: " FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RevaluasyonOnizleme.ToplamKurFarki, StringFormat=N2}" FontSize="14" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,8,0"/>
                            <TextBlock Text="TL" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: Revalüasyon Geçmişi -->
            <TabItem Header="Revalüasyon Geçmişi &amp; İptal">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding RevaluasyonGecmisi}" SelectedItem="{Binding SeciliRevaluasyon}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="TARİH" Binding="{Binding DegerlemeTarihi, StringFormat=dd.MM.yyyy}" Width="110"/>
                            <DataGridTextColumn Header="DÖVİZ" Binding="{Binding ParaBirimiKodu}" Width="80" FontWeight="Bold"/>
                            <DataGridTextColumn Header="KUR" Binding="{Binding Kur, StringFormat=N4}" Width="90"/>
                            <DataGridTextColumn Header="KUR FARKI (TRY)" Binding="{Binding ToplamKurFarki, StringFormat=N2}" Width="140" FontWeight="Bold"/>
                            <DataGridTextColumn Header="FİŞ NO" Binding="{Binding FisNo}" Width="120"/>
                            <DataGridTextColumn Header="DURUM" Binding="{Binding DurumStr}" Width="90"/>
                            <DataGridTextColumn Header="KULLANICI" Binding="{Binding OlusturanKullaniciAdi}" Width="120"/>
                            <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Seçili Revalüasyonu İptal Et (Storno)" Command="{Binding RevaluasyonIptalKomutu}" Height="34" Padding="16,0" Background="#DC2626" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer Bar -->
        <Border Grid.Row="3" Background="#F1F5F9" Padding="10,6" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock Text="Profesyonel Döviz &amp; Kur Yönetimi • TCMB Entegrasyonu &amp; Dönem Sonu Revalüasyon" Foreground="#64748B" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
