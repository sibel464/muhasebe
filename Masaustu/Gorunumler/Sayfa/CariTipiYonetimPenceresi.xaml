<Window x:Class="Masaustu.Gorunumler.Sayfa.CariTipiYonetimPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cari Tipi Tanımları" Width="720" Height="430" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <Button DockPanel.Dock="Top" Content="Yeni Tip" Command="{Binding YeniKomutu}" Height="34" Margin="0,0,0,8"/>
            <DataGrid ItemsSource="{Binding Tanimlar}" SelectedItem="{Binding Secili}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding Kod}" Width="*"/><DataGridTextColumn Header="Ad" Binding="{Binding Ad}" Width="*"/><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding AktifMi}"/></DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <StackPanel Grid.Column="2">
            <TextBlock Text="Cari Tipi Adı *"/><TextBox Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,10"/>
            <TextBlock Text="Kod *"/><TextBox Text="{Binding Kod, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,10"/>
            <TextBlock Text="Açıklama"/><TextBox Text="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged}" Height="70" AcceptsReturn="True" Margin="0,4,0,10"/>
            <CheckBox Content="Aktif" IsChecked="{Binding AktifMi}" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding Hata}" Foreground="Crimson" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal"><Button Content="Kaydet" Command="{Binding KaydetKomutu}" Width="100" Height="34"/><Button Content="Aktif / Pasif" Command="{Binding AktiflikKomutu}" Width="110" Height="34" Margin="8,0,0,0"/></StackPanel>
        </StackPanel>
    </Grid>
</Window>
