<Window x:Class="Masaustu.Gorunumler.Sayfa.MerkeziTanimYonetimPenceresi" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Baslik}" Width="720" Height="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
 <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel><Button DockPanel.Dock="Top" Content="Yeni Tanım" Command="{Binding YeniKomutu}" Height="34" Margin="0,0,0,8"/><DataGrid ItemsSource="{Binding Tanimlar}" SelectedItem="{Binding Secili}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding Kod}" Width="90"/><DataGridTextColumn Header="Ad" Binding="{Binding Ad}" Width="*"/><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding AktifMi}"/></DataGrid.Columns></DataGrid></DockPanel>
  <StackPanel Grid.Column="2"><TextBlock Text="Ad *"/><TextBox Text="{Binding Ad,UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,8"/><TextBlock Text="Kod *"/><TextBox Text="{Binding Kod,UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,8"/><TextBlock Text="Kısa Ad"/><TextBox Text="{Binding KisaAd,UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,8"/><TextBlock Text="Açıklama"/><TextBox Text="{Binding Aciklama,UpdateSourceTrigger=PropertyChanged}" Height="55" AcceptsReturn="True" Margin="0,4,0,8"/><CheckBox Content="Aktif" IsChecked="{Binding AktifMi}" Margin="0,0,0,8"/><TextBlock Text="{Binding Hata}" Foreground="Crimson" TextWrapping="Wrap" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><Button Content="Kaydet" Command="{Binding KaydetKomutu}" Width="100" Height="34"/><Button Content="Aktif / Pasif" Command="{Binding AktiflikKomutu}" Width="110" Height="34" Margin="8,0,0,0"/></StackPanel></StackPanel>
 </Grid>
</Window>
