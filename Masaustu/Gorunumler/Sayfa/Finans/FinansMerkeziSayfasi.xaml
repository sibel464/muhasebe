<UserControl x:Class="Masaustu.Gorunumler.Sayfa.Finans.FinansMerkeziSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Üst Başlık & İşlem Butonları -->
            <RowDefinition Height="Auto"/> <!-- KPI Kartları -->
            <RowDefinition Height="*"/>    <!-- Ana İçerik / Sekmeler -->
            <RowDefinition Height="Auto"/> <!-- Durum Barı -->
        </Grid.RowDefinitions>

        <!-- 1. ÜST BAŞLIK BARI -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource BaslikIkonKutusu}">
                    <TextBlock Text="💳" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FİNANS OPERASYON MERKEZİ" Style="{StaticResource SayfaBasligi}"/>
                    <TextBlock Text="Kasa, Banka, POS, Virman, Vadeler ve Finansal Hareketler" Style="{StaticResource SayfaAltBaslik}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding Kasa360AcKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💵" Margin="0,0,6,0"/>
                        <TextBlock Text="Kasa 360°"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding Banka360AcKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏦" Margin="0,0,6,0"/>
                        <TextBlock Text="Banka 360°"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding TransferAcKomutu}" CommandParameter="KasaVirman" Style="{StaticResource BirinciDugme}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0"/>
                        <TextBlock Text="Virman / Transfer"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding MutabakatAcKomutu}" Style="{StaticResource IkinciDugme}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚖️" Margin="0,0,6,0"/>
                        <TextBlock Text="Mutabakat"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. ÜST KPI KARTLARI (8 ADET) -->
        <UniformGrid Grid.Row="1" Columns="8" Margin="0,0,0,14">
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,6,0" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Toplam Kasa" Style="{StaticResource EtiketMetin}" FontSize="10"/>
                    <TextBlock Text="{Binding Dashboard.ToplamKasa, StringFormat={}{0:N2} ₺}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,6,0" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Toplam Banka" Style="{StaticResource EtiketMetin}" FontSize="10"/>
                    <TextBlock Text="{Binding Dashboard.ToplamBanka, StringFormat={}{0:N2} ₺}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,6,0" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Bugünkü Tahsilat" Style="{StaticResource EtiketMetin}" FontSize="10"/>
                    <TextBlock Text="{Binding Dashboard.BugunkiTahsilat, StringFormat={}{0:N2} ₺}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessDarkFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,6,0" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Bugünkü Ödeme" Style="{StaticResource EtiketMetin}" FontSize="10"/>
                    <TextBlock Text="{Binding Dashboard.BugunkiOdeme, StringFormat={}{0:N2} ₺}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DangerDarkFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,6,0" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Beklenen Tahsilat" Style="{StaticResource EtiketMetin}" FontSize="10"/>
                    <TextBlock Text="{Binding Dashboard.BeklenenTahsilat, StringFormat={}{0:N2} ₺}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessDarkFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,6,0" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Beklenen Ödeme" Style="{StaticResource EtiketMetin}" FontSize="10"/>
                    <TextBlock Text="{Binding Dashboard.BeklenenOdeme, StringFormat={}{0:N2} ₺}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource WarningDarkFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,6,0" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Vadesi Geçen Alacak" Style="{StaticResource EtiketMetin}" FontSize="10"/>
                    <TextBlock Text="{Binding Dashboard.VadesiGecenAlacak, StringFormat={}{0:N2} ₺}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DangerDarkFirca}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiKarti}" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Vadesi Geçen Borç" Style="{StaticResource EtiketMetin}" FontSize="10"/>
                    <TextBlock Text="{Binding Dashboard.VadesiGecenBorc, StringFormat={}{0:N2} ₺}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DangerDarkFirca}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 3. ANA İÇERİK SEKMELERİ -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SeciliSekmeIndeksi}" Background="White" BorderBrush="{StaticResource BorderFirca}">
            <!-- SEKME 1: FİNANS ÖZETİ -->
            <TabItem Header="Finans Özeti">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Kasalar Tablosu -->
                    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,6,6" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" CornerRadius="8" Padding="8">
                        <DockPanel>
                            <TextBlock Text="💵 Kasalar" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                            <DataGrid ItemsSource="{Binding Kasalar}" SelectedItem="{Binding SeciliKasa}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="KasaCiftTik">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="KOD" Binding="{Binding KasaKodu}" Width="80" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="KASA ADI" Binding="{Binding KasaAdi}" Width="*"/>
                                    <DataGridTextColumn Header="ŞUBE" Binding="{Binding SubeAdi}" Width="90"/>
                                    <DataGridTextColumn Header="BAKİYE" Binding="{Binding MevcutBakiye, StringFormat={}{0:N2}}" Width="110" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="P.B." Binding="{Binding ParaBirimi}" Width="50"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Bankalar Tablosu -->
                    <Border Grid.Row="0" Grid.Column="1" Margin="6,0,0,6" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" CornerRadius="8" Padding="8">
                        <DockPanel>
                            <TextBlock Text="🏦 Banka Hesap Bakiyeleri" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                            <DataGrid ItemsSource="{Binding BankaHesaplari}" SelectedItem="{Binding SeciliBankaHesabi}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="BankaCiftTik">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="BANKA" Binding="{Binding BankaAdi}" Width="110" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="HESAP ADI" Binding="{Binding HesapAdi}" Width="*"/>
                                    <DataGridTextColumn Header="IBAN" Binding="{Binding Iban}" Width="140"/>
                                    <DataGridTextColumn Header="BAKİYE" Binding="{Binding Bakiye, StringFormat={}{0:N2}}" Width="110" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="P.B." Binding="{Binding ParaBirimi}" Width="50"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Son Hareketler -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" CornerRadius="8" Padding="8">
                        <DockPanel>
                            <TextBlock Text="📋 Son Finansal Hareketler" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                            <DataGrid ItemsSource="{Binding Hareketler}" SelectedItem="{Binding SeciliHareket}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="İŞLEM NO" Binding="{Binding IslemNo}" Width="100" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                                    <DataGridTextColumn Header="TÜR" Binding="{Binding IslemTuru}" Width="110"/>
                                    <DataGridTextColumn Header="CARİ" Binding="{Binding CariUnvan}" Width="*"/>
                                    <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="1.5*"/>
                                    <DataGridTextColumn Header="TUTAR" Binding="{Binding Tutar, StringFormat={}{0:N2} ₺}" Width="110" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="DURUM" Binding="{Binding Durum}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SEKME 2: KASALAR -->
            <TabItem Header="Kasalar">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding Kasa360AcKomutu}" Style="{StaticResource BirinciDugme}" Content="🔍 Seçili Kasa 360° Aç"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Kasalar}" SelectedItem="{Binding SeciliKasa}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="KasaCiftTik">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KASA KODU" Binding="{Binding KasaKodu}" Width="110" FontWeight="Bold"/>
                            <DataGridTextColumn Header="KASA ADI" Binding="{Binding KasaAdi}" Width="2*"/>
                            <DataGridTextColumn Header="PARA BİRİMİ" Binding="{Binding ParaBirimi}" Width="100"/>
                            <DataGridTextColumn Header="ŞUBE" Binding="{Binding SubeAdi}" Width="120"/>
                            <DataGridTextColumn Header="BUGÜNKÜ GİRİŞ" Binding="{Binding BugunkiGiris, StringFormat={}{0:N2}}" Width="120"/>
                            <DataGridTextColumn Header="BUGÜNKÜ ÇIKIŞ" Binding="{Binding BugunkiCikis, StringFormat={}{0:N2}}" Width="120"/>
                            <DataGridTextColumn Header="MEVCUT BAKİYE" Binding="{Binding MevcutBakiye, StringFormat={}{0:N2}}" Width="140" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- SEKME 3: BANKALAR -->
            <TabItem Header="Bankalar">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding Banka360AcKomutu}" Style="{StaticResource BirinciDugme}" Content="🔍 Seçili Banka 360° Aç"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding BankaHesaplari}" SelectedItem="{Binding SeciliBankaHesabi}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="BankaCiftTik">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BANKA ADI" Binding="{Binding BankaAdi}" Width="130" FontWeight="Bold"/>
                            <DataGridTextColumn Header="HESAP KODU" Binding="{Binding HesapKodu}" Width="110"/>
                            <DataGridTextColumn Header="HESAP ADI" Binding="{Binding HesapAdi}" Width="1.5*"/>
                            <DataGridTextColumn Header="IBAN" Binding="{Binding Iban}" Width="180"/>
                            <DataGridTextColumn Header="HESAP NO" Binding="{Binding HesapNo}" Width="120"/>
                            <DataGridTextColumn Header="PARA BİRİMİ" Binding="{Binding ParaBirimi}" Width="100"/>
                            <DataGridTextColumn Header="BAKİYE" Binding="{Binding Bakiye, StringFormat={}{0:N2}}" Width="140" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- SEKME 4: KREDİ KARTI / POS -->
            <TabItem Header="Kredi Kartı / POS">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding PosHesabaGecirKomutu}" Style="{StaticResource BirinciDugme}" Content="🏦 Hesaba Geçir (Seçili POS)"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding PosIslemleri}" SelectedItem="{Binding SeciliPosIslemi}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BANKA" Binding="{Binding BankaAdi}" Width="110" FontWeight="Bold"/>
                            <DataGridTextColumn Header="POS CİHAZI" Binding="{Binding PosCihazi}" Width="120"/>
                            <DataGridTextColumn Header="KART TÜRÜ" Binding="{Binding KartTuru}" Width="100"/>
                            <DataGridTextColumn Header="TAKSİT" Binding="{Binding TaksitSayisi}" Width="65"/>
                            <DataGridTextColumn Header="BRÜT TUTAR" Binding="{Binding BrutTutar, StringFormat={}{0:N2} ₺}" Width="110"/>
                            <DataGridTextColumn Header="KOMİSYON" Binding="{Binding KomisyonTutari, StringFormat={}{0:N2} ₺}" Width="100"/>
                            <DataGridTextColumn Header="NET TUTAR" Binding="{Binding NetTutar, StringFormat={}{0:N2} ₺}" Width="120" FontWeight="Bold"/>
                            <DataGridTextColumn Header="İŞLEM TARİHİ" Binding="{Binding IslemTarihi, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="VADE TARİHİ" Binding="{Binding BeklenenVadeTarihi, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="DURUM" Binding="{Binding Durum}" Width="110" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- SEKME 5: BEKLEYEN VADELER -->
            <TabItem Header="Bekleyen Vadeler">
                <DockPanel Margin="12">
                    <DataGrid ItemsSource="{Binding Vadeler}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BELGE TÜRÜ" Binding="{Binding BelgeTuru}" Width="120" FontWeight="Bold"/>
                            <DataGridTextColumn Header="YÖNETİM" Binding="{Binding YonetimTuru}" Width="90"/>
                            <DataGridTextColumn Header="CARİ KOD" Binding="{Binding CariKod}" Width="100"/>
                            <DataGridTextColumn Header="UNVAN" Binding="{Binding CariUnvan}" Width="*"/>
                            <DataGridTextColumn Header="BELGE NO" Binding="{Binding BelgeNo}" Width="110"/>
                            <DataGridTextColumn Header="VADE TARİHİ" Binding="{Binding VadeTarihi, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="KALAN TUTAR" Binding="{Binding KalanTutar, StringFormat={}{0:N2} ₺}" Width="130" FontWeight="Bold"/>
                            <DataGridTextColumn Header="GECİKME (GÜN)" Binding="{Binding GecikmeGunSayisi}" Width="110"/>
                            <DataGridTextColumn Header="DURUM" Binding="{Binding Durum}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- SEKME 6: FİNANSAL HAREKETLER -->
            <TabItem Header="Finansal Hareketler">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding HareketIptalKomutu}" Style="{StaticResource IkinciDugme}" Content="🚫 İşlemi İptal Et / Ters Kayıt"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Hareketler}" SelectedItem="{Binding SeciliHareket}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KAYNAK" Binding="{Binding Kaynak}" Width="80"/>
                            <DataGridTextColumn Header="İŞLEM NO" Binding="{Binding IslemNo}" Width="110" FontWeight="Bold"/>
                            <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                            <DataGridTextColumn Header="İŞLEM TÜRÜ" Binding="{Binding IslemTuru}" Width="120"/>
                            <DataGridTextColumn Header="CARİ" Binding="{Binding CariUnvan}" Width="*"/>
                            <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="1.5*"/>
                            <DataGridTextColumn Header="GİRİŞ" Binding="{Binding Giris, StringFormat={}{0:N2} ₺}" Width="100"/>
                            <DataGridTextColumn Header="ÇIKIŞ" Binding="{Binding Cikis, StringFormat={}{0:N2} ₺}" Width="100"/>
                            <DataGridTextColumn Header="DURUM" Binding="{Binding Durum}" Width="110" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- 4. ALT DURUM BARI -->
        <DockPanel Grid.Row="3" Margin="4,8,4,0">
            <Button Content="🔄 Yenile" Command="{Binding YenileKomutu}" Style="{StaticResource IkinciDugme}" DockPanel.Dock="Right" MinWidth="96" Padding="12,0"/>
            <TextBlock Text="{Binding DurumMesaji}" Foreground="{StaticResource TextSecondaryFirca}" VerticalAlignment="Center" FontSize="12"/>
        </DockPanel>
    </Grid>
</UserControl>
