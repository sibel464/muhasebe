<UserControl x:Class="Masaustu.Gorunumler.Sayfa.KullanicilarSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
            
            <Style x:Key="ModulYetkiBaslik" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
                <Setter Property="Margin" Value="0,14,0,6"/>
            </Style>

            <Style x:Key="YetkiCheckBox" TargetType="CheckBox">
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık ve KPI Kartları -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource BaslikIkonKutusu}">
                    <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Yönetici Kontrol Merkezi &amp; Kullanıcı Yönetimi" Style="{StaticResource SayfaBasligi}"/>
                    <TextBlock Text="Yeni kullanıcı ekleme, şifre belirleme/değiştirme, silme ve modül izin matrisi." Style="{StaticResource SayfaAltBaslik}"/>
                </StackPanel>
            </StackPanel>

            <!-- Özet KPI Kartları -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,8,0" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👥 Kullanıcı:" FontSize="12" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ToplamKullaniciSayisi}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,8,0" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👑 Yönetici:" FontSize="12" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding YoneticiSayisi}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryFirca}"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12,8" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋 İşlem Kaydı:" FontSize="12" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding AuditLogToplamSayisi}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessDarkFirca}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Ana Sekmeli Bölüm -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            
            <!-- SEKME 1: Kullanıcı Hesapları & Yetki Matrisi -->
            <TabItem Header="👤 Kullanıcı Yönetimi &amp; Yetki Matrisi">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol Panel: Kullanıcı Listesi -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16"
                            BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox Style="{StaticResource FiltreKutusu}" 
                                         Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Grid.Column="1" Content="📊 Excel" Command="{Binding ExcelAktarKomutu}" 
                                        Style="{StaticResource IkinciDugme}" Margin="6,0,0,0"/>

                                <Button Grid.Column="2" Content="+ Yeni Ekle" Command="{Binding YeniKomutu}" 
                                        Style="{StaticResource BirinciDugme}" Width="90" Margin="6,0,0,0"/>
                            </Grid>

                            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
                                <DataGrid ItemsSource="{Binding Kullanicilar}" 
                                          SelectedItem="{Binding SeciliKullanici}"
                                          Style="{StaticResource ModernDataGrid}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="KULLANICI ADI" Binding="{Binding KullaniciAdi}" Width="*" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="AD SOYAD" Binding="{Binding Ad}" Width="*"/>
                                        <DataGridTextColumn Header="ROL" Binding="{Binding Rol}" Width="75"/>
                                        <DataGridCheckBoxColumn Header="DURUM" Binding="{Binding Aktif}" Width="55"/>
                                        <DataGridTemplateColumn Header="İŞLEMLER" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="🔑" ToolTip="Şifre Değiştir"
                                                                Command="{Binding DataContext.SifreDegistirKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource IkinciDugme}"
                                                                Padding="4,2" FontSize="11" Height="24" Margin="0,0,4,0"/>
                                                        <Button Content="Sil" ToolTip="Kullanıcıyı Sil"
                                                                Command="{Binding DataContext.SatirSilKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource TehlikeliDugme}"
                                                                Padding="6,2" FontSize="11" Height="24"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Sağ Panel: Kullanıcı Profil & Yetki Düzenleme -->
                    <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Kullanıcı Bilgileri, Şifre &amp; Modül Yetki Matrisi" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}" Margin="0,0,0,12"/>
                            
                            <Border Grid.Row="1" Background="{StaticResource SuccessLightFirca}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                                    Visibility="{Binding BilgiMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                                <TextBlock Text="{Binding BilgiMesaji}" Foreground="{StaticResource SuccessDarkFirca}" FontWeight="SemiBold" FontSize="12"/>
                            </Border>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <StackPanel>
                                    <!-- Profil Bilgileri -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,10">
                                            <TextBlock Text="Kullanıcı Adı *" Style="{StaticResource EtiketMetin}"/>
                                            <TextBox Text="{Binding IslemKullanicisi.KullaniciAdi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,10">
                                            <TextBlock Text="Yeni Şifre" Style="{StaticResource EtiketMetin}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding IslemSifresi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                                <Button Grid.Column="1" Content="🔑 Sıfırla" Command="{Binding SifreDegistirKomutu}" 
                                                        Style="{StaticResource IkinciDugme}" Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,10">
                                            <TextBlock Text="Ad *" Style="{StaticResource EtiketMetin}"/>
                                            <TextBox Text="{Binding IslemKullanicisi.Ad, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,10">
                                            <TextBlock Text="Soyad" Style="{StaticResource EtiketMetin}"/>
                                            <TextBox Text="{Binding IslemKullanicisi.Soyad, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,6,10">
                                            <TextBlock Text="E-posta" Style="{StaticResource EtiketMetin}"/>
                                            <TextBox Text="{Binding IslemKullanicisi.Eposta, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,0,0,10">
                                            <TextBlock Text="Rol *" Style="{StaticResource EtiketMetin}"/>
                                            <ComboBox SelectedItem="{Binding IslemKullanicisi.Rol}" Style="{StaticResource FormAcilirKutu}">
                                                <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Kullanici</System:String>
                                                <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Yonetici</System:String>
                                            </ComboBox>
                                        </StackPanel>
                                        
                                        <CheckBox Grid.Row="3" Grid.Column="0" Content="Hesap Aktif" IsChecked="{Binding IslemKullanicisi.Aktif}" Margin="0,4,0,8" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryFirca}"/>
                                    </Grid>

                                    <Separator Background="{StaticResource BorderFirca}" Margin="0,8,0,12"/>
                                    
                                    <TextBlock Text="Modül Erişim ve İşlem İzinleri" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryFirca}" Margin="0,0,0,6"/>

                                    <!-- Yetki Checkbox'ları -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Sütun 1 -->
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Cari / Müşteri / Tedarikçi" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Cari Görüntüle" IsChecked="{Binding IslemKullanicisi.Yetkiler.CariGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Cari Ekle" IsChecked="{Binding IslemKullanicisi.Yetkiler.CariEkle}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Cari Düzenle" IsChecked="{Binding IslemKullanicisi.Yetkiler.CariDuzenle}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Cari Sil" IsChecked="{Binding IslemKullanicisi.Yetkiler.CariSil}" Style="{StaticResource YetkiCheckBox}"/>

                                            <TextBlock Text="Stok &amp; Depo Yönetimi" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Stok Görüntüle" IsChecked="{Binding IslemKullanicisi.Yetkiler.StokGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Stok Ekle" IsChecked="{Binding IslemKullanicisi.Yetkiler.StokEkle}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Stok Düzenle" IsChecked="{Binding IslemKullanicisi.Yetkiler.StokDuzenle}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Stok Sil" IsChecked="{Binding IslemKullanicisi.Yetkiler.StokSil}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Depo / Lokasyon İzle" IsChecked="{Binding IslemKullanicisi.Yetkiler.DepoGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Depo Transferi Yap" IsChecked="{Binding IslemKullanicisi.Yetkiler.DepoTransferYap}" Style="{StaticResource YetkiCheckBox}"/>
                                        </StackPanel>

                                        <!-- Sütun 2 -->
                                        <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                            <TextBlock Text="Fatura &amp; Sipariş &amp; İrsaliye" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Fatura Görüntüle" IsChecked="{Binding IslemKullanicisi.Yetkiler.FaturaGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Fatura Oluştur" IsChecked="{Binding IslemKullanicisi.Yetkiler.FaturaOlustur}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Fatura Onayla" IsChecked="{Binding IslemKullanicisi.Yetkiler.FaturaOnayla}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Fatura İptal Et" IsChecked="{Binding IslemKullanicisi.Yetkiler.FaturaIptal}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="İrsaliye Görüntüle" IsChecked="{Binding IslemKullanicisi.Yetkiler.IrsaliyeGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="İrsaliye Oluştur" IsChecked="{Binding IslemKullanicisi.Yetkiler.IrsaliyeOlustur}" Style="{StaticResource YetkiCheckBox}"/>

                                            <TextBlock Text="Hızlı Satış (POS)" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Satış Ekranı Kullan" IsChecked="{Binding IslemKullanicisi.Yetkiler.SatisYap}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Satış Beklet / Fiş İptal" IsChecked="{Binding IslemKullanicisi.Yetkiler.SatisBeklet}" Style="{StaticResource YetkiCheckBox}"/>
                                        </StackPanel>

                                        <!-- Sütun 3 -->
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                            <TextBlock Text="Kasa / Banka / Çek-Senet" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Kasa İşlemleri" IsChecked="{Binding IslemKullanicisi.Yetkiler.KasaYonet}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Banka İşlemleri" IsChecked="{Binding IslemKullanicisi.Yetkiler.BankaGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Çek / Senet İzle" IsChecked="{Binding IslemKullanicisi.Yetkiler.CekSenetGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Çek / Senet İşlem Yap" IsChecked="{Binding IslemKullanicisi.Yetkiler.CekSenetIslemYap}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Tahsilat / Ödeme Yap" IsChecked="{Binding IslemKullanicisi.Yetkiler.TahsilatYap}" Style="{StaticResource YetkiCheckBox}"/>
                                            
                                            <TextBlock Text="Sistem &amp; Raporlar" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Genel Raporlar" IsChecked="{Binding IslemKullanicisi.Yetkiler.RaporGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Finansal Raporlar" IsChecked="{Binding IslemKullanicisi.Yetkiler.FinansRaporuGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Sistem Ayarları" IsChecked="{Binding IslemKullanicisi.Yetkiler.AyarlariYonet}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Yönetici Paneli" IsChecked="{Binding IslemKullanicisi.Yetkiler.KullaniciYonet}" Style="{StaticResource YetkiCheckBox}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Butonlar -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button Content="🔑 Şifre Değiştir" Command="{Binding SifreDegistirKomutu}" Width="120" Margin="0,0,8,0"
                                        Style="{StaticResource IkinciDugme}"/>
                                <Button Content="Kullanıcıyı Sil" Command="{Binding SilKomutu}" Width="110" Margin="0,0,8,0"
                                        Style="{StaticResource TehlikeliDugme}"/>
                                <Button Content="İptal" Command="{Binding IptalKomutu}" Width="80" Margin="0,0,8,0"
                                        Style="{StaticResource IkinciDugme}"/>
                                <Button Content="Kaydet / Ekle" Command="{Binding KaydetKomutu}" Width="130"
                                        Style="{StaticResource BirinciDugme}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SEKME 2: Kim Ne Yaptı? (Canlı İşlem Geçmişi / Audit Logs) -->
            <TabItem Header="📋 Kim Ne Yaptı? (Canlı İşlem Geçmişi / Audit Log)">
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,16,0,0"
                        BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Filtreleme Barları -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Arama Kutusu -->
                            <TextBox Grid.Column="0" Style="{StaticResource FiltreKutusu}" 
                                     Text="{Binding AuditAramaMetni, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Tablo / Modül Seçimi -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Modül:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryFirca}"/>
                                <ComboBox SelectedItem="{Binding AuditSeciliTablo}" ItemsSource="{Binding TabloListesi}" Width="120" Style="{StaticResource FormAcilirKutu}"/>
                            </StackPanel>

                            <!-- İşlem Türü -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="İşlem:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryFirca}"/>
                                <ComboBox SelectedItem="{Binding AuditSeciliIslemTuruMetni}" ItemsSource="{Binding IslemTurleriListesi}" Width="110" Style="{StaticResource FormAcilirKutu}"/>
                            </StackPanel>

                            <!-- Tarih Aralığı -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <DatePicker SelectedDate="{Binding AuditBaslangicTarihi}" Width="110" Margin="0,0,4,0"/>
                                <TextBlock Text="-" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <DatePicker SelectedDate="{Binding AuditBitisTarihi}" Width="110"/>
                            </StackPanel>

                            <!-- Yenile & Excel Butonları -->
                            <Button Grid.Column="4" Content="🔄 Yenile" Command="{Binding AuditLogYenileKomutu}" 
                                    Style="{StaticResource IkinciDugme}" Margin="10,0,0,0"/>

                            <Button Grid.Column="5" Content="📊 Excel'e Aktar" Command="{Binding AuditLogExcelAktarKomutu}" 
                                    Style="{StaticResource BirinciDugme}" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- Audit Log Tablosu -->
                        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding AuditLoglar}" 
                                      SelectedItem="{Binding SeciliAuditLog}"
                                      Style="{StaticResource ModernDataGrid}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ZAMAN DAMGASI" Binding="{Binding Tarih, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="150" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="KULLANICI" Binding="{Binding KullaniciAdi}" Width="130" Foreground="{StaticResource PrimaryFirca}" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="MODÜL / TABLO" Binding="{Binding TabloAdi}" Width="140"/>
                                    <DataGridTextColumn Header="İŞLEM TÜRÜ" Binding="{Binding IslemTuru}" Width="110"/>
                                    <DataGridTextColumn Header="KAYIT ID" Binding="{Binding KayitId}" Width="90"/>
                                    <DataGridTextColumn Header="İŞLEM DETAYI &amp; AÇIKLAMA" Binding="{Binding IslemDetayi}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
