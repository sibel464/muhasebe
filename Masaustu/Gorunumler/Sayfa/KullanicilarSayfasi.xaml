<UserControl x:Class="Masaustu.Gorunumler.Sayfa.KullanicilarSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
            <yardimci:UtcYerelTarihDonusturucu x:Key="UtcYerelTarihDonusturucu"/>
            
            <Style x:Key="ModulYetkiBaslik" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
                <Setter Property="Margin" Value="0,14,0,6"/>
            </Style>

            <Style x:Key="YetkiCheckBox" TargetType="CheckBox">
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık ve KPI Kartları -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource BaslikIkonKutusu}">
                    <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Yönetici Kontrol Merkezi &amp; Kullanıcı Yönetimi" Style="{StaticResource SayfaBasligi}"/>
                    <TextBlock Text="Yeni kullanıcı ekleme, şifre belirleme/değiştirme, silme ve modül izin matrisi." Style="{StaticResource SayfaAltBaslik}"/>
                </StackPanel>
            </StackPanel>

            <!-- Özet KPI Kartları -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,8,0" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👥 Kullanıcı:" FontSize="12" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ToplamKullaniciSayisi}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,8,0" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👑 Yönetici:" FontSize="12" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding YoneticiSayisi}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryFirca}"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="12,8" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋 İşlem Kaydı:" FontSize="12" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding AuditLogToplamSayisi}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessDarkFirca}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Ana Sekmeli Bölüm -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SeciliSekmeIndeksi}">
            
            <!-- SEKME 1: Kullanıcı Hesapları & Yetki Matrisi -->
            <TabItem Header="👤 Kullanıcı Yönetimi &amp; Yetki Matrisi">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol Panel: Kullanıcı Listesi -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16"
                            BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox Style="{StaticResource FiltreKutusu}" 
                                         Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Grid.Column="1" Content="📊 Excel" Command="{Binding ExcelAktarKomutu}" 
                                        Style="{StaticResource IkinciDugme}" Margin="6,0,0,0"/>

                                <Button Grid.Column="2" Content="+ Yeni Ekle" Command="{Binding YeniKomutu}" 
                                        Style="{StaticResource BirinciDugme}" MinWidth="90" Padding="12,0" Margin="6,0,0,0"/>
                            </Grid>

                            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
                                <DataGrid ItemsSource="{Binding Kullanicilar}" 
                                          SelectedItem="{Binding SeciliKullanici}"
                                          Style="{StaticResource ModernDataGrid}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="KULLANICI ADI" Binding="{Binding KullaniciAdi}" Width="*" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="AD SOYAD" Width="*">
                                            <DataGridTextColumn.Binding>
                                                <MultiBinding StringFormat="{}{0} {1}"><Binding Path="Ad"/><Binding Path="Soyad"/></MultiBinding>
                                            </DataGridTextColumn.Binding>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="ROL" Binding="{Binding Rol}" Width="70"/>
                                        <DataGridCheckBoxColumn Header="AKTİF" Binding="{Binding Aktif}" Width="55"/>
                                        <DataGridTextColumn Header="SON GİRİŞ" Binding="{Binding SonGirisTarihi, Converter={StaticResource UtcYerelTarihDonusturucu}, ConverterParameter='dd.MM.yy HH:mm'}" Width="95"/>
                                        <DataGridTemplateColumn Header="İŞLEMLER" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="📋" ToolTip="Bu kullanıcının yaptığı işlemleri göster"
                                                                Command="{Binding DataContext.KullaniciIslemleriKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource IkinciDugme}"
                                                                Padding="4,2" FontSize="11" Height="24" Margin="0,0,4,0"/>
                                                        <Button Content="🔑" ToolTip="Şifre Değiştir"
                                                                Command="{Binding DataContext.SifreDegistirKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource IkinciDugme}"
                                                                Padding="4,2" FontSize="11" Height="24" Margin="0,0,4,0"/>
                                                        <Button Content="Sil" ToolTip="Kullanıcıyı Sil"
                                                                Command="{Binding DataContext.SatirSilKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource TehlikeliDugme}"
                                                                Padding="6,2" FontSize="11" Height="24"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Sağ Panel: Kullanıcı Profil & Yetki Düzenleme -->
                    <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Kullanıcı Bilgileri, Şifre &amp; Modül Yetki Matrisi" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}" Margin="0,0,0,12"/>
                            
                            <Border Grid.Row="1" Background="{StaticResource SuccessLightFirca}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                                    Visibility="{Binding BilgiMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                                <TextBlock Text="{Binding BilgiMesaji}" Foreground="{StaticResource SuccessDarkFirca}" FontWeight="SemiBold" FontSize="12"/>
                            </Border>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <StackPanel>
                                    <!-- Profil Bilgileri -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,10">
                                            <TextBlock Text="Kullanıcı Adı *" Style="{StaticResource EtiketMetin}"/>
                                            <TextBox Text="{Binding IslemKullanicisi.KullaniciAdi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,10">
                                            <TextBlock Text="Yeni Şifre" Style="{StaticResource EtiketMetin}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding IslemSifresi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                                <Button Grid.Column="1" Content="🔑 Sıfırla" Command="{Binding SifreDegistirKomutu}" 
                                                        Style="{StaticResource IkinciDugme}" Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,10">
                                            <TextBlock Text="Ad *" Style="{StaticResource EtiketMetin}"/>
                                            <TextBox Text="{Binding IslemKullanicisi.Ad, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,10">
                                            <TextBlock Text="Soyad" Style="{StaticResource EtiketMetin}"/>
                                            <TextBox Text="{Binding IslemKullanicisi.Soyad, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,6,10">
                                            <TextBlock Text="E-posta" Style="{StaticResource EtiketMetin}"/>
                                            <TextBox Text="{Binding IslemKullanicisi.Eposta, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,0,0,10">
                                            <TextBlock Text="Rol *" Style="{StaticResource EtiketMetin}"/>
                                            <ComboBox SelectedItem="{Binding IslemKullanicisi.Rol}" Style="{StaticResource FormAcilirKutu}">
                                                <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Kullanici</System:String>
                                                <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Yonetici</System:String>
                                            </ComboBox>
                                        </StackPanel>
                                        
                                        <CheckBox Grid.Row="3" Grid.Column="0" Content="Hesap Aktif" IsChecked="{Binding IslemKullanicisi.Aktif}" Margin="0,4,0,8" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryFirca}"/>
                                    </Grid>

                                    <Separator Background="{StaticResource BorderFirca}" Margin="0,8,0,12"/>
                                    
                                    <TextBlock Text="Modül Erişim ve İşlem İzinleri" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryFirca}" Margin="0,0,0,6"/>

                                    <!-- Yetki şablonu: seçilen role uygun yetkileri tek tıkla işaretler; sonra tek tek düzenlenebilir -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Hazır şablon:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryFirca}"/>
                                        <ComboBox ItemsSource="{Binding YetkiSablonlari}" SelectedItem="{Binding SeciliYetkiSablonu}" Width="220" Style="{StaticResource FormAcilirKutu}"/>
                                        <Button Content="Uygula" Command="{Binding SablonUygulaKomutu}" Width="80" Margin="8,0,0,0" Style="{StaticResource IkinciDugme}"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Cari / Müşteri / Tedarikçi" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Cari Görüntüle" IsChecked="{Binding IslemKullanicisi.Yetkiler.CariGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Cari Ekle" IsChecked="{Binding IslemKullanicisi.Yetkiler.CariEkle}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Cari Düzenle" IsChecked="{Binding IslemKullanicisi.Yetkiler.CariDuzenle}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Cari Sil" IsChecked="{Binding IslemKullanicisi.Yetkiler.CariSil}" Style="{StaticResource YetkiCheckBox}"/>
                                            <TextBlock Text="Stok &amp; Depo" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Stok Görüntüle" IsChecked="{Binding IslemKullanicisi.Yetkiler.StokGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Stok Ekle" IsChecked="{Binding IslemKullanicisi.Yetkiler.StokEkle}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Stok Düzenle" IsChecked="{Binding IslemKullanicisi.Yetkiler.StokDuzenle}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Ürün Fiyatı Değiştir" IsChecked="{Binding IslemKullanicisi.Yetkiler.StokFiyatDegistir}" Style="{StaticResource YetkiCheckBox}"
                                                      ToolTip="İşaretli değilse çalışan ürün kartını düzenleyebilir ama alış/satış fiyatını değiştiremez."/>
                                            <CheckBox Content="Stok Sil" IsChecked="{Binding IslemKullanicisi.Yetkiler.StokSil}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Depo / Lokasyon İzle" IsChecked="{Binding IslemKullanicisi.Yetkiler.DepoGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Depo Transferi Yap" IsChecked="{Binding IslemKullanicisi.Yetkiler.DepoTransferYap}" Style="{StaticResource YetkiCheckBox}"/>
                                            <TextBlock Text="Hızlı Satış (POS)" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Satış Ekranı Kullan" IsChecked="{Binding IslemKullanicisi.Yetkiler.SatisYap}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Satış Geçmişini Gör" IsChecked="{Binding IslemKullanicisi.Yetkiler.SatisGecmisiGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                            <TextBlock Text="Fatura &amp; İrsaliye" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Fatura Görüntüle" IsChecked="{Binding IslemKullanicisi.Yetkiler.FaturaGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Fatura Oluştur" IsChecked="{Binding IslemKullanicisi.Yetkiler.FaturaOlustur}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Fatura Onayla" IsChecked="{Binding IslemKullanicisi.Yetkiler.FaturaOnayla}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Fatura İptal Et" IsChecked="{Binding IslemKullanicisi.Yetkiler.FaturaIptal}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="İrsaliye Görüntüle" IsChecked="{Binding IslemKullanicisi.Yetkiler.IrsaliyeGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="İrsaliye Oluştur" IsChecked="{Binding IslemKullanicisi.Yetkiler.IrsaliyeOlustur}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="İrsaliye Onayla" IsChecked="{Binding IslemKullanicisi.Yetkiler.IrsaliyeOnayla}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="İrsaliye İptal Et" IsChecked="{Binding IslemKullanicisi.Yetkiler.IrsaliyeIptal}" Style="{StaticResource YetkiCheckBox}"/>
                                            <TextBlock Text="Raporlar" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Genel Raporlar" IsChecked="{Binding IslemKullanicisi.Yetkiler.RaporGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Finansal Raporlar" IsChecked="{Binding IslemKullanicisi.Yetkiler.FinansRaporuGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <TextBlock Text="Personel &amp; Maaş" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Personeli Görüntüle" IsChecked="{Binding IslemKullanicisi.Yetkiler.PersonelGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Personel Ekle" IsChecked="{Binding IslemKullanicisi.Yetkiler.PersonelEkle}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Personel / Maaş İşlemi" IsChecked="{Binding IslemKullanicisi.Yetkiler.PersonelDuzenle}" Style="{StaticResource YetkiCheckBox}"
                                                      ToolTip="Personel kartını düzenleme, maaş tahakkuku, avans ve maaş ödemesi."/>
                                            <CheckBox Content="Personel Sil" IsChecked="{Binding IslemKullanicisi.Yetkiler.PersonelSil}" Style="{StaticResource YetkiCheckBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                            <TextBlock Text="Kasa" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Kasa Görüntüle" IsChecked="{Binding IslemKullanicisi.Yetkiler.KasaGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Kasa Yönetimi (virman, sayım, tanım)" IsChecked="{Binding IslemKullanicisi.Yetkiler.KasaYonet}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Kasa Gelir Fişi" IsChecked="{Binding IslemKullanicisi.Yetkiler.GelirEkle}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Kasa Gider Fişi" IsChecked="{Binding IslemKullanicisi.Yetkiler.GiderEkle}" Style="{StaticResource YetkiCheckBox}"/>
                                            <TextBlock Text="Banka" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Banka Görüntüle" IsChecked="{Binding IslemKullanicisi.Yetkiler.BankaGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Banka İşlemi Ekle" IsChecked="{Binding IslemKullanicisi.Yetkiler.BankaEkle}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Banka İşlemi / Hesap Düzenle" IsChecked="{Binding IslemKullanicisi.Yetkiler.BankaDuzenle}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Banka Hareketi Sil" IsChecked="{Binding IslemKullanicisi.Yetkiler.BankaSil}" Style="{StaticResource YetkiCheckBox}"/>
                                            <TextBlock Text="Tahsilat &amp; Finans" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Tahsilat Yap" IsChecked="{Binding IslemKullanicisi.Yetkiler.TahsilatYap}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Ödeme Yap" IsChecked="{Binding IslemKullanicisi.Yetkiler.OdemeYap}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Finans Merkezi Görüntüle" IsChecked="{Binding IslemKullanicisi.Yetkiler.FinansGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Virman / Transfer Yap" IsChecked="{Binding IslemKullanicisi.Yetkiler.VirmanYap}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Finans İşlemi İptal Et" IsChecked="{Binding IslemKullanicisi.Yetkiler.FinansIptal}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Kasa Mutabakatı" IsChecked="{Binding IslemKullanicisi.Yetkiler.Mutabakat}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="POS Yönetimi" IsChecked="{Binding IslemKullanicisi.Yetkiler.POSYonet}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Çek / Senet Görüntüle" IsChecked="{Binding IslemKullanicisi.Yetkiler.CekSenetGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Çek / Senet İşlem Yap" IsChecked="{Binding IslemKullanicisi.Yetkiler.CekSenetIslemYap}" Style="{StaticResource YetkiCheckBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                            <TextBlock Text="Muhasebe" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Yevmiye Fişlerini Gör" IsChecked="{Binding IslemKullanicisi.Yetkiler.MuhasebeFisGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Yevmiye Fişi Ekle" IsChecked="{Binding IslemKullanicisi.Yetkiler.MuhasebeFisEkle}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Yevmiye Fişi Onayla" IsChecked="{Binding IslemKullanicisi.Yetkiler.MuhasebeFisOnayla}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Yevmiye Fişi İptal Et" IsChecked="{Binding IslemKullanicisi.Yetkiler.MuhasebeFisIptal}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Hesap Planı Yönetimi" IsChecked="{Binding IslemKullanicisi.Yetkiler.HesapPlaniYonet}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Mizan Görüntüle" IsChecked="{Binding IslemKullanicisi.Yetkiler.MizanGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Maliyet Hesaplarını Gör" IsChecked="{Binding IslemKullanicisi.Yetkiler.MaliyetHesaplariGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <TextBlock Text="Sistem" Style="{StaticResource ModulYetkiBaslik}"/>
                                            <CheckBox Content="Sistem Ayarları &amp; Yedek" IsChecked="{Binding IslemKullanicisi.Yetkiler.AyarlariYonet}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Kullanıcı Yönetimi" IsChecked="{Binding IslemKullanicisi.Yetkiler.KullaniciYonet}" Style="{StaticResource YetkiCheckBox}"/>
                                            <CheckBox Content="Kim Ne Yaptı? (işlem geçmişi) Gör" IsChecked="{Binding IslemKullanicisi.Yetkiler.AuditLogGoruntule}" Style="{StaticResource YetkiCheckBox}"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryFirca}"
                                                       Text="Rolü &quot;Yonetici&quot; olan kullanıcı her şeyi görür ve yapar; işaretler yalnız diğer roller için geçerlidir. Değişiklik, kişinin açık oturumuna en geç 1 dakikada yansır."/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Butonlar -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button Content="🔑 Şifre Değiştir" Command="{Binding SifreDegistirKomutu}" MinWidth="120" Padding="12,0" Margin="0,0,8,0"
                                        Style="{StaticResource IkinciDugme}"/>
                                <Button Content="Kullanıcıyı Sil" Command="{Binding SilKomutu}" Width="110" Margin="0,0,8,0"
                                        Style="{StaticResource TehlikeliDugme}"/>
                                <Button Content="İptal" Command="{Binding IptalKomutu}" Width="80" Margin="0,0,8,0"
                                        Style="{StaticResource IkinciDugme}"/>
                                <Button Content="Kaydet / Ekle" Command="{Binding KaydetKomutu}" Width="130"
                                        Style="{StaticResource BirinciDugme}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SEKME 2: Kim Ne Yaptı? -->
            <TabItem Header="📋 Kim Ne Yaptı? (İşlem Geçmişi)">
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,16,0,0"
                        BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Süzme -->
                        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBox Style="{StaticResource FiltreKutusu}" Width="230" Margin="0,0,10,6"
                                     ToolTip="Kullanıcı, belge no, cari adı, tutar, bilgisayar... içinde arar"
                                     Text="{Binding AuditAramaMetni, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,6" VerticalAlignment="Center">
                                <TextBlock Text="Kim:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryFirca}"/>
                                <ComboBox ItemsSource="{Binding KullaniciSecenekleri}" SelectedItem="{Binding AuditSeciliKullanici}" DisplayMemberPath="Ad"
                                          Width="190" Style="{StaticResource FormAcilirKutu}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,6" VerticalAlignment="Center">
                                <TextBlock Text="Nerede:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryFirca}"/>
                                <ComboBox ItemsSource="{Binding ModulSecenekleri}" SelectedItem="{Binding AuditSeciliModul}" DisplayMemberPath="Ad"
                                          Width="170" Style="{StaticResource FormAcilirKutu}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,6" VerticalAlignment="Center">
                                <TextBlock Text="Ne yaptı:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryFirca}"/>
                                <ComboBox SelectedItem="{Binding AuditSeciliIslemTuruMetni}" ItemsSource="{Binding IslemTurleriListesi}" Width="120" Style="{StaticResource FormAcilirKutu}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,6" VerticalAlignment="Center">
                                <TextBlock Text="Ne zaman:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryFirca}"/>
                                <DatePicker SelectedDate="{Binding AuditBaslangicTarihi}" Width="110" Margin="0,0,4,0"/>
                                <TextBlock Text="-" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <DatePicker SelectedDate="{Binding AuditBitisTarihi}" Width="110"/>
                            </StackPanel>
                        </WrapPanel>
                        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
                            <CheckBox DockPanel.Dock="Left" Content="Ayrıntı satırlarını da göster (fatura kalemleri, stok ve yevmiye satırları)"
                                      IsChecked="{Binding AyrintiSatirlariniGoster}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryFirca}"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding AuditMesaji}" Margin="16,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryFirca}" FontStyle="Italic"/>
                            <Button DockPanel.Dock="Right" Content="📊 Excel'e Aktar" Command="{Binding AuditLogExcelAktarKomutu}" Style="{StaticResource BirinciDugme}" Margin="6,0,0,0"/>
                            <Button DockPanel.Dock="Right" Content="🔄 Yenile" Command="{Binding AuditLogYenileKomutu}" Style="{StaticResource IkinciDugme}" Margin="6,0,0,0"/>
                            <Button DockPanel.Dock="Right" Content="Süzmeyi Temizle" Command="{Binding AuditFiltreTemizleKomutu}" Style="{StaticResource IkinciDugme}"/>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
                                <DataGrid ItemsSource="{Binding AuditSatirlari}"
                                          SelectedItem="{Binding SeciliAuditSatiri}"
                                          Style="{StaticResource ModernDataGrid}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single"
                                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ZAMAN" Binding="{Binding Zaman, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="150" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="KİM" Binding="{Binding Kullanici}" Width="105" Foreground="{StaticResource PrimaryFirca}" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="NE YAPTI" Binding="{Binding Islem}" Width="90"/>
                                        <DataGridTextColumn Header="NEREDE" Binding="{Binding Modul}" Width="130"/>
                                        <DataGridTextColumn Header="KAYIT" Binding="{Binding KayitNo}" Width="60"/>
                                        <DataGridTextColumn Header="AYRINTI" Binding="{Binding Ozet}" Width="*"/>
                                        <DataGridTextColumn Header="BİLGİSAYAR" Binding="{Binding Bilgisayar}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Seçili işlemin alan alan dökümü -->
                            <Border Grid.Column="2" Background="{StaticResource BackgroundFirca}" CornerRadius="8" Padding="12"
                                    BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Seçili işlemde ne değişti?" FontWeight="Bold" Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryFirca}"/>
                                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryFirca}" FontSize="11"
                                               Text="Listeden bir satır seçin. Değiştirilen her alan için önceki ve yeni değer görünür."/>
                                    <ItemsControl ItemsSource="{Binding SeciliDegisiklikler}">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderFirca}" BorderThickness="0,0,0,1" Padding="0,5">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Alan}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryFirca}"/>
                                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DangerFirca}" Visibility="{Binding Eski, Converter={StaticResource BosBoslukDonusturucu}}">
                                                            <Run Text="Önce: "/><Run Text="{Binding Eski, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SuccessDarkFirca}" Visibility="{Binding Yeni, Converter={StaticResource BosBoslukDonusturucu}}">
                                                            <Run Text="Sonra: "/><Run Text="{Binding Yeni, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
