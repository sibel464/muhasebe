<Window x:Class="Masaustu.Gorunumler.Sayfa.Irsaliye.IrsaliyeDetayPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
        xmlns:irsaliye="clr-namespace:EtkiAlani.Modeller.Irsaliye;assembly=EtkiAlani"
        Title="İrsaliye Detayı" 
        Height="700" Width="950"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" BorderBrush="{StaticResource BorderDarkFirca}" BorderThickness="1" Background="#F8FAFC" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.25"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Başlık -->
                <RowDefinition Height="Auto"/> <!-- İrsaliye & Cari Bilgi Kartları -->
                <RowDefinition Height="*"/>    <!-- Kalemler Tablosu -->
                <RowDefinition Height="Auto"/> <!-- Finansal Özet & Aksiyonlar -->
            </Grid.RowDefinitions>

            <!-- 1. ÜST BAŞLIK -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource BaslikIkonKutusu}">
                        <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="İrsaliye Detayı: " FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                            <TextBlock x:Name="TxtIrsaliyeNo" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}"/>
                        </StackPanel>
                        <TextBlock Text="İrsaliye ve sevk kalemlerine ait tüm ayrıntılar." FontSize="12" Foreground="{StaticResource TextSecondaryFirca}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Kapat Butonu -->
                <Button Grid.Column="1" Click="BtnKapat_Click" Style="{StaticResource IkinciDugme}" Width="36" Height="36" Padding="0">
                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold"/>
                </Button>
            </Grid>

            <!-- 2. BİLGİ KARTLARI -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cari Bilgileri -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,8,0" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CARİ BİLGİLERİ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtCariUnvan" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                        <TextBlock x:Name="TxtCariKod" FontSize="12" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TxtCariVergi" FontSize="12" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Belge Bilgileri -->
                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16" Margin="8,0,0,0" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="BELGE BİLGİLERİ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Tarih:" FontSize="12" Foreground="{StaticResource TextSecondaryFirca}"/>
                            <TextBlock x:Name="TxtTarih" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryFirca}"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Tür:" FontSize="12" Foreground="{StaticResource TextSecondaryFirca}"/>
                            <TextBlock x:Name="TxtTur" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkFirca}"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Durum:" FontSize="12" Foreground="{StaticResource TextSecondaryFirca}"/>
                            <TextBlock x:Name="TxtDurum" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessDarkFirca}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. KALEMLER TABLOSU -->
            <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
                <DataGrid x:Name="DgKalemler" 
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ÜRÜN KODU" Binding="{Binding Urun.Kod}" Width="120" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="ÜRÜN ADI" Binding="{Binding Urun.Ad}" Width="2*"/>
                        <DataGridTextColumn Header="MİKTAR" Binding="{Binding Miktar, StringFormat='{}{0:N2}'}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="BİRİM FİYAT" Binding="{Binding BirimFiyat, StringFormat='{}{0:N2} ₺'}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="KDV" Binding="{Binding Kdv, StringFormat='%{0}'}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="TOPLAM" Binding="{Binding Toplam, StringFormat='{}{0:N2} ₺'}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryDarkFirca}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 4. ALT ÖZET & BUTONLAR -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ara Toplam: " FontSize="12" Foreground="{StaticResource TextSecondaryFirca}"/>
                        <TextBlock x:Name="TxtAraToplam" FontSize="12" FontWeight="SemiBold" Margin="0,0,16,0"/>
                        <TextBlock Text="KDV Toplam: " FontSize="12" Foreground="{StaticResource TextSecondaryFirca}"/>
                        <TextBlock x:Name="TxtKdvToplam" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="8" Padding="14,8" Margin="0,0,16,0" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="GENEL TOPLAM: " FontSize="13" Foreground="{StaticResource TextSecondaryFirca}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtGenelToplam" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnFaturayaDonustur" Click="BtnFaturayaDonustur_Click" Style="{StaticResource BirinciDugme}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧾" Margin="0,0,6,0"/>
                            <TextBlock Text="Faturaya Dönüştür"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnKapat_Click" Style="{StaticResource IkinciDugme}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" Margin="0,0,6,0"/>
                            <TextBlock Text="Kapat"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
