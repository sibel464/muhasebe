<UserControl x:Class="Masaustu.Gorunumler.Sayfa.IrsaliyeSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
             xmlns:irsaliye="clr-namespace:EtkiAlani.Modeller.Irsaliye;assembly=EtkiAlani"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Başlık & Aksiyonlar -->
            <RowDefinition Height="Auto"/> <!-- 2. İstatistik Kartları -->
            <RowDefinition Height="Auto"/> <!-- 3. Filtre Paneli -->
            <RowDefinition Height="*"/>    <!-- 4. İrsaliye Tablosu -->
            <RowDefinition Height="Auto"/> <!-- 5. Alt Durum Çubuğu -->
        </Grid.RowDefinitions>

        <!-- 1. ÜST PANEL: BAŞLIK & AKSİYONLAR -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource BaslikIkonKutusu}">
                    <TextBlock Text="🚚" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="İrsaliye &amp; Sevk Yönetimi" Style="{StaticResource SayfaBasligi}"/>
                    <TextBlock Text="Alış ve Satış irsaliyelerini yönetin, stoğu takip edin ve tek tıkla faturaya dönüştürün." Style="{StaticResource SayfaAltBaslik}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding ExcelAktarKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0" Content="Excel / CSV"/>
                <Button Command="{Binding YenileKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Yenile" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding YeniIrsaliyeKomutu}" Style="{StaticResource BirinciDugme}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Yeni İrsaliye Oluştur" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. İSTATİSTİK KARTLARI -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <!-- Toplam İrsaliye -->
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,12,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="TOPLAM İRSALİYE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}"/>
                    <TextBlock Text="{Binding ToplamIrsaliyeSayisi}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Taslak İrsaliyeler -->
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,12,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="BEKLEYEN TASLAKLAR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningDarkFirca}"/>
                    <TextBlock Text="{Binding TaslakSayisi}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WarningDarkFirca}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Onaylı (Sevk Edilmiş) -->
            <Border Style="{StaticResource KpiKarti}" Margin="0,0,12,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="ONAYLI (SEVK EDİLDİ)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}"/>
                    <TextBlock Text="{Binding OnayliSayisi}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Faturalandırılan -->
            <Border Style="{StaticResource KpiKarti}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="FATURALANDIRILAN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessDarkFirca}"/>
                    <TextBlock Text="{Binding FaturalananSayisi}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessDarkFirca}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 3. FİLTRELEME BARI -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Akıllı Arama Motoru" Style="{StaticResource EtiketMetin}"/>
                    <TextBox Style="{StaticResource FiltreKutusu}" Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="İrsaliye, sipariş, fatura, cari, ürün, barkod, teslimat, taşıyıcı, şoför veya plaka içinde arayın"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="İrsaliye Türü" Style="{StaticResource EtiketMetin}"/>
                    <ComboBox Style="{StaticResource FiltreAcilirKutu}" SelectedValue="{Binding SeciliTurFiltre, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" yardimci:ComboBoxAramaDavranisi.Etkin="True">
                        <ComboBoxItem Content="Tümü"/>
                        <ComboBoxItem Content="Alış İrsaliyesi"/>
                        <ComboBoxItem Content="Satış İrsaliyesi"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Durum" Style="{StaticResource EtiketMetin}"/>
                    <ComboBox Style="{StaticResource FiltreAcilirKutu}" SelectedValue="{Binding SeciliDurumFiltre, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" yardimci:ComboBoxAramaDavranisi.Etkin="True">
                        <ComboBoxItem Content="Tümü"/>
                        <ComboBoxItem Content="Taslak"/>
                        <ComboBoxItem Content="Onaylandı"/>
                        <ComboBoxItem Content="Faturalandı"/>
                        <ComboBoxItem Content="İptal"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="0,0,0,2">
                    <Button Command="{Binding FiltreTemizleKomutu}" Style="{StaticResource UtilityDugme}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" Margin="0,0,6,0"/>
                            <TextBlock Text="Filtreyi Sıfırla"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,10,0">
                    <TextBlock Text="Cari Hesap" Style="{StaticResource EtiketMetin}"/>
                    <ComboBox ItemsSource="{Binding Cariler}" SelectedItem="{Binding SeciliCariFiltre}"
                              DisplayMemberPath="Unvan" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                              yardimci:ComboBoxAramaDavranisi.Etkin="True"
                              Style="{StaticResource FiltreAcilirKutu}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,10,0">
                    <TextBlock Text="Başlangıç Tarihi" Style="{StaticResource EtiketMetin}"/>
                    <DatePicker SelectedDate="{Binding BaslangicTarihi}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,10,0">
                    <TextBlock Text="Bitiş Tarihi" Style="{StaticResource EtiketMetin}"/>
                    <DatePicker SelectedDate="{Binding BitisTarihi}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,10,0,0">
                    <TextBlock Text="Sıralama" Style="{StaticResource EtiketMetin}"/>
                    <ComboBox ItemsSource="{Binding SiralamaSecenekleri}" SelectedItem="{Binding SiralamaFiltre}"
                              IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                              yardimci:ComboBoxAramaDavranisi.Etkin="True"
                              Style="{StaticResource FiltreAcilirKutu}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,10,0">
                    <TextBlock Text="Tutar Aralığı" Style="{StaticResource EtiketMetin}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource FormGirisKutusu}" Text="{Binding MinimumTutar, UpdateSourceTrigger=PropertyChanged}" ToolTip="Minimum genel toplam"/>
                        <TextBox Grid.Column="2" Style="{StaticResource FormGirisKutusu}" Text="{Binding MaksimumTutar, UpdateSourceTrigger=PropertyChanged}" ToolTip="Maksimum genel toplam"/>
                    </Grid>
                </StackPanel>
                <CheckBox Grid.Row="2" Grid.Column="1" Content="Yalnız geciken taslak sevkler"
                          IsChecked="{Binding YalnizGecikenSevkler}" VerticalAlignment="Bottom" Margin="0,10,10,10" FontWeight="SemiBold"/>
                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <TextBlock Text="Hızlı Görünümler" Style="{StaticResource EtiketMetin}"/>
                    <WrapPanel>
                        <Button Content="Bugün" Command="{Binding HizliFiltreKomutu}" CommandParameter="Bugün" Style="{StaticResource UtilityDugme}" Margin="0,0,6,4"/>
                        <Button Content="Bu Ay" Command="{Binding HizliFiltreKomutu}" CommandParameter="Bu Ay" Style="{StaticResource UtilityDugme}" Margin="0,0,6,4"/>
                        <Button Content="Sevke Hazır" Command="{Binding HizliFiltreKomutu}" CommandParameter="Sevke Hazır" Style="{StaticResource UtilityDugme}" Margin="0,0,6,4"/>
                        <Button Content="Faturalanmamış" Command="{Binding HizliFiltreKomutu}" CommandParameter="Faturalanmamış" Style="{StaticResource UtilityDugme}" Margin="0,0,6,4"/>
                        <Button Content="Geciken" Command="{Binding HizliFiltreKomutu}" CommandParameter="Geciken" Style="{StaticResource UtilityDugme}" Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. DATAGRID TABLO -->
        <Border Grid.Row="3" Background="White" CornerRadius="10"
                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="700"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" ItemsSource="{Binding Irsaliyeler}" 
                      SelectedItem="{Binding SeciliIrsaliye, Mode=TwoWay}"
                      Style="{StaticResource ModernDataGrid}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <!-- Tür Badge -->
                    <DataGridTemplateColumn Header="TÜR" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource DurumRozeti}">
                                            <Setter Property="Background" Value="{StaticResource PrimaryLightFirca}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tur}" Value="{x:Static irsaliye:IrsaliyeTuru.Alis}">
                                                    <Setter Property="Background" Value="{StaticResource SuccessLightFirca}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Tur}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryDarkFirca}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tur}" Value="{x:Static irsaliye:IrsaliyeTuru.Alis}">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessDarkFirca}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="İRSALİYE NO" Binding="{Binding IrsaliyeNo}" Width="130" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="SİPARİŞ NO" Binding="{Binding Siparis.SiparisNo}" Width="130" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat='dd.MM.yyyy HH:mm'}" Width="120"/>
                    <DataGridTextColumn Header="SEVK TARİHİ" Binding="{Binding SevkTarihiMetni}" Width="130" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="CARİ / FİRMA" Binding="{Binding CariKart.Unvan}" Width="2*"/>
                    
                    <DataGridTextColumn Header="TOPLAM TUTAR" Binding="{Binding GenelToplam, StringFormat='{}{0:N2} ₺'}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Durum Badge -->
                    <DataGridTemplateColumn Header="DURUM" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource DurumRozeti}">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Durum}" Value="{x:Static irsaliye:IrsaliyeDurumu.Onaylandi}">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryLightFirca}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Durum}" Value="{x:Static irsaliye:IrsaliyeDurumu.Faturalandi}">
                                                    <Setter Property="Background" Value="{StaticResource SuccessLightFirca}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Durum}" Value="{x:Static irsaliye:IrsaliyeDurumu.Iptal}">
                                                    <Setter Property="Background" Value="{StaticResource DangerLightFirca}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Durum}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryFirca}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Durum}" Value="{x:Static irsaliye:IrsaliyeDurumu.Onaylandi}">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryDarkFirca}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Durum}" Value="{x:Static irsaliye:IrsaliyeDurumu.Faturalandi}">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessDarkFirca}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Durum}" Value="{x:Static irsaliye:IrsaliyeDurumu.Iptal}">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerDarkFirca}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- İşlemler -->
                    <DataGridTemplateColumn Header="İŞLEMLER" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.DetayGoruntuleKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TabloAksiyonDugme}" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👁️" Margin="0,0,4,0"/>
                                            <TextBlock Text="Detay"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding DataContext.YazdirKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TabloAksiyonDugme}" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🖨️" Margin="0,0,4,0"/>
                                            <TextBlock Text="Yazdır"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding DataContext.OnaylaKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding OnaylanabilirMi, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource TabloAksiyonDugme}" Background="{StaticResource SuccessLightFirca}" Foreground="{StaticResource SuccessDarkFirca}" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✓" Margin="0,0,4,0"/>
                                            <TextBlock Text="Onayla"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding DataContext.FaturayaDonusturKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding FaturalanabilirMi, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource TabloAksiyonDugme}" Background="{StaticResource PrimaryLightFirca}" Foreground="{StaticResource PrimaryDarkFirca}" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🧾" Margin="0,0,4,0"/>
                                            <TextBlock Text="Faturala"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding DataContext.IptalEtKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IptalEdilebilirMi, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource TabloAksiyonDugme}" Background="{StaticResource DangerLightFirca}" Foreground="{StaticResource DangerDarkFirca}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✕" Margin="0,0,4,0"/>
                                            <TextBlock Text="İptal"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
                <Border Grid.Column="1" Background="#E2E8F0"/>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="#F8FAFC">
                    <StackPanel Margin="18">
                        <TextBlock Text="BELGE 360°" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SeciliIrsaliye.IrsaliyeNo, TargetNullValue=İrsaliye seçilmedi}"
                                   FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,2"/>
                        <TextBlock Text="{Binding SeciliIrsaliye.BelgeAkisOzeti}" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <Border Background="White" CornerRadius="8" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="CARİ VE KAYNAK" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SeciliIrsaliye.CariKart.Unvan, TargetNullValue=—}" FontWeight="Bold" Margin="0,6,0,2" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SeciliIrsaliye.CariKart.Kod, StringFormat=Cari kodu: {0}, TargetNullValue=—}" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SeciliIrsaliye.Siparis.SiparisNo, StringFormat=Sipariş: {0}, TargetNullValue=Sipariş bağlantısı yok}" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SeciliIrsaliye.DonusturulenFatura.FaturaNo, StringFormat=Fatura: {0}, TargetNullValue=Henüz faturalanmadı}" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="8" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="SEVK VE TESLİMAT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SeciliIrsaliye.SevkTarihiMetni, StringFormat=Sevk zamanı: {0}}" Margin="0,6,0,2"/>
                                <TextBlock Text="{Binding SeciliIrsaliye.TeslimatAdSoyad, StringFormat=Teslim alan: {0}, TargetNullValue=—}"/>
                                    <TextBlock Text="{Binding SeciliIrsaliye.TeslimatAdres, TargetNullValue=Teslimat adresi girilmemiş}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding SeciliIrsaliye.Tasiyici, StringFormat=Taşıyıcı: {0}, TargetNullValue=—}" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding SeciliIrsaliye.AracPlaka, StringFormat=Plaka: {0}, TargetNullValue=—}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#EFF6FF" CornerRadius="8" Padding="12" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="MALİ ÖZET" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                                <TextBlock Grid.Row="1" Text="Kalem sayısı" Margin="0,8,0,2"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SeciliIrsaliye.Kalemler.Count}" FontWeight="Bold"/>
                                <TextBlock Grid.Row="2" Text="Ara toplam"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SeciliIrsaliye.AraToplam, StringFormat={}{0:N2} ₺}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="3" Text="Genel toplam" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SeciliIrsaliye.GenelToplam, StringFormat={}{0:N2} ₺}" FontSize="16" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,5,0,0"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding SeciliBelgeAkisi}" TextWrapping="Wrap" Foreground="#475569" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 5. ALT DURUM ÇUBUĞU -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="14,8" Margin="0,12,0,0"
                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1"
                Visibility="{Binding DurumMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding FiltreSonucOzeti}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}"/>
                <TextBlock Grid.Column="1" Text="{Binding SeciliBelgeAkisi}" Margin="18,0"
                           Foreground="{StaticResource TextSecondaryFirca}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding DurumMesaji}" Foreground="{StaticResource TextSecondaryFirca}" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
