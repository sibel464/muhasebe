<UserControl x:Class="Masaustu.Gorunumler.Sayfa.Musteri.MusteriDetayGurunumu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
             xmlns:model="clr-namespace:EtkiAlani.Modeller.Cari;assembly=EtkiAlani"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="12" Background="White" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık Barı -->
            <Border Grid.Row="0" Background="{StaticResource MenuGradient}" Padding="20,16" CornerRadius="11,11,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding PencereBasligi}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Cari hesap ve müşteri kartı bilgileri."
                                   FontSize="11" Foreground="#B0FFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="✕"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#B0FFFFFF" FontSize="14" Cursor="Hand"
                            Command="{Binding IptalKomutu}"/>
                </Grid>
            </Border>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Cari Kodu *" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Kod, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Müşteri Türü" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding CariTipi.Ad}" IsReadOnly="True" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{Binding IsKurumsal, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,14">
                        <TextBlock Text="Firma Ünvanı *" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Text="{Binding Unvan, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource FormGirisKutusu}"/>
                    </StackPanel>

                    <Grid Visibility="{Binding IsBireysel, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Adı *" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Soyadı *" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Soyad, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0" Visibility="{Binding IsKurumsal, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Vergi Dairesi" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding VergiDairesi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Visibility="{Binding IsKurumsal, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Vergi Numarası" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding VergiNo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Style="{StaticResource FormGirisKutusu}" MaxLength="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding IsBireysel, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="T.C. Kimlik Numarası" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding TcNo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Style="{StaticResource FormGirisKutusu}" MaxLength="11"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Cep Telefonu" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding CepTelefonu, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="E-posta Adresi" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Eposta, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="İl" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Il, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="İlçe" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Ilce, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Açık Adres" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Text="{Binding Adres, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <CheckBox IsChecked="{Binding Aktif}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Müşteri kartı aktif" FontSize="12" Foreground="{StaticResource TextPrimaryFirca}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="{StaticResource DangerLightFirca}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0"
                            Visibility="{Binding HataMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                        <TextBlock Text="{Binding HataMesaji}" Foreground="{StaticResource DangerDarkFirca}" FontSize="12"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Alt Eylem Düğmeleri -->
            <Border Grid.Row="2" Background="{StaticResource BackgroundFirca}" BorderBrush="{StaticResource BorderFirca}" BorderThickness="0,1,0,0" Padding="16,12" CornerRadius="0,0,11,11">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="İptal" Command="{Binding IptalKomutu}" Style="{StaticResource IkinciDugme}" Width="80" Margin="0,0,8,0"/>
                    <Button Content="{Binding Kaydediliyor, Converter={x:Static yardimci:KaydediliyorMetinDonusturucu.Ornek}}"
                            Command="{Binding KaydetKomutu}" Width="100"
                            Style="{StaticResource BirinciDugme}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
