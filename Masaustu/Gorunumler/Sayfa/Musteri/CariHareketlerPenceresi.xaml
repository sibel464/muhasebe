<Window x:Class="Masaustu.Gorunumler.Sayfa.Musteri.CariHareketlerPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
        Title="Cari Hesap Ekstresi"
        Width="980" Height="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F8FAFC">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
            <yardimci:TersBosBoslukDonusturucu x:Key="TersBosBoslukDonusturucu"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Başlık Barı -->
            <RowDefinition Height="Auto"/> <!-- Özet Kartlar -->
            <RowDefinition Height="*"/>    <!-- Tablo -->
            <RowDefinition Height="Auto"/> <!-- Alt Kapat Butonu -->
        </Grid.RowDefinitions>

        <!-- Başlık Barı -->
        <Border Grid.Row="0" Background="{StaticResource MenuGradient}" Padding="24,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding CariKart.Unvan}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Background="#2AFFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="{Binding CariKart.Kod}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Cari hesap hareket geçmişi ve ekstresi." FontSize="11" Foreground="#B0FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" Content="✕"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#B0FFFFFF" FontSize="16" Cursor="Hand"
                        Click="Kapat_Click" VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- Özet Kartlar -->
        <Grid Grid.Row="1" Margin="24,16,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Toplam Borç -->
            <Border Grid.Column="0" Style="{StaticResource KpiKarti}" Margin="0,0,12,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="TOPLAM BORÇ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}"/>
                    <TextBlock Text="{Binding ToplamBorc, StringFormat='{}{0:N2} ₺'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerDarkFirca}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Toplam Alacak -->
            <Border Grid.Column="1" Style="{StaticResource KpiKarti}" Margin="0,0,12,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="TOPLAM ALACAK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}"/>
                    <TextBlock Text="{Binding ToplamAlacak, StringFormat='{}{0:N2} ₺'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessDarkFirca}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Bakiye -->
            <Border Grid.Column="2" Style="{StaticResource KpiKarti}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="NET BAKİYE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding MutlakBakiye, StringFormat='{}{0:N2} ₺'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                        <TextBlock Text="{Binding BakiyeTuru, StringFormat=' ({0})'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Hareketler Tablosu -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Margin="24,0,24,12"
                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Hareketler}"
                      Style="{StaticResource ModernDataGrid}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat='dd.MM.yyyy HH:mm'}" Width="130"/>
                    <DataGridTextColumn Header="BELGE NO" Binding="{Binding BelgeNo}" Width="135"/>
                    <DataGridTextColumn Header="İŞLEM TÜRÜ" Binding="{Binding HareketTuruMetni}" Width="120"/>
                    <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="*"/>
                    
                    <DataGridTextColumn Header="BORÇ (TL)" Binding="{Binding Borc, StringFormat='{}{0:N2} ₺'}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="{StaticResource DangerDarkFirca}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="ALACAK (TL)" Binding="{Binding Alacak, StringFormat='{}{0:N2} ₺'}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="{StaticResource SuccessDarkFirca}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="BAKİYE (TL)" Binding="{Binding Bakiye, StringFormat='{}{0:N2} ₺'}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Alt Kapat Butonu -->
        <Border Grid.Row="3" Background="White" Padding="24,12" BorderBrush="{StaticResource BorderFirca}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Click="Kapat_Click" Style="{StaticResource BirinciDugme}" Width="110">
                    <TextBlock Text="Kapat"/>
                </Button>
                <Button DockPanel.Dock="Left" Command="{Binding EkstreYazdirKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,16,0">
                    <TextBlock Text="🖨️ Ekstre Yazdır"/>
                </Button>
                <TextBlock DockPanel.Dock="Left" Text="Mutabakat tarihi:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryFirca}"/>
                <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding MutabakatTarihi}" Width="120" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <CheckBox DockPanel.Dock="Left" Content="Ba-Bs ekle" IsChecked="{Binding BaBsEkle}" VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="Mutabakat tarihinin ayına ait alış/satış fatura toplamlarını (Form Ba-Bs) mektuba ekler"/>
                <Button DockPanel.Dock="Left" Command="{Binding MutabakatYazdirKomutu}" Style="{StaticResource IkinciDugme}">
                    <TextBlock Text="✉️ Mutabakat Mektubu"/>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Window>
