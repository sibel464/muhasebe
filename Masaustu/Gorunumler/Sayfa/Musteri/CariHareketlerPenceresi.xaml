<Window x:Class="Masaustu.Gorunumler.Sayfa.Musteri.CariHareketlerPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
        Title="Cari Hesap Ekstresi"
        Width="880" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
            <yardimci:TersBosBoslukDonusturucu x:Key="TersBosBoslukDonusturucu"/>
            
            <!-- DataGrid Stil -->
            <Style x:Key="EkstreDataGrid" TargetType="DataGrid">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
                <Setter Property="RowHeight" Value="40"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#374151"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="ColumnHeaderStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F9FAFB"/>
                            <Setter Property="Foreground" Value="#6B7280"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="#F4F6FA" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000" BlurRadius="25" ShadowDepth="4" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık Barı -->
            <Border Grid.Row="0" Background="{StaticResource MenuGradient}" Padding="24,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding CariKart.Unvan}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="#2AFFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="{Binding CariKart.Kod}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Cari hesap hareket geçmişi ve ekstresi." FontSize="11" Foreground="#B0FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="✕"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#B0FFFFFF" FontSize="16" Cursor="Hand"
                            Click="Kapat_Click" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Özet Kartlar -->
            <Grid Grid.Row="1" Margin="24,20,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Toplam Borç -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000" BlurRadius="6" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Toplam Borç" FontSize="11" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding ToplamBorc, StringFormat='{}{0:N2} ₺'}" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Toplam Alacak -->
                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000" BlurRadius="6" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Toplam Alacak" FontSize="11" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding ToplamAlacak, StringFormat='{}{0:N2} ₺'}" FontSize="20" FontWeight="Bold" Foreground="#065F46" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Bakiye -->
                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#000" BlurRadius="6" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Net Bakiye" FontSize="11" Foreground="#6B7280"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding MutlakBakiye, StringFormat='{}{0:N2} ₺'}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#374151"/>
                                            <Style.Triggers>
                                                <!-- Borçlu ise (Mavi/Kırmızı) -->
                                                <DataTrigger Binding="{Binding BakiyeTuru}" Value="B">
                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                </DataTrigger>
                                                <!-- Alacaklı ise (Yeşil) -->
                                                <DataTrigger Binding="{Binding BakiyeTuru}" Value="A">
                                                    <Setter Property="Foreground" Value="#059669"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border CornerRadius="4" Padding="4,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BakiyeTuru}" Value="B">
                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BakiyeTuru}" Value="A">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Sıfır"/>
                                                <Setter Property="Foreground" Value="#4B5563"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BakiyeTuru}" Value="B">
                                                        <Setter Property="Text" Value="(B) Borçlu"/>
                                                        <Setter Property="Foreground" Value="#1E40AF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BakiyeTuru}" Value="A">
                                                        <Setter Property="Text" Value="(A) Alacaklı"/>
                                                        <Setter Property="Foreground" Value="#065F46"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Ekstre Tablosu -->
            <Border Grid.Row="2" Margin="24,0,24,0" Background="White" CornerRadius="10" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <!-- Yükleniyor Göstergesi -->
                    <Border Background="#80FFFFFF" Visibility="{Binding Yukleniyor, Converter={StaticResource BosBoslukDonusturucu}}" Panel.ZIndex="10">
                        <TextBlock Text="Ekstre hesaplanıyor..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#6B7280"/>
                    </Border>

                    <DataGrid ItemsSource="{Binding Hareketler}" Style="{StaticResource EkstreDataGrid}">
                        <DataGrid.Columns>
                            <!-- Tarih -->
                            <DataGridTextColumn Header="İŞLEM TARİHİ" Binding="{Binding Tarih, StringFormat='{}{0:dd.MM.yyyy}'}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Belge No -->
                            <DataGridTextColumn Header="BELGE NO" Binding="{Binding BelgeNo}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#4B5563"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Tür -->
                            <DataGridTextColumn Header="İŞLEM TÜRÜ" Binding="{Binding HareketTuruMetni}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Açıklama -->
                            <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Borç -->
                            <DataGridTextColumn Header="BORÇ (₺)" Binding="{Binding Borc, StringFormat='{}{0:N2}'}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#1E3A8A"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="0,00">
                                                <Setter Property="Foreground" Value="#D1D5DB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Alacak -->
                            <DataGridTextColumn Header="ALACAK (₺)" Binding="{Binding Alacak, StringFormat='{}{0:N2}'}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#065F46"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="0,00">
                                                <Setter Property="Foreground" Value="#D1D5DB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Bakiye -->
                            <DataGridTextColumn Header="BAKİYE (₺)" Binding="{Binding Bakiye, StringFormat='{}{0:N2}'}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#374151"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Bakiye, Converter={x:Static yardimci:BuyukMuDonusturucu.SifirdanBuyuk}}" Value="True">
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Bakiye, Converter={x:Static yardimci:KucukMuDonusturucu.SifirdanKucuk}}" Value="True">
                                                <Setter Property="Foreground" Value="#059669"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Kapat butonu barı -->
            <Border Grid.Row="3" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="24,16" Margin="0,16,0,0">
                <Grid>
                    <TextBlock Text="{Binding DurumMesaji}" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <Button Content="Kapat" Click="Kapat_Click" HorizontalAlignment="Right" Width="90" Height="36" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#374151" FontSize="13" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
