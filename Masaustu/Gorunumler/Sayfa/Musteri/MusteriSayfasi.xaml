<UserControl x:Class="Masaustu.Gorunumler.Sayfa.MusteriSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:yardimcilar="clr-namespace:Masaustu.Yardimcilar"
             xmlns:musteri="clr-namespace:Masaustu.Gorunumler.Sayfa.Musteri"
             xmlns:gm="clr-namespace:Masaustu.GorunumModelleri"
             xmlns:model="clr-namespace:EtkiAlani.Modeller.Cari;assembly=EtkiAlani"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1024"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimcilar:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <DataTemplate DataType="{x:Type gm:MusteriDuzenleGorunumModeli}">
                <musteri:MusteriDuzenleGorunumu/>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/> <!-- Master-Detail Yan Panel -->
        </Grid.ColumnDefinitions>

        <!-- LİSTE ALANI (Master) -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 1. Başlık ve Aksiyonlar -->
                <RowDefinition Height="Auto"/> <!-- 2. KPI / Özet Kartlar -->
                <RowDefinition Height="Auto"/> <!-- 3. Filtre Barı -->
                <RowDefinition Height="*"/>    <!-- 4. DataGrid Listesi -->
                <RowDefinition Height="Auto"/> <!-- 5. Alt Seçili Satır Aksiyonları -->
            </Grid.RowDefinitions>

            <!-- 1. ÜST PANEL: Başlık ve Aksiyon Butonları -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource BaslikIkonKutusu}">
                        <TextBlock Text="👥" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Müşteri &amp; Cari Kart Yönetimi" Style="{StaticResource SayfaBasligi}"/>
                        <TextBlock Text="Kayıtlı müşteri kartları, bakiye durumları ve cari hesap hareketleri." Style="{StaticResource SayfaAltBaslik}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Sağ Üst Aksiyonlar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding ExcelAktarKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0" ToolTip="Müşteri listesini CSV / Excel dosyası olarak aktarır">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Excel'e Aktar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding YenileKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Yenile" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding YeniEkleKomutu}" Style="{StaticResource BirinciDugme}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Yeni Müşteri Ekle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. KPI / ÖZET KARTLAR (FINANSAL & SAYI ÖZETLERİ) -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource KpiKarti}" Margin="0,0,10,0" Padding="14,12">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="TOPLAM MÜŞTERİ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding ToplamMusteri}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}"/>
                                <TextBlock Text="{Binding AktifMusteri, StringFormat='({0} Aktif)'}" FontSize="11" Foreground="{StaticResource SuccessDarkFirca}" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource InfoLightFirca}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource KpiKarti}" Margin="0,0,10,0" Padding="14,12">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="ALACAKLARIMIZ (BORÇ)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}"/>
                            <TextBlock Text="{Binding ToplamBorc, StringFormat='{}{0:N2} ₺'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerDarkFirca}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Width="32" Height="32" CornerRadius="6" Background="#FEE2E2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="📈" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource KpiKarti}" Margin="0,0,10,0" Padding="14,12">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="BORÇLARIMIZ (ALACAK)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}"/>
                            <TextBlock Text="{Binding ToplamAlacak, StringFormat='{}{0:N2} ₺'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessDarkFirca}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource SuccessLightFirca}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="📉" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource KpiKarti}" Padding="14,12">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="NET BAKİYE DURUMU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}"/>
                            <TextBlock Text="{Binding NetBakiye, StringFormat='{}{0:N2} ₺'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkFirca}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Width="32" Height="32" CornerRadius="6" Background="#E0F2FE" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="⚖️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- 3. FİLTRELEME BARI -->
            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                    BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ünvan/Ad Arama -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Ünvan / Ad Soyad Ara" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Style="{StaticResource FiltreKutusu}" Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Kod Arama -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Cari Kodu" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Style="{StaticResource FiltreKutusu}" Text="{Binding AramaKodu, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Şehir Arama -->
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Şehir (İl)" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Style="{StaticResource FiltreKutusu}" Text="{Binding AramaIl, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Cari Tipi Dinamik -->
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="Cari Tipi" Style="{StaticResource EtiketMetin}"/>
                        <ComboBox Style="{StaticResource FiltreAcilirKutu}" 
                                  ItemsSource="{Binding CariTipleri}"
                                  SelectedValue="{Binding AramaCariTipiId, UpdateSourceTrigger=PropertyChanged}" 
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Ad"/>
                    </StackPanel>

                    <!-- Bakiye Durumu -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Bakiye Durumu" Style="{StaticResource EtiketMetin}"/>
                        <ComboBox Style="{StaticResource FiltreAcilirKutu}" SelectedValue="{Binding BakiyeDurumu, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Tümü" Tag="0"/>
                            <ComboBoxItem Content="Borçlu (Bakiyeli)" Tag="1"/>
                            <ComboBoxItem Content="Alacaklı" Tag="2"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. DATAGRID TABLO -->
            <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="0"
                    BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
                  <DataGrid ItemsSource="{Binding Musteriler}" 
                          SelectedItem="{Binding SeciliMusteri, Mode=TwoWay}"
                          MouseDoubleClick="DataGrid_DoubleClick"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="🔍 Cari 360° Detay" Command="{Binding DataContext.DetayKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="📜 Hesap Ekstresi" Command="{Binding DataContext.EkstreKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="💵 Tahsilat / Ödeme Yap" Command="{Binding DataContext.TahsilatKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="✏️ Cari Kartı Düzenle" Command="{Binding DataContext.DuzenleKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="🗑️ Sil (Pasife Al)" Command="{Binding DataContext.SilKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CARİ KODU" Binding="{Binding Kod}" Width="120" FontWeight="SemiBold"/>
                        <DataGridTemplateColumn Header="ÜNVAN / AD SOYAD" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Unvan}" 
                                               Foreground="#1E40AF" 
                                               FontWeight="Bold" 
                                               Cursor="Hand" 
                                               VerticalAlignment="Center"
                                               ToolTip="İşlem geçmişini görüntülemek için tıklayın">
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding DataContext.DetayKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                          CommandParameter="{Binding}"/>
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="TİP" Binding="{Binding CariTipi.Ad}" Width="130"/>
                        <DataGridTextColumn Header="TELEFON" Binding="{Binding Telefon}" Width="120"/>
                        <DataGridTextColumn Header="ŞEHİR" Binding="{Binding Il}" Width="100"/>
                        <DataGridTextColumn Header="BORÇ (TL)" Binding="{Binding Borc, StringFormat='{}{0:N2} ₺'}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="{StaticResource DangerDarkFirca}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ALACAK (TL)" Binding="{Binding Alacak, StringFormat='{}{0:N2} ₺'}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="{StaticResource SuccessDarkFirca}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="BAKİYE (TL)" Binding="{Binding Bakiye, StringFormat='{}{0:N2} ₺'}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="DURUM" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Aktif}" Value="False">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✅ Aktif"/>
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Aktif}" Value="False">
                                                            <Setter Property="Text" Value="⏸️ Pasif"/>
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="İŞLEM" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Görüntüle" Command="{Binding DataContext.DetayKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MikroSilDugme}" Width="90"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 5. ALT SEÇİLİ SATIR AKSİYON BARI -->
            <Border Grid.Row="4" Background="White" CornerRadius="10" Padding="14,10" Margin="0,12,0,0"
                    BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Seçili Cari:" FontSize="13" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SeciliMusteri.Unvan}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding DetayKomutu}" Style="{StaticResource BirinciDugme}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↗" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cari Detay" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EkstreKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📜" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hesap Ekstresi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding TahsilatKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💵" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tahsilat / Ödeme" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding DuzenleKomutu}" Style="{StaticResource BirinciDugme}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✏️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Düzenle" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SilKomutu}" Style="{StaticResource TehlikeliDugme}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sil" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- MASTER-DETAIL DÜZENLEME PANELİ -->
        <Border Grid.Column="1" Width="360" Background="White" CornerRadius="12" Padding="20" Margin="16,0,0,0"
                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1"
                Visibility="{Binding FormAcik, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl Content="{Binding FormGorunumModeli}"/>
        </Border>
    </Grid>
</UserControl>
