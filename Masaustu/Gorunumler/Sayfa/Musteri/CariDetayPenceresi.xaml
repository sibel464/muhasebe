<Window x:Class="Masaustu.Gorunumler.Sayfa.Musteri.CariDetayPenceresi"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Cari Hesap Merkezi" Width="1280" Height="720" MinWidth="1050" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#F3F6FA" Language="tr-TR">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Vis"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="MinHeight" Value="28"/>
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#16385E"/><Setter Property="BorderBrush" Value="#CCD7E4"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E7EFF8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EDF2F8"/><Setter Property="Foreground" Value="#34465E"/><Setter Property="Padding" Value="8,7"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="#DDE5EF"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserSortColumns" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="30"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EEF2F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="White"/></Style>
 </Window.Resources>
 <Grid MaxWidth="1680" Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0">
   <DockPanel Margin="0,0,0,8"><Button Content="← Cari Hesaplar" Command="{Binding KapatKomutu}" DockPanel.Dock="Left"/><TextBlock Text="CARİ HESAP DETAYI" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0"/></DockPanel>
   <DockPanel Margin="0,0,0,8">
    <StackPanel DockPanel.Dock="Left" MinWidth="250"><TextBlock Text="{Binding GenelBilgi.Baslik}" FontSize="21" FontWeight="Bold" Foreground="#142C50"/>
     <TextBlock Foreground="#64748B"><Run Text="{Binding GenelBilgi.Kod}"/><Run Text="  •  "/><Run Text="{Binding GenelBilgi.CariTipi}"/><Run Text="  •  "/><Run Text="{Binding GenelBilgi.GrupKodu}"/><Run Text="  •  "/><Run Text="{Binding GenelBilgi.Durum}"/></TextBlock>
     <TextBlock Foreground="#64748B" FontSize="11"><Run Text="{Binding GenelBilgi.Firma}"/><Run Text=" / "/><Run Text="{Binding GenelBilgi.Sube}"/></TextBlock>
    </StackPanel>
    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button Content="Düzenle" Command="{Binding DuzenleKomutu}" Visibility="{Binding Duzenleyebilir, Converter={StaticResource Vis}}"/><Button Content="Yeni Satış" Command="{Binding YeniSatisKomutu}" Visibility="{Binding SatisYapabilir, Converter={StaticResource Vis}}"/><Button Content="Yeni Fatura" Command="{Binding YeniFaturaKomutu}" Visibility="{Binding FaturaOlusturabilir, Converter={StaticResource Vis}}"/><Button Content="Tahsilat" Command="{Binding YeniTahsilatKomutu}" Visibility="{Binding TahsilatYapabilir, Converter={StaticResource Vis}}"/><Button Content="Ödeme" Command="{Binding YeniOdemeKomutu}" Visibility="{Binding OdemeYapabilir, Converter={StaticResource Vis}}"/><Button Content="Sipariş" Command="{Binding YeniSiparisKomutu}" Visibility="{Binding SiparisOlusturabilir, Converter={StaticResource Vis}}"/><Button Content="Cari Fiş" Command="{Binding CariFisKomutu}" Visibility="{Binding Duzenleyebilir, Converter={StaticResource Vis}}"/>
    </WrapPanel>
   </DockPanel>
  </StackPanel>
  <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,10">
   <Border BorderBrush="#DCE3EC" BorderThickness="1" Padding="10,7" Margin="0,0,6,0" CornerRadius="5"><StackPanel><TextBlock Text="Güncel Bakiye" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding FinansOzet.MutlakBakiye, StringFormat={}{0:N2} ₺}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding FinansOzet.BakiyeYonu}" FontSize="10"/></StackPanel></Border>
   <Border BorderBrush="#DCE3EC" BorderThickness="1" Padding="10,7" Margin="0,0,6,0" CornerRadius="5"><StackPanel><TextBlock Text="Toplam Borç" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding FinansOzet.ToplamBorc, StringFormat={}{0:N2} ₺, TargetNullValue=—}" FontSize="16" FontWeight="SemiBold" Foreground="#142C50"/></StackPanel></Border><Border BorderBrush="#DCE3EC" BorderThickness="1" Padding="10,7" Margin="0,0,6,0" CornerRadius="5"><StackPanel><TextBlock Text="Toplam Alacak" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding FinansOzet.ToplamAlacak, StringFormat={}{0:N2} ₺, TargetNullValue=—}" FontSize="16" FontWeight="SemiBold" Foreground="#142C50"/></StackPanel></Border>
   <Border BorderBrush="#DCE3EC" BorderThickness="1" Padding="10,7" Margin="0,0,6,0" CornerRadius="5"><StackPanel><TextBlock Text="Açık Fatura" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding FinansOzet.AcikFaturaSayisi, TargetNullValue=—}" FontSize="16" FontWeight="SemiBold" Foreground="#142C50"/></StackPanel></Border><Border BorderBrush="#DCE3EC" BorderThickness="1" Padding="10,7" Margin="0,0,6,0" CornerRadius="5"><StackPanel><TextBlock Text="Vadesi Geçmiş Alacak" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding FinansOzet.VadesiGecmis, StringFormat={}{0:N2} ₺, TargetNullValue=—}" FontSize="16" FontWeight="SemiBold" Foreground="#142C50"/></StackPanel></Border>
   <Border BorderBrush="#DCE3EC" BorderThickness="1" Padding="10,7" Margin="0,0,6,0" CornerRadius="5"><StackPanel><TextBlock Text="Kullanılan Risk" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding FinansOzet.KullanilanRisk, StringFormat={}{0:N2} ₺, TargetNullValue=—}" FontSize="16" FontWeight="SemiBold" Foreground="#142C50"/></StackPanel></Border><Border BorderBrush="#DCE3EC" BorderThickness="1" Padding="10,7" Margin="0,0,6,0" CornerRadius="5"><StackPanel><TextBlock Text="Son Finansal İşlem" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding FinansOzet.SonIslemTarihi, StringFormat=dd.MM.yyyy, TargetNullValue=—}" FontSize="16" FontWeight="SemiBold" Foreground="#142C50"/></StackPanel></Border>
  </UniformGrid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="156"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox ItemsSource="{Binding Sekmeler}" SelectedItem="{Binding SeciliSekme}" DisplayMemberPath="Ad" Background="#142C50" Foreground="White" BorderThickness="0" Padding="4" Margin="0,0,10,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,8"/><Setter Property="Margin" Value="0,1"/></Style></ListBox.ItemContainerStyle>
   </ListBox>
   <Grid Grid.Column="1" Background="White">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Margin="8,6">
     <StackPanel Margin="0,0,5,0"><TextBlock Text="Başlangıç" FontSize="10"/><DatePicker SelectedDate="{Binding Baslangic}" Width="114"/></StackPanel>
     <StackPanel Margin="0,0,5,0"><TextBlock Text="Bitiş" FontSize="10"/><DatePicker SelectedDate="{Binding Bitis}" Width="114"/></StackPanel>
     <StackPanel Margin="0,0,5,0"><TextBlock Text="Belge No" FontSize="10"/><TextBox Text="{Binding BelgeNo}" Width="104"/></StackPanel>
     <StackPanel Margin="0,0,5,0"><TextBlock Text="İşlem Türü" FontSize="10"/><ComboBox ItemsSource="{Binding TurSecenekleri}" DisplayMemberPath="Ad" SelectedValuePath="Deger" SelectedValue="{Binding Tur}" Width="120"/></StackPanel>
     <StackPanel Margin="0,0,5,0"><TextBlock Text="Borç / Alacak" FontSize="10"/><ComboBox IsEnabled="{Binding EkstreAcik}" ItemsSource="{Binding Yonler}" DisplayMemberPath="Ad" SelectedValuePath="Deger" SelectedValue="{Binding Yon}" Width="90"/></StackPanel>
     <StackPanel Margin="0,0,5,0"><TextBlock Text="Durum" FontSize="10"/><ComboBox ItemsSource="{Binding Durumlar}" DisplayMemberPath="Ad" SelectedValuePath="Deger" SelectedValue="{Binding Durum}" Width="105"/></StackPanel>
     <StackPanel Margin="0,0,5,0"><TextBlock Text="Para Birimi" FontSize="10"/><ComboBox ItemsSource="{Binding ParaBirimleri}" DisplayMemberPath="Ad" SelectedValuePath="Id" SelectedValue="{Binding ParaBirimiId}" Width="80"/></StackPanel><Button Content="Filtrele" Command="{Binding FiltreleKomutu}" VerticalAlignment="Bottom"/><Button Content="Temizle" Command="{Binding TemizleKomutu}" VerticalAlignment="Bottom"/>
    </WrapPanel>
    <ScrollViewer Grid.Row="1" MaxHeight="180" VerticalScrollBarVisibility="Auto" Visibility="{Binding GenelAcik, Converter={StaticResource Vis}}">
     <UniformGrid Columns="4" Margin="12,5">
      <StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Cari Kodu" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Kod, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Cari Tipi" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.CariTipi, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Grup Kodu" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.GrupKodu, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Ad" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Ad, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Soyad" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Soyad, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Firma Ünvanı" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.FirmaUnvani, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Yetkili Kişi" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.YetkiliKisi, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel></StackPanel>
      <StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="TCKN" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Tckn, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="VKN" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Vkn, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Vergi Dairesi" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.VergiDairesi, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Telefon" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Telefon, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Telefon 2" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Telefon2, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Cep Telefonu" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.CepTelefonu, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="E-posta" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Eposta, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel></StackPanel>
      <StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="İl" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Il, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="İlçe" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Ilce, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Açık Adres" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.AcikAdres, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="IBAN" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Iban, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Risk Limiti" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.RiskLimiti, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Varsayılan Vade (Gün)" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.VadeGunu, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel></StackPanel>
      <StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Açıklama" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Aciklama, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Oluşturma Tarihi" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.OlusturmaTarihi, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><TextBlock Text="Son işlemler aşağıdadır." TextWrapping="Wrap" Foreground="#64748B"/></StackPanel>
     </UniformGrid>
    </ScrollViewer>
    <WrapPanel Grid.Row="1" Margin="10" Visibility="{Binding SistemAcik, Converter={StaticResource Vis}}">
     <StackPanel Margin="0,0,18,8"><TextBlock Text="Oluşturan" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Olusturan, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Oluşturma Tarihi" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.OlusturmaTarihi, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Son Güncelleyen" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Guncelleyen, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Son Güncelleme" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.GuncellemeTarihi, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Durum" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Durum, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Firma" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Firma, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Şube" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding GenelBilgi.Sube, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel>
    </WrapPanel>
    <ScrollViewer Grid.Row="1" MaxHeight="150" VerticalScrollBarVisibility="Auto" Visibility="{Binding RiskAcik, Converter={StaticResource Vis}}">
     <StackPanel Margin="8"><WrapPanel>
      <StackPanel Margin="0,0,18,8"><TextBlock Text="Risk Limiti" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding FinansOzet.RiskLimiti, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Kalan Risk" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding FinansOzet.KalanRisk, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Vadesi Gelmemiş" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding Risk.VadesiGelmemis, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="1–30 Gün" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding Risk.Gun1_30, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="31–60 Gün" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding Risk.Gun31_60, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="61–90 Gün" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding Risk.Gun61_90, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="90+ Gün" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding Risk.Gun90Ustu, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Vadesiz Alacak" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding Risk.Vadesiz, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Gecikmiş Alış Borcu" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding Risk.VadesiGecmisBorc, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Ort. Tahsilat Günü" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding Risk.OrtalamaTahsilatGunu, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="Ort. Ödeme Günü" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding Risk.OrtalamaOdemeGunu, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel><StackPanel Margin="0,0,18,8"><TextBlock Text="En Eski Açık Belge" Foreground="#64748B" FontSize="11"/><TextBlock Text="{Binding Risk.EnEskiAcikBelge, TargetNullValue=—}" TextWrapping="Wrap"/></StackPanel>
     </WrapPanel><TextBlock Text="{Binding Risk.Aciklama}" TextWrapping="Wrap" Foreground="#64748B" FontSize="11"/></StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Margin="10" Visibility="{Binding NotlarAcik, Converter={StaticResource Vis}}">
     <TextBlock Text="Başlık"/><TextBox Text="{Binding NotBasligi}" MaxLength="150"/><TextBlock Text="Not"/><TextBox Text="{Binding NotMetni}" MaxLength="4000" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
     <Button Content="+ Not Ekle" Command="{Binding NotEkleKomutu}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
    </StackPanel>
    <DockPanel Grid.Row="2" Margin="8,0,8,5"><CheckBox Content="Ürün bazlı fiyat geçmişi" IsChecked="{Binding UrunGecmisi}" Visibility="{Binding UrunSecimiAcik, Converter={StaticResource Vis}}"/><TextBlock Text="{Binding Bilgi}" TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="8,0"/></DockPanel>
    <ProgressBar Grid.Row="3" Height="3" IsIndeterminate="True" Visibility="{Binding Yukleniyor, Converter={StaticResource Vis}}"/>
    <Grid Grid.Row="4">
     <DataGrid x:Name="KayitTablosu" ItemsSource="{Binding Satirlar}" MouseDoubleClick="BelgeCiftTik"/>
     <DataGrid x:Name="UrunTablosu" ItemsSource="{Binding Urunler}" Visibility="{Binding UrunGecmisi, Converter={StaticResource Vis}}">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding UrunKodu}"/><DataGridTextColumn Header="Ürün" Binding="{Binding UrunAdi}" Width="*"/>
       <DataGridTextColumn Header="Satılan" Binding="{Binding SatilanMiktar}"/><DataGridTextColumn Header="Alınan" Binding="{Binding AlinanMiktar}"/>
       <DataGridTextColumn Header="Son İşlem" Binding="{Binding SonIslemTarihi, StringFormat=dd.MM.yyyy}"/>
       <DataGridTextColumn Header="Son Fiyat" Binding="{Binding SonFiyat, StringFormat=N2}"/><DataGridTextColumn Header="Ort. Fiyat" Binding="{Binding OrtalamaFiyat, StringFormat=N2}"/>
       <DataGridTextColumn Header="Satış Cirosu" Binding="{Binding SatilanTutar, StringFormat=N2}"/><DataGridTextColumn Header="Alış Toplamı" Binding="{Binding AlinanTutar, StringFormat=N2}"/><DataGridTextColumn Header="Döviz" Binding="{Binding ParaBirimi}"/>
      </DataGrid.Columns>
     </DataGrid>
     <Border Background="#F8FAFC" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20" Visibility="{Binding Bos, Converter={StaticResource Vis}}"><TextBlock Text="{Binding BosMesaji}" Foreground="#64748B"/></Border>
    </Grid>
    <DockPanel Grid.Row="5" Margin="8"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Önceki" Command="{Binding OncekiKomutu}"/><TextBlock Text="{Binding SayfaMetni}" VerticalAlignment="Center" Margin="5,0,10,0"/><Button Content="Sonraki" Command="{Binding SonrakiKomutu}"/><ComboBox ItemsSource="{Binding Boyutlar}" SelectedItem="{Binding SayfaBoyutu}" Width="55"/></StackPanel><CheckBox Content="İptal edilenleri göster" IsChecked="{Binding IptalleriGoster}" VerticalAlignment="Center"/></DockPanel>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,8,0,0"><Button Content="Yenile" Command="{Binding YenileKomutu}" DockPanel.Dock="Right"/><TextBlock Text="{Binding DurumMesaji}" Foreground="#475569" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>