<UserControl x:Class="Masaustu.Gorunumler.Sayfa.ProfesyonelSatisSayfasi"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720" Background="#F4F6FA" Focusable="True">
 <UserControl.InputBindings>
  <KeyBinding Key="F2" Command="{Binding UrunAraKomutu}"/><KeyBinding Key="F3" Command="{Binding CariSecKomutu}"/><KeyBinding Key="F4" Command="{Binding StokDagilimiAcKomutu}"/><KeyBinding Key="F5" Command="{Binding SatisiBekletKomutu}"/><KeyBinding Key="F6" Command="{Binding BekleyenSatisGetirKomutu}"/><KeyBinding Key="F8" Command="{Binding SatirSilKomutu}"/><KeyBinding Key="F9" Command="{Binding OdemeEkraniAcKomutu}"/><KeyBinding Key="F10" Command="{Binding SatisTamamlaKomutu}"/><KeyBinding Key="Escape" Command="{Binding IptalKomutu}"/><KeyBinding Key="F11" Command="{Binding SonFisiYazdirKomutu}"/>
 </UserControl.InputBindings>
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  <Style x:Key="ToolButton" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#334155"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="PayChoice" TargetType="RadioButton"><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,0,5,6"/><Setter Property="Background" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#E8F0FF"/><Setter TargetName="b" Property="BorderBrush" Value="#2563EB"/><Setter Property="Foreground" Value="#1D4ED8"/><Setter Property="FontWeight" Value="Bold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EEF2F7"/><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="35"/><Setter Property="Padding" Value="6,0"/><Setter Property="BorderBrush" Value="#DCE3ED"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172033"/><Style.Triggers><Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#FAFBFD"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF1FB"/><Setter Property="Foreground" Value="#172033"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderBrush" Value="#E8EDF3"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="5,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
 </UserControl.Resources>
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid><TextBox x:Name="txtBarkod" Text="{Binding Barkod,UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="11,7" FontSize="15" VerticalContentAlignment="Center" KeyDown="Barkod_KeyDown"/><TextBlock Text="Barkod okutun veya ürün kodu yazın..." Foreground="#94A3B8" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Barkod}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
   <Button Grid.Column="1" Content="Ürün Ara  F2" Command="{Binding UrunAraKomutu}" Style="{StaticResource ToolButton}"/><StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0"><TextBlock Text="Miktar" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,5,0"/><TextBox Text="{Binding HizliMiktar}" Width="52" Height="38" TextAlignment="Center" VerticalContentAlignment="Center"/></StackPanel>
  </Grid></Border>
  <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><RadioButton Content="Hızlı Satış" IsChecked="{Binding HizliSatisMi,Mode=OneWay}" GroupName="SatisTuru" Checked="HizliSatis_Checked" Margin="0,0,14,0" FontWeight="SemiBold"/><RadioButton Content="Cari Satış" IsChecked="{Binding CariSatisMi,Mode=OneWay}" GroupName="SatisTuru" Checked="CariSatis_Checked" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DurumMesaji}" Foreground="#1E40AF" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Cari F3" Command="{Binding CariSecKomutu}" Style="{StaticResource ToolButton}"/><Button Content="Beklet F5" Command="{Binding SatisiBekletKomutu}" Style="{StaticResource ToolButton}"/><Button Content="Bekleyen F6" Command="{Binding BekleyenSatisGetirKomutu}" Style="{StaticResource ToolButton}"/><Button Content="Son Fiş F11" Command="{Binding SonFisiYazdirKomutu}" Style="{StaticResource ToolButton}" ToolTip="Son satışın bilgi fişini yazdırır (yazıcı seçilir)"/><CheckBox Content="Satıştan sonra fiş yazdır" IsChecked="{Binding SatistanSonraFisYazdir}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="İşaretliyse her satıştan sonra bu bilgisayarın varsayılan yazıcısına 80 mm bilgi fişi basılır"/></StackPanel></Grid></Border>
  <Border Grid.Row="2" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="6"><Grid>
   <DataGrid ItemsSource="{Binding Sepet}" SelectedItem="{Binding SeciliKalem}" AutoGenerateColumns="False" CanUserAddRows="False" AlternationCount="2" RowHeight="43" GridLinesVisibility="All" BorderThickness="0" SelectionMode="Single" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
    <DataGridTextColumn Header="#" Binding="{Binding SiraNo}" Width="34" IsReadOnly="True"/><DataGridTextColumn Header="Kod" Binding="{Binding Kod}" Width="86" IsReadOnly="True"/><DataGridTextColumn Header="Barkod" Binding="{Binding Barkod}" Width="105" IsReadOnly="True"/><DataGridTextColumn Header="Ürün Adı" Binding="{Binding Ad}" Width="2*" MinWidth="140" IsReadOnly="True"/><DataGridTextColumn Header="Brm." Binding="{Binding Birim}" Width="48" IsReadOnly="True"/>
    <DataGridTemplateColumn Header="Miktar" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding MiktarMetni,UpdateSourceTrigger=PropertyChanged,TargetNullValue='',FallbackValue=''}" TextAlignment="Center" Height="27" VerticalContentAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="B.Fiyat (KDV hariç)" Binding="{Binding BirimFiyatMetni,TargetNullValue='',FallbackValue=''}" Width="85"/><DataGridTextColumn Header="KDV %" Binding="{Binding KdvOraniMetni,TargetNullValue='',FallbackValue=''}" Width="55"/><DataGridTextColumn Header="İsk. %" Binding="{Binding IskontoOraniMetni,TargetNullValue='',FallbackValue=''}" Width="58"/><DataGridTextColumn Header="KDV" Binding="{Binding KdvTutari,StringFormat=N2}" Width="72" IsReadOnly="True"/><DataGridTextColumn Header="Toplam (KDV dahil)" Binding="{Binding SatirToplami,StringFormat=N2}" Width="90" IsReadOnly="True"/>
    <DataGridTemplateColumn Header="Stok Kaynağı" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StokDagilimiOzeti}" TextWrapping="Wrap" FontSize="11" Foreground="#475569"/><Button Grid.Column="1" Content="Düzenle" Command="{Binding DataContext.StokDagilimiAcKomutu,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="5,2" Margin="4,0,0,0"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="✕" Command="{Binding DataContext.SatirSilKomutu,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FEF2F2" Foreground="#B91C1C" BorderBrush="#FECACA" Width="27" Height="26"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns></DataGrid>
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding SepetBos,Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Henüz ürün eklenmedi" FontSize="19" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/><TextBlock Text="Barkod okutun veya F2 ile ürün arayın." Foreground="#94A3B8" Margin="0,5,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="3" Height="150" Margin="0,7,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width=".9*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,0,6,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="MÜŞTERİ / SATIŞ" Foreground="#64748B" FontSize="11" FontWeight="Bold"/><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="{Binding SeciliCariAd}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SeciliCariKodu,StringFormat='Cari Kod: {0}'}" Foreground="#64748B"/><TextBlock Text="{Binding MevcutBakiye,StringFormat='Bakiye: {0:N2} ₺'}" Visibility="{Binding CariBilgiGoster}"/></StackPanel><Button Grid.Row="2" Content="Değiştir  F3" Command="{Binding CariSecKomutu}" HorizontalAlignment="Left" Padding="10,4"/></Grid></Border>
   <Border Grid.Column="1" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,0,6,0"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Ara Toplam" Foreground="#64748B"/><TextBlock HorizontalAlignment="Right" Text="{Binding AraToplam,StringFormat={}{0:N2} ₺}"/><TextBlock Grid.Row="1" Text="İskonto" Foreground="#64748B"/><TextBlock Grid.Row="1" HorizontalAlignment="Right" Text="{Binding SatirIskontosuToplam,StringFormat={}{0:N2} ₺}"/><TextBlock Grid.Row="2" Text="KDV" Foreground="#64748B"/><TextBlock Grid.Row="2" HorizontalAlignment="Right" Text="{Binding KdvToplami,StringFormat={}{0:N2} ₺}"/><Border Grid.Row="3" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="0,6,0,0"><Grid><TextBlock Text="GENEL TOPLAM" FontWeight="Bold"/><TextBlock HorizontalAlignment="Right" Text="{Binding GenelToplam,StringFormat={}{0:N2} ₺}" FontSize="20" FontWeight="Bold" Foreground="#1D4ED8"/></Grid></Border></Grid></Border>
   <Border Grid.Column="2" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="6" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="ÖDEME YÖNTEMİ" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/><UniformGrid Grid.Row="1" Columns="4"><RadioButton Content="Nakit" GroupName="Odeme" IsChecked="True" Command="{Binding OdemeYontemiSecKomutu}" CommandParameter="Nakit" Style="{StaticResource PayChoice}"/><RadioButton Content="Kredi Kartı" GroupName="Odeme" Command="{Binding OdemeYontemiSecKomutu}" CommandParameter="Kredi Kartı" Style="{StaticResource PayChoice}"/><RadioButton Content="Banka" GroupName="Odeme" Command="{Binding OdemeYontemiSecKomutu}" CommandParameter="Banka" Style="{StaticResource PayChoice}"/><RadioButton Content="Açık Hesap" GroupName="Odeme" Command="{Binding OdemeYontemiSecKomutu}" CommandParameter="Açık Hesap" Style="{StaticResource PayChoice}"/></UniformGrid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Taksit" Foreground="#64748B" FontSize="11"/><ComboBox ItemsSource="{Binding TaksitSecenekleri}" SelectedItem="{Binding SeciliTaksit}" IsEnabled="{Binding TaksitAlaniAktif}" Height="33" Margin="0,3,8,0"/></StackPanel><Button Grid.Column="1" Content="SATIŞI TAMAMLA  F10" Command="{Binding SatisTamamlaKomutu}" Background="#166534" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="14" Margin="0,3,0,0"/></Grid></Grid></Border>
  </Grid>
  <Border Grid.Row="4" Background="#E9EDF3" CornerRadius="4" Padding="8,5"><TextBlock HorizontalAlignment="Center" Foreground="#475569" FontSize="11" Text="F2 Ürün Ara   •   F3 Cari Seç   •   F4 Stok Dağılımı   •   F5 Beklet   •   F6 Bekleyenler   •   F8 Satır Sil   •   F9 Ödeme   •   F10 Satışı Tamamla   •   ESC İptal"/></Border>
 </Grid>
</UserControl>
