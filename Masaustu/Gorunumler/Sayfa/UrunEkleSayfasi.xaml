<UserControl x:Class="Masaustu.Gorunumler.Sayfa.UrunEkleSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
             Language="tr-TR"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <yardimci:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. ÜST PANEL: Başlık -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource BaslikIkonKutusu}">
                    <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SayfaBasligi}" Style="{StaticResource SayfaBasligi}"/>
                    <TextBlock Text="{Binding SayfaAltBasligi}" Style="{StaticResource SayfaAltBaslik}"/>
                </StackPanel>
            </StackPanel>
            <Button Command="{Binding YeniUrunKomutu}" Style="{StaticResource IkinciDugme}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    ToolTip="Formu temizleyip yeni bir ürün kaydına başlar">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➕" Margin="0,0,6,0"/>
                    <TextBlock Text="Yeni Ürün"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. FORM ALANI -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="24"
                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                    
                    <TextBlock Text="Temel Ürün Bilgileri" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}" Margin="0,0,0,14"/>
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="Barkod ile Ürün Bul" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding BarkodArama, UpdateSourceTrigger=PropertyChanged}" KeyDown="BarkodArama_KeyDown" Style="{StaticResource FormGirisKutusu}"/><Button Grid.Column="2" Content="Ara" Command="{Binding BarkodAraKomutu}" Margin="8,0,0,0"/></Grid>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Ürün Kodu *" Style="{StaticResource EtiketMetin}"/>
                                <ComboBox ItemsSource="{Binding KodlamaSecenekleri}" SelectedItem="{Binding Kodlama}" Width="95" Margin="8,0,0,0"/>
                                <Button Content="+" Command="{Binding KodEkleKomutu}" Click="KodEkle_Click" Width="30" Margin="4,0,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="KodKutusu" ItemsSource="{Binding KullanilanKodlar}" Text="{Binding Kod, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsReadOnly="{Binding KodSaltOkunur}" Style="{StaticResource FormAcilirKutu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Barkod" Style="{StaticResource EtiketMetin}"/>
                                <ComboBox ItemsSource="{Binding KodlamaSecenekleri}" SelectedItem="{Binding BarkodKodlama}" Width="95" Margin="8,0,0,0"/>
                                <Button Content="+" Command="{Binding BarkodEkleKomutu}" Click="BarkodEkle_Click" Width="30" Margin="4,0,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="BarkodKutusu" ItemsSource="{Binding KullanilanBarkodlar}" Text="{Binding Barkod, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsReadOnly="{Binding BarkodSaltOkunur}" Style="{StaticResource FormAcilirKutu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ölçü Birimi *" Style="{StaticResource EtiketMetin}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Birimler}" SelectedItem="{Binding SeciliBirim}" Style="{StaticResource FormAcilirKutu}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding Kod, Mode=OneWay}" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <Run Text=" - " Foreground="#94A3B8"/>
                                                <Run Text="{Binding Ad, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="+" Tag="BIRIM" Click="TanimYonet_Click" Margin="4,0,0,0" ToolTip="Birimleri yönet"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Ürün Adı *" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="440"/>
                            <ColumnDefinition Width="440"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Kategori" Style="{StaticResource EtiketMetin}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Kategoriler}" SelectedItem="{Binding SeciliKategori}" TextSearch.TextPath="Ad" IsEditable="True" IsTextSearchEnabled="False" Text="{Binding KategoriAramaMetni, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormAcilirKutu}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding Kod, Mode=OneWay}" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <Run Text=" - " Foreground="#94A3B8"/>
                                                <Run Text="{Binding Ad, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="+" Tag="URUN_KATEGORISI" Click="TanimYonet_Click" Margin="4,0,0,0" ToolTip="Kategorileri yönet"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Marka" Style="{StaticResource EtiketMetin}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Markalar}" SelectedItem="{Binding SeciliMarka}" TextSearch.TextPath="Ad" IsEditable="True" IsTextSearchEnabled="False" Text="{Binding MarkaAramaMetni, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormAcilirKutu}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding Kod, Mode=OneWay}" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <Run Text=" - " Foreground="#94A3B8"/>
                                                <Run Text="{Binding Ad, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="+" Tag="MARKA" Click="TanimYonet_Click" Margin="4,0,0,0" ToolTip="Markaları yönet"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Açıklama / Not" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Text="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <CheckBox IsChecked="{Binding Aktif}" Margin="0,0,0,24" FontWeight="SemiBold"
                              Content="Ürün aktif (pasif ürünler satış ve faturada seçilemez, kayıtları silinmez)"/>

                    <TextBlock Text="Fiyatlandırma" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}" Margin="0,0,0,4"/>
                    <TextBlock Text="Tek çekim (peşin) fiyat; fatura, sipariş, irsaliye ve POS'ta kullanılan satış fiyatıdır." Style="{StaticResource SayfaAltBaslik}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Alış Fiyatı (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding AlisFiyati}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Toptan Satış (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding ToptanSatisFiyati}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="KDV Oranı (%)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding KdvOrani}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Tek Çekim / Peşin Satış (₺)" Style="{StaticResource EtiketMetin}" FontWeight="Bold"/>
                            <TextBox Text="{Binding FiyatTekCekim}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="2 Taksit Satış (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Fiyat2Taksit}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="3 Taksit Satış (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Fiyat3Taksit}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="4 Taksit Satış (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Fiyat4Taksit}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="5 Taksit Satış (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Fiyat5Taksit}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="6 Taksit Satış (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Fiyat6Taksit}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="7 Taksit Satış (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Fiyat7Taksit}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                            <TextBlock Text="8 Taksit Satış (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Fiyat8Taksit}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="9 Taksit Satış (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Fiyat9Taksit}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Stok" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}" Margin="0,0,0,8"/>
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                        <TextBlock Text="{Binding StokBilgiMetni}" TextWrapping="Wrap" FontSize="12" Foreground="#92400E"/>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{Binding MagazaEtiketi}" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding MagazaStok, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding MagazaGirilebilir}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Depo1Etiketi}" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Depo1Stok, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Depo1Girilebilir}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Depo2Etiketi}" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Depo2Stok, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Depo2Girilebilir}" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Toplam Stok" Style="{StaticResource EtiketMetin}" Foreground="{StaticResource TextSecondaryFirca}"/>
                            <TextBox Text="{Binding ToplamStok, Mode=OneWay}" IsReadOnly="True" Background="#F1F5F9" Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Kritik Stok Seviyesi (bu miktara düşünce uyarı verilir)" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Text="{Binding MinimumStok}" Style="{StaticResource FormGirisKutusu}" Width="200" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Alt Aksiyon Butonları -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="14,12" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" MaxWidth="500" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding HataMesaji}" Foreground="{StaticResource DangerDarkFirca}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding BasariMesaji}" Foreground="{StaticResource SuccessFirca}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding IptalKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✕" Margin="0,0,6,0"/>
                                        <TextBlock Text="Ürün Listesine Dön"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding KaydetKomutu}" Style="{StaticResource BirinciDugme}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding KaydetDugmeMetni}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
