<Window x:Class="Masaustu.Gorunumler.Sayfa.Banka.BankaEkstrePenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Banka Ekstresi Aktar" Width="1240" Height="720" WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TutarMetni" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#B91C1C"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Giris}" Value="True">
                        <Setter Property="Foreground" Value="#15803D"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SatirStili" TargetType="DataGridRow">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Duzenlenebilir}" Value="False">
                        <Setter Property="Foreground" Value="#94A3B8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="📥" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Banka Ekstresi Aktar" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Banka hesabı:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Hesaplar}" SelectedItem="{Binding Hesap}" DisplayMemberPath="Ad" Width="240" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Button Command="{Binding DosyaSecKomutu}" Style="{StaticResource BirinciDugme}"><TextBlock Text="📂 Ekstre Dosyası Seç"/></Button>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding SutunBilgisi}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,0,8"/>

        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Satirlar}" Style="{StaticResource ModernDataGrid}" RowStyle="{StaticResource SatirStili}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="AKTAR" Width="58">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Secili, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Duzenlenebilir}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="TARİH" Binding="{Binding Tarih, StringFormat={}{0:dd.MM.yyyy}}" Width="98" IsReadOnly="True"/>
                    <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="TUTAR" Binding="{Binding Tutar, StringFormat={}{0:N2}}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource TutarMetni}"/>
                    <DataGridTemplateColumn Header="İŞLEM" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Islemler, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Ad" SelectedValuePath="Deger"
                                          SelectedValue="{Binding Islem, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Duzenlenebilir}" Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="CARİ" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Cariler, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Ad" SelectedValuePath="Deger"
                                          SelectedValue="{Binding CariId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Duzenlenebilir}"
                                          IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Ad" Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="DURUM" Binding="{Binding Durum}" Width="200" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Kapat" IsCancel="True" Style="{StaticResource IkinciDugme}" Width="100" Margin="0,0,10,0"/>
                <Button Command="{Binding KaydetKomutu}" Style="{StaticResource BirinciDugme}"><TextBlock Text="✔ Seçilenleri Kaydet"/></Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Ozet}" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                <TextBlock Text="{Binding Durum}" TextWrapping="Wrap" Foreground="#334155" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
