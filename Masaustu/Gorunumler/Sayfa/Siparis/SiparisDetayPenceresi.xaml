<Window x:Class="Masaustu.Gorunumler.Sayfa.Siparis.SiparisDetayPenceresi"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Sipariş Detayı" Width="1050" Height="720" MinWidth="850" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F6F9">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><TextBlock Text="{Binding SiparisNo}" FontSize="22" FontWeight="SemiBold" Foreground="#14213D"/><Border DockPanel.Dock="Right" Background="#E8EEF8" Padding="10,5" CornerRadius="4"><TextBlock Text="{Binding Durum}" FontWeight="SemiBold"/></Border></DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <GroupBox Header="SİPARİŞ BİLGİLERİ" Margin="0,0,8,8"><StackPanel Margin="8"><TextBlock Text="{Binding SiparisTuru, StringFormat=Tür: {0}}"/><TextBlock Text="{Binding SiparisTarihi, StringFormat=Tarih: {0:dd.MM.yyyy}}"/><TextBlock Text="{Binding TeslimTarihi, StringFormat=Teslim: {0:dd.MM.yyyy}}"/><TextBlock Text="{Binding ReferansNo, StringFormat=Referans: {0}}"/></StackPanel></GroupBox>
    <GroupBox Grid.Column="1" Header="CARİ" Margin="0,0,8,8"><StackPanel Margin="8"><TextBlock Text="{Binding CariKart.Kod}"/><TextBlock Text="{Binding CariKart.Unvan}" FontWeight="SemiBold"/><TextBlock Text="{Binding CariKart.Telefon}"/><TextBlock Text="{Binding CariKart.Bakiye, StringFormat=Bakiye: {0:N2}}"/></StackPanel></GroupBox>
    <GroupBox Grid.Column="2" Header="TESLİMAT" Margin="0,0,0,8"><StackPanel Margin="8"><TextBlock Text="{Binding TeslimatAdSoyad}"/><TextBlock Text="{Binding TeslimatTelefon}"/><TextBlock Text="{Binding TeslimatIl}"/><TextBlock Text="{Binding TeslimatIlce}"/><TextBlock Text="{Binding TeslimatAdres}" TextWrapping="Wrap"/></StackPanel></GroupBox>
   </Grid>
   <GroupBox Header="TİCARİ BİLGİLER" Margin="0,0,0,8"><WrapPanel Margin="8"><TextBlock Text="{Binding ParaBirimi.Kod, StringFormat=Para Birimi: {0}}" Margin="0,0,25,0"/><TextBlock Text="{Binding Kur, StringFormat=Kur: {0:N4}}" Margin="0,0,25,0"/><TextBlock Text="{Binding OdemeSekli, StringFormat=Ödeme: {0}}" Margin="0,0,25,0"/><TextBlock Text="{Binding VadeTarihi, StringFormat=Vade: {0:dd.MM.yyyy}}"/></WrapPanel></GroupBox>
   <DataGrid ItemsSource="{Binding Kalemler}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="230">
    <DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding UrunKodu}"/><DataGridTextColumn Header="Barkod" Binding="{Binding Barkod}"/><DataGridTextColumn Header="Ürün" Binding="{Binding UrunAdi}" Width="*"/><DataGridTextColumn Header="Birim" Binding="{Binding Birim}"/><DataGridTextColumn Header="Miktar" Binding="{Binding Miktar, StringFormat=N2}"/><DataGridTextColumn Header="Birim Fiyat" Binding="{Binding BirimFiyat, StringFormat=N2}"/><DataGridTextColumn Header="İskonto" Binding="{Binding IskontoTutari, StringFormat=N2}"/><DataGridTextColumn Header="KDV" Binding="{Binding KdvTutari, StringFormat=N2}"/><DataGridTextColumn Header="Toplam" Binding="{Binding SatirToplami, StringFormat=N2}"/></DataGrid.Columns>
   </DataGrid>
   <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
    <GroupBox Header="AÇIKLAMA / NOT" Margin="0,0,10,0"><TextBlock Text="{Binding Aciklama}" TextWrapping="Wrap" Margin="8"/></GroupBox>
    <StackPanel Grid.Column="1"><TextBlock Text="{Binding BrutToplam, StringFormat=Brüt: {0:N2}}"/><TextBlock Text="{Binding IskontoToplami, StringFormat=İskonto: {0:N2}}"/><TextBlock Text="{Binding AraToplam, StringFormat=Ara Toplam: {0:N2}}"/><TextBlock Text="{Binding KdvToplami, StringFormat=KDV: {0:N2}}"/><TextBlock Text="{Binding GenelToplam, StringFormat=GENEL TOPLAM: {0:N2}}" FontSize="17" FontWeight="Bold"/></StackPanel>
   </Grid>
   <GroupBox Header="KAYIT BİLGİSİ"><WrapPanel Margin="8"><TextBlock Text="{Binding OlusturanKullanici.KullaniciAdi, StringFormat=Oluşturan: {0}}" Margin="0,0,20,0"/><TextBlock Text="{Binding OlusturmaTarihi, StringFormat=Oluşturma: {0:dd.MM.yyyy HH:mm}}" Margin="0,0,20,0"/><TextBlock Text="{Binding GuncelleyenKullanici.KullaniciAdi, StringFormat=Güncelleyen: {0}}" Margin="0,0,20,0"/><TextBlock Text="{Binding GuncellemeTarihi, StringFormat=Güncelleme: {0:dd.MM.yyyy HH:mm}}"/></WrapPanel></GroupBox>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button x:Name="SevkEtDugmesi" Content="Sevk Et / İrsaliye Oluştur" Click="SevkEt_Click" Width="190" Height="36" Margin="0,0,8,0" Background="#14213D" Foreground="White" FontWeight="SemiBold"/>
   <Button Content="Kapat" IsCancel="True" Width="90" Height="36"/>
  </StackPanel>
 </Grid>
</Window>
