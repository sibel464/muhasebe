<Window x:Class="Masaustu.Gorunumler.Sayfa.Siparis.SiparisFormPenceresi"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:y="clr-namespace:Masaustu.Yardimcilar" Title="Sipariş" Width="1180" Height="720" MinWidth="1000" MinHeight="650"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F6F9">
 <Window.Resources>
  <y:SiparisMetinDonusturucu x:Key="SiparisMetin"/>
  <Style x:Key="Etiket" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
  <Style x:Key="Baslik" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#14213D"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE3ED"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="14"/></Style>
 </Window.Resources>
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><Button Content="← Geri" Command="{Binding FormaGeriDonKomutu}" Padding="10,6" Margin="0,0,14,0"/>
   <TextBlock Text="{Binding FormBasligi}" FontSize="22" FontWeight="SemiBold" Foreground="#14213D" VerticalAlignment="Center"/>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Taslak Kaydet" Command="{Binding TaslakKaydetKomutu}" Padding="12,7" Margin="4,0"/><Button Content="Siparişi Kaydet" Command="{Binding KaydetKomutu}" Padding="12,7" Background="#14213D" Foreground="White" BorderThickness="0"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,10" IsEnabled="{Binding Duzenlenebilir}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Margin="0,0,8,0"><StackPanel><TextBlock Text="SİPARİŞ BİLGİLERİ" Style="{StaticResource Baslik}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,8,0"><TextBlock Text="Sipariş Türü" Style="{StaticResource Etiket}"/><ComboBox ItemsSource="{Binding Turler}" SelectedItem="{Binding FormSiparisTuru}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SiparisMetin}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Sipariş No" Style="{StaticResource Etiket}"/><TextBox Text="Otomatik" IsReadOnly="True" Foreground="#64748B"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Referans No" Style="{StaticResource Etiket}"/><TextBox Text="{Binding Form.ReferansNo}"/></StackPanel>
    </Grid>
    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,8,0"><TextBlock Text="Sipariş Tarihi" Style="{StaticResource Etiket}"/><DatePicker SelectedDate="{Binding Form.SiparisTarihi}"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="Teslim Tarihi" Style="{StaticResource Etiket}"/><DatePicker SelectedDate="{Binding Form.TeslimTarihi}"/></StackPanel>
    </Grid>
   </StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel><TextBlock Text="CARİ" Style="{StaticResource Baslik}"/><Button DockPanel.Dock="Right" Content="Cari Seç / Değiştir" Command="{Binding CariSecKomutu}" Padding="9,4"/></DockPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="{Binding SeciliCari.Unvan, TargetNullValue=Henüz cari seçilmedi.}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding SeciliCari.Kod}" Foreground="#64748B"/><WrapPanel Margin="0,7,0,0"><TextBlock Text="{Binding SeciliCari.Telefon, StringFormat=Telefon: {0}}" Margin="0,0,18,0"/><TextBlock Text="{Binding SeciliCari.Bakiye, StringFormat=Bakiye: {0:N2} ₺}"/></WrapPanel></StackPanel>
   </Grid></Border>
  </Grid>
  <Grid Grid.Row="2" IsEnabled="{Binding Duzenlenebilir}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Panel}" Margin="0,0,8,8"><StackPanel><TextBlock Text="TESLİMAT BİLGİLERİ" Style="{StaticResource Baslik}"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0"><TextBlock Text="Ad Soyad" Style="{StaticResource Etiket}"/><TextBox Text="{Binding Form.TeslimatAdSoyad}"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Telefon" Style="{StaticResource Etiket}"/><TextBox x:Name="TelefonKutusu" Text="{Binding Form.TeslimatTelefon}" PreviewTextInput="TelefonKutusu_PreviewTextInput"/></StackPanel>
     </Grid>
     <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0"><TextBlock Text="İl" Style="{StaticResource Etiket}"/><TextBox Text="{Binding Form.TeslimatIl}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="İlçe" Style="{StaticResource Etiket}"/><TextBox Text="{Binding Form.TeslimatIlce}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Adres" Style="{StaticResource Etiket}"/><TextBox Text="{Binding Form.TeslimatAdres}" AcceptsReturn="True" TextWrapping="Wrap" Height="48"/></StackPanel>
     </Grid>
    </StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="0,0,0,8"><StackPanel><TextBlock Text="TİCARİ BİLGİLER" Style="{StaticResource Baslik}"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Para Birimi" Style="{StaticResource Etiket}"/><TextBox Text="TRY" IsReadOnly="True"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Kur" Style="{StaticResource Etiket}"/><TextBox Text="{Binding Form.Kur, StringFormat=N4}"/></StackPanel></Grid>
     <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Ödeme Şekli" Style="{StaticResource Etiket}"/><ComboBox ItemsSource="{Binding OdemeSekilleri}" SelectedItem="{Binding Form.OdemeSekli}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SiparisMetin}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Vade Tarihi" Style="{StaticResource Etiket}"/><DatePicker SelectedDate="{Binding Form.VadeTarihi}"/></StackPanel></Grid>
    </StackPanel></Border>
   </Grid>
   <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="12,9"><TextBlock Text="ÜRÜNLER" Style="{StaticResource Baslik}" Margin="0"/><Button DockPanel.Dock="Right" Content="+ Ürün Ekle" Command="{Binding UrunSecKomutu}" Padding="10,5" Background="#14213D" Foreground="White" BorderThickness="0"/></DockPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Kalemler}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="34" MinHeight="190" CellEditEnding="KalemGrid_CellEditEnding" AlternatingRowBackground="#F8FAFC">
     <DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding UrunKodu}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="Barkod" Binding="{Binding Barkod}" Width="105" IsReadOnly="True"/><DataGridTextColumn Header="Ürün" Binding="{Binding UrunAdi}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Birim" Binding="{Binding Birim}" Width="60" IsReadOnly="True"/><DataGridTextColumn Header="Miktar" Binding="{Binding Miktar, StringFormat=N3}" Width="75"/><DataGridTextColumn Header="Birim Fiyat" Binding="{Binding BirimFiyat, StringFormat=N2}" Width="90"/><DataGridTextColumn Header="İskonto %" Binding="{Binding IskontoOrani, StringFormat=N2}" Width="78"/><DataGridTextColumn Header="KDV %" Binding="{Binding KdvOrani, StringFormat=N0}" Width="62"/><DataGridTextColumn Header="Toplam" Binding="{Binding SatirToplami, StringFormat={}{0:N2} ₺}" Width="98"/><DataGridTemplateColumn Header="İşlem" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Sil" Command="{Binding DataContext.KalemSilKomutu, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="4,1"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
    </DataGrid>
   </Grid></Border>
  </Grid>
  <Grid Grid.Row="3" Margin="0,10,0,0" IsEnabled="{Binding Duzenlenebilir}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="AÇIKLAMA / NOT" Style="{StaticResource Baslik}"/><TextBox Text="{Binding Form.Aciklama}" AcceptsReturn="True" TextWrapping="Wrap" Height="72" VerticalScrollBarVisibility="Auto" ToolTip="Siparişle ilgili not ekleyin..."/></StackPanel>
   <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="10,0,0,0"><StackPanel><TextBlock Text="SİPARİŞ ÖZETİ" Style="{StaticResource Baslik}"/><DockPanel><TextBlock Text="Brüt Toplam"/><TextBlock DockPanel.Dock="Right" Text="{Binding Form.BrutToplam, StringFormat={}{0:N2} ₺}"/></DockPanel><DockPanel><TextBlock Text="İskonto"/><TextBlock DockPanel.Dock="Right" Text="{Binding Form.IskontoToplami, StringFormat={}{0:N2} ₺}"/></DockPanel><DockPanel><TextBlock Text="Ara Toplam"/><TextBlock DockPanel.Dock="Right" Text="{Binding Form.AraToplam, StringFormat={}{0:N2} ₺}"/></DockPanel><DockPanel><TextBlock Text="KDV"/><TextBlock DockPanel.Dock="Right" Text="{Binding Form.KdvToplami, StringFormat={}{0:N2} ₺}"/></DockPanel><Separator Margin="0,6"/><DockPanel><TextBlock Text="GENEL TOPLAM" FontWeight="Bold"/><TextBlock DockPanel.Dock="Right" Text="{Binding Form.GenelToplam, StringFormat={}{0:N2} ₺}" FontSize="16" FontWeight="Bold"/></DockPanel></StackPanel></Border>
  </Grid>
  <DockPanel Grid.Row="4" Margin="0,10,0,0"><TextBlock Text="{Binding Mesaj}" Foreground="#64748B" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Listeye Dön" Command="{Binding FormaGeriDonKomutu}" Padding="12,7" Margin="4,0"/><Button Content="Taslak Kaydet" Command="{Binding TaslakKaydetKomutu}" IsEnabled="{Binding Duzenlenebilir}" Padding="12,7" Margin="4,0"/><Button Content="Siparişi Kaydet" Command="{Binding KaydetKomutu}" IsEnabled="{Binding Duzenlenebilir}" Padding="12,7" Background="#14213D" Foreground="White" BorderThickness="0"/></StackPanel></DockPanel>
 </Grid>
</Window>
