<Window x:Class="Masaustu.Gorunumler.Sayfa.Siparis.SiparistenSevkPenceresi"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Siparişten Sevk" Width="1180" Height="720" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F6F9">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14"><StackPanel><TextBlock Text="SİPARİŞTEN SEVK" FontSize="24" FontWeight="SemiBold" Foreground="#14213D"/><TextBlock Text="Sevk miktarını girin ve hangi lokasyondan çıkacağını açıkça dağıtın." Foreground="#667085"/></StackPanel><Border DockPanel.Dock="Right" Background="#E8EEF8" Padding="12,7" CornerRadius="4"><TextBlock Text="{Binding Siparis.SiparisNo}" FontWeight="SemiBold" Foreground="#14213D"/></Border></DockPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CARİ" Foreground="#667085" FontSize="11"/><TextBlock Text="{Binding Siparis.CariKart.Unvan}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="SİPARİŞ TARİHİ" Foreground="#667085" FontSize="11"/><TextBlock Text="{Binding Siparis.SiparisTarihi, StringFormat=dd.MM.yyyy}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="TESLİM TARİHİ" Foreground="#667085" FontSize="11"/><TextBlock Text="{Binding Siparis.TeslimTarihi, StringFormat=dd.MM.yyyy}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="TESLİMAT ADRESİ" Foreground="#667085" FontSize="11"/><TextBlock Text="{Binding Siparis.TeslimatAdres}" TextWrapping="Wrap"/></StackPanel></Grid></Border>
  <DataGrid Grid.Row="2" ItemsSource="{Binding Satirlar}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Background="White" BorderBrush="#D8DEE9" RowHeight="42">
   <DataGrid.Columns><DataGridTextColumn Header="ÜRÜN" Binding="{Binding UrunAdi}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="SİPARİŞ" Binding="{Binding SiparisMiktari, StringFormat=N2}" Width="85" IsReadOnly="True"/><DataGridTextColumn Header="ÖNCEKİ SEVK" Binding="{Binding OncekiSevk, StringFormat=N2}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="KALAN" Binding="{Binding Kalan, StringFormat=N2}" Width="85" IsReadOnly="True"/><DataGridTextColumn Header="BU SEVK" Binding="{Binding BuSevkMetni, UpdateSourceTrigger=PropertyChanged, TargetNullValue='', FallbackValue=''}" Width="90"/><DataGridTextColumn x:Name="MagazaSutunu" Header="MAĞAZA" Binding="{Binding MagazaMetni, UpdateSourceTrigger=PropertyChanged, TargetNullValue='', FallbackValue=''}" Width="80"/><DataGridTextColumn x:Name="Depo1Sutunu" Header="DEPO 1" Binding="{Binding Depo1Metni, UpdateSourceTrigger=PropertyChanged, TargetNullValue='', FallbackValue=''}" Width="80"/><DataGridTextColumn x:Name="Depo2Sutunu" Header="DEPO 2" Binding="{Binding Depo2Metni, UpdateSourceTrigger=PropertyChanged, TargetNullValue='', FallbackValue=''}" Width="80"/><DataGridTextColumn Header="MEVCUT STOK (M/D1/D2)" Binding="{Binding MevcutBilgisi}" Width="170" IsReadOnly="True"/></DataGrid.Columns>
  </DataGrid>
  <Grid Grid.Row="3" Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Taşıyıcı / Kargo"/><TextBox Text="{Binding Tasiyici}" Height="30"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Araç Plaka"/><TextBox Text="{Binding AracPlaka}" Height="30"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Şoför Adı / Telefon"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding SoforAdi}" Height="30" Margin="0,0,5,0"/><TextBox Grid.Column="1" Text="{Binding SoforTelefon}" Height="30" Margin="5,0,0,0"/></Grid></StackPanel></Grid>
  <DockPanel Grid.Row="4"><TextBlock Text="Dağılım toplamı, bu sevk miktarına eşit olmalıdır." Foreground="#667085" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="İptal" IsCancel="True" Width="90" Height="36" Margin="0,0,8,0"/><Button Content="İrsaliye Oluştur" Click="Olustur_Click" Width="145" Height="36" Background="#14213D" Foreground="White" FontWeight="SemiBold"/></StackPanel></DockPanel>
 </Grid>
</Window>
