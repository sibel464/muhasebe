<UserControl x:Class="Masaustu.Gorunumler.Sayfa.TedarikciSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:yardimcilar="clr-namespace:Masaustu.Yardimcilar"
             xmlns:model="clr-namespace:EtkiAlani.Modeller.Cari;assembly=EtkiAlani"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1024"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimcilar:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Başlık ve Aksiyonlar -->
            <RowDefinition Height="Auto"/> <!-- 2. Filtre Barı -->
            <RowDefinition Height="*"/>    <!-- 3. DataGrid Listesi -->
            <RowDefinition Height="Auto"/> <!-- 4. Alt Seçili Satır Aksiyonları -->
        </Grid.RowDefinitions>

        <!-- 1. ÜST PANEL: Başlık ve Aksiyonlar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource BaslikIkonKutusu}">
                    <TextBlock Text="🏭" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tedarikçi Yönetimi" Style="{StaticResource SayfaBasligi}"/>
                    <TextBlock Text="Tedarikçi firma kartları, borç/alacak bakiyeleri ve alım hareketleri." Style="{StaticResource SayfaAltBaslik}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding YenileKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Yenile" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding YeniEkleKomutu}" Style="{StaticResource BirinciDugme}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Yeni Tedarikçi Ekle" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. FİLTRELEME BARI -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Tedarikçi Adı / Ünvan Ara" Style="{StaticResource EtiketMetin}"/>
                    <TextBox Style="{StaticResource FiltreKutusu}" Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Tedarikçi Kodu" Style="{StaticResource EtiketMetin}"/>
                    <TextBox Style="{StaticResource FiltreKutusu}" Text="{Binding AramaKodu, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Grup Kodu" Style="{StaticResource EtiketMetin}"/>
                    <TextBox Style="{StaticResource FiltreKutusu}" Text="{Binding AramaGrupKodu, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. DATAGRID TABLO -->
        <Border Grid.Row="2" Background="White" CornerRadius="10"
                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Tedarikciler}" 
                      SelectedItem="{Binding SeciliTedarikci, Mode=TwoWay}"
                      Style="{StaticResource ModernDataGrid}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="KOD" Binding="{Binding Kod}" Width="120" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="ÜNVAN / FİRMA ADI" Binding="{Binding Unvan}" Width="2*"/>
                    <DataGridTextColumn Header="TELEFON" Binding="{Binding Telefon}" Width="130"/>
                    <DataGridTextColumn Header="ŞEHİR" Binding="{Binding Il}" Width="110"/>
                    <DataGridTextColumn Header="BORÇ (TL)" Binding="{Binding Borc, StringFormat='{}{0:N2} ₺'}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="{StaticResource DangerDarkFirca}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ALACAK (TL)" Binding="{Binding Alacak, StringFormat='{}{0:N2} ₺'}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="{StaticResource SuccessDarkFirca}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="BAKİYE (TL)" Binding="{Binding Bakiye, StringFormat='{}{0:N2} ₺'}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. ALT SEÇİLİ SATIR AKSİYON BARI -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="14,10" Margin="0,12,0,0"
                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Seçili Tedarikçi:" FontSize="13" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SeciliTedarikci.Unvan}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding DuzenleKomutu}" Style="{StaticResource BirinciDugme}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Düzenle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SilKomutu}" Style="{StaticResource TehlikeliDugme}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sil" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
