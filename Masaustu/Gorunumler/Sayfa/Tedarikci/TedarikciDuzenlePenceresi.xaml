<Window x:Class="Masaustu.Gorunumler.Sayfa.Tedarikci.TedarikciDuzenlePenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
        xmlns:model="clr-namespace:EtkiAlani.Modeller.Cari;assembly=EtkiAlani"
        Title="{Binding PencereBasligi}"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="White">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
            <yardimci:TersBosBoslukDonusturucu x:Key="TersBosBoslukDonusturucu"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000" BlurRadius="30" ShadowDepth="5" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- BaÅŸlÄ±k BarÄ± -->
            <Border Grid.Row="0" Background="{StaticResource MenuGradient}" Padding="24,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding PencereBasligi}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Cari hesap ve mÃ¼ÅŸteri kartÄ± tanÄ±mlama bilgileri."
                                   FontSize="11" Foreground="#80FFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="âœ•"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#80FFFFFF" FontSize="14" Cursor="Hand"
                            Command="{Binding IptalKomutu}"/>
                </Grid>
            </Border>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="550">
                <StackPanel Margin="24,20">

                    <!-- SatÄ±r 1: Kod + Grup + Cari Tipi (Bireysel/Kurumsal) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Cari Kodu *" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Kod, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Grup (Ã–rn: ESNAF)" Style="{StaticResource EtiketMetin}"/>
                            <ComboBox ItemsSource="{Binding GrupKodlari}" Text="{Binding GrupKodu, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MÃ¼ÅŸteri TÃ¼rÃ¼" Style="{StaticResource EtiketMetin}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding CariTipleri}" DisplayMemberPath="Ad" SelectedItem="{Binding SeciliCariTipi}" Height="40" FontSize="13" Padding="10,0"/>
                                <Button Grid.Column="1" Content="+" Click="CariTipiYonet_Click" ToolTip="Cari tipi ekle veya yönet" Margin="4,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- SatÄ±r 2: Kurumsal ise Unvan, Bireysel ise Ad + Soyad -->
                    <!-- Kurumsal GÃ¶rÃ¼nÃ¼m -->
                    <StackPanel Visibility="{Binding IsKurumsal, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,16">
                        <TextBlock Text="Firma ÃœnvanÄ± *" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Text="{Binding Unvan, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource ModernMetinKutusu}" Height="40"/>
                    </StackPanel>

                    <!-- Bireysel GÃ¶rÃ¼nÃ¼m -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="AdÄ± *" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SoyadÄ± *" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Soyad, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40"/>
                        </StackPanel>
                    </Grid>

                    <!-- SatÄ±r 3: Vergi No / Kimlik No -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Kurumsal Vergi Bilgileri -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0" Visibility="{Binding IsKurumsal, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Vergi Dairesi" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding VergiDairesi, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Visibility="{Binding IsKurumsal, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Vergi NumarasÄ±" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding VergiNo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40" MaxLength="10"/>
                        </StackPanel>

                        <!-- Bireysel T.C. Kimlik Bilgileri -->
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding IsBireysel, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="T.C. Kimlik NumarasÄ±" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding TcNo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40" MaxLength="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- SatÄ±r 4: Ä°letiÅŸim Bilgileri (Telefon + E-posta) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Cep Telefonu" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding CepTelefonu, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40" InputScope="TelephoneNumber"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ä°ÅŸ Telefonu" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding IsTelefonu, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40" InputScope="TelephoneNumber"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Ev Telefonu" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding EvTelefonu, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40" InputScope="TelephoneNumber"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="E-posta Adresi" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Eposta, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40"/>
                        </StackPanel>
                    </Grid>

                    <!-- SatÄ±r 5: Adres Bilgileri -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Ä°l" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Il, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Ä°lÃ§e" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Ilce, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Posta Kodu" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding PostaKodu, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40" MaxLength="5"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="AÃ§Ä±k Adres" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Text="{Binding Adres, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernMetinKutusu}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <!-- Aktif/Pasif SeÃ§imi -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <CheckBox IsChecked="{Binding Aktif}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="MÃ¼ÅŸteri kartÄ± aktif durumda (Pasife alarak tÃ¼m iÅŸlemlerini dondurabilirsiniz)." 
                                   FontSize="12" Foreground="#4B5563" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Hata MesajÄ± -->
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="12,8"
                            Margin="0,8,0,0"
                            Visibility="{Binding HataMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                        <TextBlock Text="{Binding HataMesaji}" Foreground="#DC2626" FontSize="12"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Alt Eylem DÃ¼ÄŸmeleri -->
            <Border Grid.Row="3" Background="#F9FAFB"
                    BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Ä°ptal" Command="{Binding IptalKomutu}"
                            Width="90" Height="38" Margin="0,0,8,0"
                            Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                            Foreground="#374151" FontSize="13" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="8"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="{Binding Kaydediliyor, Converter={x:Static yardimci:KaydediliyorMetinDonusturucu.Ornek}}"
                            Command="{Binding KaydetKomutu}"
                            Width="110" Height="38"
                            Style="{StaticResource AnaDugme}" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

