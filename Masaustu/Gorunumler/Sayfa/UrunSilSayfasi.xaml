<UserControl x:Class="Masaustu.Gorunumler.Sayfa.UrunSilSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
             Language="tr-TR"
             Background="Transparent">

    <UserControl.Resources>
        <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <yardimci:UtcYerelTarihDonusturucu x:Key="UtcYerelTarih"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- 1. Başlık -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" CornerRadius="10" Background="#FEE2E2" Margin="0,0,16,0">
                    <TextBlock Text="🗑️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Ürün Silme" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#6B7280"
                               Text="Silinen ürün listelerden kalkar; geçmiş faturaları, stok hareketleri ve raporları korunur. Stoğu veya açık siparişi olan ürün silinemez."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. Mesajlar -->
        <StackPanel Grid.Row="1">
            <Border Background="#FEE2E2" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                    Visibility="{Binding HataMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                <TextBlock Text="{Binding HataMesaji}" Foreground="#B91C1C" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#D1FAE5" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                    Visibility="{Binding BasariMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                <TextBlock Text="{Binding BasariMesaji}" Foreground="#065F46" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- 3. Silinebilecek ürünler -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBox Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernMetinKutusu}" Height="40" Padding="40,0,12,0" FontSize="14"
                             ToolTip="Kod, ad veya barkod ile arayın"/>
                    <TextBlock Text="🔍" FontSize="16" Foreground="#9CA3AF" IsHitTestVisible="False"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding AramaSonuclari}" SelectedItem="{Binding SeciliUrun}"
                          Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KOD" Binding="{Binding Kod}" Width="120"/>
                        <DataGridTextColumn Header="BARKOD" Binding="{Binding Barkod}" Width="130"/>
                        <DataGridTextColumn Header="ÜRÜN ADI" Binding="{Binding Ad}" Width="*"/>
                        <DataGridTextColumn Header="STOK" Binding="{Binding StokMiktari, StringFormat={}{0:N2}}" Width="90"/>
                        <DataGridTextColumn Header="SATIŞ FİYATI" Binding="{Binding PerakendeSatisFiyati, StringFormat={}{0:N2} ₺}" Width="120"/>
                        <DataGridCheckBoxColumn Header="AKTİF" Binding="{Binding Aktif}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="2" Command="{Binding SilKomutu}" Background="#DC2626" Foreground="White"
                        Height="42" Margin="0,12,0,0" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Right" Width="200">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Seçili Ürünü Sil" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 4. Silinen ürünler -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Silinen Ürünler" FontSize="15" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Silinenler}" SelectedItem="{Binding SeciliSilinen}"
                          Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KOD" Binding="{Binding Kod}" Width="120"/>
                        <DataGridTextColumn Header="ÜRÜN ADI" Binding="{Binding Ad}" Width="*"/>
                        <DataGridTextColumn Header="SİLİNME TARİHİ" Binding="{Binding SilinmeTarihi, Converter={StaticResource UtcYerelTarih}}" Width="140"/>
                        <DataGridTextColumn Header="NEDEN" Binding="{Binding SilinmeNedeni}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="2" Command="{Binding GeriAlKomutu}" Style="{StaticResource IkinciDugme}"
                        Margin="0,12,0,0" HorizontalAlignment="Right" Width="200">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↩" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Seçili Ürünü Geri Al" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
