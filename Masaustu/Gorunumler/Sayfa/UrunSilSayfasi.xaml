<UserControl x:Class="Masaustu.Gorunumler.Sayfa.UrunSilSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
             Background="Transparent">

    <UserControl.Resources>
        <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. ÜST PANEL: Başlık -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" CornerRadius="10" Background="#FEE2E2" Margin="0,0,16,0">
                    <TextBlock Text="🗑️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Ürün / Stok Silme" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Sistemden bir ürün kaydını pasife alın (Silin)." FontSize="13" Foreground="#6B7280"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. ARAMA VE LİSTE ALANI -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="24">
            <Border.Effect>
                <DropShadowEffect Color="#000" BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Ürün Ara:" FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,8"/>
                    <Grid>
                        <TextBox Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernMetinKutusu}" Height="45" Padding="40,0,12,0" 
                                 FontSize="14"/>
                        <TextBlock Text="🔍" FontSize="18" Foreground="#9CA3AF" 
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Arama Sonuçları Listesi -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding AramaSonuclari}" 
                          SelectedItem="{Binding SeciliUrun}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" SelectionMode="Single"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KOD" Binding="{Binding Kod}" Width="100"/>
                        <DataGridTextColumn Header="BARKOD" Binding="{Binding Barkod}" Width="120"/>
                        <DataGridTextColumn Header="ÜRÜN ADI" Binding="{Binding Ad}" Width="*"/>
                        <DataGridTextColumn Header="STOK" Binding="{Binding StokMiktari}" Width="100"/>
                        <DataGridTextColumn Header="SATIŞ FİYATI" Binding="{Binding PerakendeSatisFiyati, StringFormat={}{0:N2} ₺}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Geri Bildirim Alanı -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <Border Background="#FEE2E2" CornerRadius="6" Padding="12" Margin="0,0,0,8" 
                            Visibility="{Binding HataMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                        <TextBlock Text="{Binding HataMesaji}" Foreground="#B91C1C" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#D1FAE5" CornerRadius="6" Padding="12" Margin="0,0,0,8" 
                            Visibility="{Binding BasariMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                        <TextBlock Text="{Binding BasariMesaji}" Foreground="#065F46" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Sil Butonu -->
                <Button Grid.Row="3" Command="{Binding SilKomutu}" 
                        Background="#DC2626" Foreground="White" 
                        Height="50" Margin="0,16,0,0"
                        FontWeight="Bold" FontSize="16" BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Right" Width="200">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Seçili Ürünü Sil" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </Grid>
        </Border>
    </Grid>
</UserControl>
