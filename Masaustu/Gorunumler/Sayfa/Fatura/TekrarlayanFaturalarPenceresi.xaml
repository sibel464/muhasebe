<Window x:Class="Masaustu.Gorunumler.Sayfa.TekrarlayanFaturalarPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tekrarlayan Faturalar" Width="1260" Height="640" WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TutarMetni" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="DurumMetni" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#475569"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Aktif}" Value="False">
                        <Setter Property="Foreground" Value="#94A3B8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="🔁" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="Tekrarlayan Faturalar" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,4,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding YenileKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0"><TextBlock Text="🔄 Yenile"/></Button>
                <Button Command="{Binding TumunuKesKomutu}" Style="{StaticResource BirinciDugme}"><TextBlock Text="🧾 Bekleyen Tüm Faturaları Kes"/></Button>
            </StackPanel>
            <TextBlock Text="Yeni tekrarlayan fatura için fatura listesinde örnek alınacak faturanın satırındaki 🔁 düğmesine basın. Program kendiliğinden fatura kesmez; zamanı gelenleri buradan siz kesersiniz."
                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryFirca}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>

        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Planlar}" SelectedItem="{Binding Secili}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="FullRow" SelectionMode="Single" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="AD" Binding="{Binding Ad}" Width="1.2*" MinWidth="150"/>
                    <DataGridTextColumn Header="CARİ" Binding="{Binding CariUnvan}" Width="160"/>
                    <DataGridTextColumn Header="ÖRNEK FATURA" Binding="{Binding OrnekFaturaNo}" Width="115"/>
                    <DataGridTextColumn Header="TUTAR" Binding="{Binding Tutar, StringFormat={}{0:N2}}" Width="95" ElementStyle="{StaticResource TutarMetni}"/>
                    <DataGridTextColumn Header="SIKLIK" Binding="{Binding PeriyotAdi}" Width="95"/>
                    <DataGridTextColumn Header="SIRADAKİ" Binding="{Binding SiradakiTarih, StringFormat={}{0:dd.MM.yyyy}}" Width="90"/>
                    <DataGridTextColumn Header="KESİLEN" Binding="{Binding OlusturulanAdet}" Width="65" ElementStyle="{StaticResource TutarMetni}"/>
                    <DataGridTextColumn Header="SON FATURA" Binding="{Binding SonFaturaNo}" Width="115"/>
                    <DataGridTextColumn Header="DURUM" Binding="{Binding Durum}" Width="125" ElementStyle="{StaticResource DurumMetni}"/>
                    <DataGridTextColumn Header="SON HATA" Binding="{Binding SonHata}" Width="*" MinWidth="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B91C1C"/>
                                <Setter Property="ToolTip" Value="{Binding SonHata}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding SilKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0" Content="Sil"/>
                <Button Command="{Binding DurdurBaslatKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0" Content="Durdur / Başlat"/>
                <Button Command="{Binding DuzenleKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0" Content="Düzenle"/>
                <Button Command="{Binding SeciliKesKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0" Content="Seçilenin Faturalarını Kes"/>
                <Button Content="Kapat" IsCancel="True" Style="{StaticResource IkinciDugme}" Width="90"/>
            </StackPanel>
            <TextBlock Text="{Binding Durum}" TextWrapping="Wrap" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
