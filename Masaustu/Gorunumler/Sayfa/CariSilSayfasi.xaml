<UserControl x:Class="Masaustu.Gorunumler.Sayfa.CariSilSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
             xmlns:model="clr-namespace:EtkiAlani.Modeller.Cari;assembly=EtkiAlani"
             Language="tr-TR"
             Background="Transparent">

    <UserControl.Resources>
        <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
        <yardimci:UtcYerelTarihDonusturucu x:Key="UtcYerelTarih"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- 1. Başlık ve arama -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="10" Background="#FEF2F2" Margin="0,0,16,0">
                        <TextBlock Text="🗑️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cari Silme" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#6B7280" MaxWidth="560" HorizontalAlignment="Left"
                                   Text="Yalnızca hiç işlem görmemiş (fatura, tahsilat, hareket yok) cari silinebilir. İşlem görmüş cariyi kartından pasif yapın."/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox Style="{StaticResource ModernMetinKutusu}" Width="300" Height="40" Padding="36,0,8,0"
                             Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}" ToolTip="Kod, ünvan, vergi no veya telefon ile arayın"/>
                    <TextBlock Text="🔍" Foreground="#9CA3AF" FontSize="16" IsHitTestVisible="False"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Mesajlar -->
        <StackPanel Grid.Row="1">
            <Border Background="#FEF2F2" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding HataMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                <TextBlock Text="{Binding HataMesaji}" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#ECFDF5" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding BasariMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                <TextBlock Text="{Binding BasariMesaji}" Foreground="#059669" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- 3. Cariler -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid ItemsSource="{Binding AramaSonuclari}" SelectedItem="{Binding SeciliCari}"
                          Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KODU" Binding="{Binding Kod}" Width="110" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="AD SOYAD / ÜNVAN" Binding="{Binding Unvan}" Width="*"/>
                        <DataGridTemplateColumn Header="TÜR" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Müşteri"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tur}" Value="{x:Static model:CariTuru.Tedarikci}">
                                                        <Setter Property="Text" Value="Tedarikçi"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tur}" Value="{x:Static model:CariTuru.MusteriTedarikci}">
                                                        <Setter Property="Text" Value="Müşteri+Tedarikçi"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="VERGİ NO" Binding="{Binding VergiNo}" Width="110"/>
                        <DataGridTextColumn Header="İL" Binding="{Binding Il}" Width="100"/>
                        <DataGridTextColumn Header="BAKİYE" Binding="{Binding Bakiye, StringFormat={}{0:N2} ₺}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <!-- KVKK: üstte veya altta son seçilen cariye uygulanır -->
                    <Button Command="{Binding KvkkDokumKomutu}" Style="{StaticResource IkinciDugme}" Width="200" Margin="0,0,8,0"
                            ToolTip="Kişinin hakkında tutulan verilerin dökümünü (KVKK md. 11 bilgi talebi) dosyaya kaydeder">
                        <TextBlock Text="KVKK: Kişisel Veri Dökümü"/>
                    </Button>
                    <Button Command="{Binding KvkkAnonimlestirKomutu}" Style="{StaticResource IkinciDugme}" Width="200" Margin="0,0,8,0"
                            ToolTip="Yasal saklama süresi (10 yıl) dolmuşsa kişisel verileri kalıcı olarak siler; tutarlar ve belgeler kalır">
                        <TextBlock Text="KVKK: Anonimleştir"/>
                    </Button>
                    <Button Command="{Binding SilKomutu}" Background="#DC2626" Foreground="White"
                            Height="42" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Width="200">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Seçili Cariyi Sil" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Silinen cariler -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Silinen Cariler" FontSize="15" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Silinenler}" SelectedItem="{Binding SeciliSilinen}"
                          Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KODU" Binding="{Binding Kod}" Width="110"/>
                        <DataGridTextColumn Header="AD SOYAD / ÜNVAN" Binding="{Binding Unvan}" Width="*"/>
                        <DataGridTextColumn Header="SİLİNME TARİHİ" Binding="{Binding SilinmeTarihi, Converter={StaticResource UtcYerelTarih}}" Width="140"/>
                        <DataGridTextColumn Header="NEDEN" Binding="{Binding SilinmeNedeni}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="2" Command="{Binding GeriAlKomutu}" Style="{StaticResource IkinciDugme}"
                        Margin="0,12,0,0" HorizontalAlignment="Right" Width="200">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↩" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Seçili Cariyi Geri Al" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
