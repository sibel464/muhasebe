<UserControl x:Class="Masaustu.Gorunumler.Sayfa.CariSilSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
             Background="Transparent">

    <UserControl.Resources>
        <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. ÜST PANEL: Başlık -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="10" Background="#FEF2F2" Margin="0,0,16,0">
                        <TextBlock Text="🗑️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cari Silme İşlemi" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Silmek istediğiniz cari kaydı arayıp seçin." FontSize="13" Foreground="#6B7280"/>
                    </StackPanel>
                </StackPanel>

                <!-- Arama Kutusu -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cari Ara:" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Grid>
                        <TextBox Style="{StaticResource ModernMetinKutusu}" Width="300" Height="40" Padding="36,0,8,0"
                                 Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="🔍" Foreground="#9CA3AF" FontSize="16" 
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. ORTA PANEL: Arama Sonuçları -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="24">
            <Border.Effect>
                <DropShadowEffect Color="#000" BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Kayıtlar (Silmek için birini seçin)" FontSize="16" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding AramaSonuclari}" 
                          SelectedItem="{Binding SeciliCari}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" SelectionMode="Single"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KODU" Binding="{Binding Kod}" Width="100" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="AD SOYAD / UNVAN" Binding="{Binding Unvan}" Width="*"/>
                        <DataGridTextColumn Header="VERGİ/TC NO" Binding="{Binding VergiNo}" Width="120"/>
                        <DataGridTextColumn Header="İL" Binding="{Binding Il}" Width="100"/>
                        <DataGridTextColumn Header="BAKİYE" Binding="{Binding Bakiye, StringFormat={}{0:N2} ₺}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#4B5563"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Alt İşlem Paneli -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                            Visibility="{Binding HataMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                        <TextBlock Text="{Binding HataMesaji}" Foreground="#DC2626" FontSize="13"/>
                    </Border>
                    <Border Background="#ECFDF5" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                            Visibility="{Binding BasariMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                        <TextBlock Text="{Binding BasariMesaji}" Foreground="#059669" FontSize="13" FontWeight="SemiBold"/>
                    </Border>

                    <Button Command="{Binding SilKomutu}" Width="200" Height="48" HorizontalAlignment="Right"
                            Background="#EF4444" Foreground="White" FontSize="15" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🗑️" Margin="0,0,8,0"/>
                                        <TextBlock Text="Seçili Kaydı Sil"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
