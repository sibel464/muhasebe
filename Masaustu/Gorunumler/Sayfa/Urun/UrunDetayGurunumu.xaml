<UserControl x:Class="Masaustu.Gorunumler.Sayfa.Urun.UrunDetayGurunumu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="12" Background="White" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık Barı -->
            <Border Grid.Row="0" Background="{StaticResource MenuGradient}" Padding="20,16" CornerRadius="11,11,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding PencereBasligi}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Ürün detaylarını güncelleyin."
                                   FontSize="11" Foreground="#B0FFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="✕"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#B0FFFFFF" FontSize="14" Cursor="Hand"
                            Command="{Binding IptalKomutu}"/>
                </Grid>
            </Border>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    
                    <!-- Satır 1: Resim Seçimi -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Resim Önizleme -->
                        <Border Grid.Column="0" Width="80" Height="80" CornerRadius="8" 
                                Background="{StaticResource BackgroundFirca}" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" 
                                ClipToBounds="True" HorizontalAlignment="Left">
                            <Grid>
                                <TextBlock Text="📦" FontSize="36" Foreground="{StaticResource TextMutedFirca}" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding ResimYolu}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="Ürün Görseli" Style="{StaticResource EtiketMetin}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="🖼️ Resim Seç" Command="{Binding ResimSecKomutu}"
                                        Style="{StaticResource IkinciDugme}" Height="34" Margin="0,0,8,0" Padding="10,0"/>
                                <Button Content="✕ Kaldır" Command="{Binding ResimKaldirKomutu}"
                                        Style="{StaticResource TehlikeliDugme}" Height="34" Padding="10,0"
                                        Visibility="{Binding ResimYolu, Converter={StaticResource BosBoslukDonusturucu}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Satır 2: Barkod + Kod -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Barkod" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Barkod, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormGirisKutusu}"
                                     ToolTip="Barkod okuyucu ile okutabilirsiniz."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Kısa Kod *" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Kod, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Ürün Adı -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Ürün Adı *" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormGirisKutusu}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Kategori" Style="{StaticResource EtiketMetin}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Kategoriler}" DisplayMemberPath="Ad" SelectedItem="{Binding SeciliKategori}" Style="{StaticResource FormAcilirKutu}"/>
                            <Button Grid.Column="1" Content="+" Tag="URUN_KATEGORISI" Click="TanimYonet_Click" ToolTip="Kategorileri yönet" Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Marka" Style="{StaticResource EtiketMetin}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Markalar}" DisplayMemberPath="Ad" SelectedItem="{Binding SeciliMarka}" Style="{StaticResource FormAcilirKutu}"/>
                            <Button Grid.Column="1" Content="+" Tag="MARKA" Click="TanimYonet_Click" ToolTip="Markaları yönet" Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Birim" Style="{StaticResource EtiketMetin}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Birimler}" DisplayMemberPath="Ad" SelectedItem="{Binding SeciliBirim}" Style="{StaticResource FormAcilirKutu}"/>
                            <Button Grid.Column="1" Content="+" Tag="BIRIM" Click="TanimYonet_Click" ToolTip="Birimleri yönet" Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Fiyat ve Stok Bilgileri" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,4,0,10"/>

                    <!-- Fiyatlar -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Alış Fiyatı (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding AlisFiyati, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Toptan Satış (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding ToptanSatisFiyati, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Perakende ve KDV -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Perakende Satış (₺) *" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding PerakendeSatisFiyati, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="KDV Oranı (%)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding KdvOrani, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Stok Bilgileri -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Güncel Stok" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding StokMiktari, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Minimum Stok Uyarısı" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding MinimumStok, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormGirisKutusu}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Durum -->
                    <CheckBox Content="Ürün Aktif (Satışa Açık)" IsChecked="{Binding Aktif}"
                              FontSize="13" Foreground="{StaticResource TextPrimaryFirca}" Margin="0,4,0,14"/>

                    <Border Background="{StaticResource DangerLightFirca}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8" 
                            Visibility="{Binding HataMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                        <TextBlock Text="{Binding HataMesaji}" Foreground="{StaticResource DangerDarkFirca}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Butonlar -->
            <Border Grid.Row="2" Background="{StaticResource BackgroundFirca}" BorderBrush="{StaticResource BorderFirca}" BorderThickness="0,1,0,0" Padding="16,12" CornerRadius="0,0,11,11">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding IptalKomutu}" Content="İptal" 
                            Style="{StaticResource IkinciDugme}" Width="80" Margin="0,0,8,0"/>
                    <Button Command="{Binding KaydetKomutu}" Style="{StaticResource BirinciDugme}" Width="100">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kaydet" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>
