<Window x:Class="Masaustu.Gorunumler.Sayfa.Urun.UrunDuzenlePenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
        Title="{Binding PencereBasligi}"
        Width="650" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="White">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000" BlurRadius="30" ShadowDepth="5" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık Barı -->
            <Border Grid.Row="0" Background="{StaticResource MenuGradient}" Padding="24,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding PencereBasligi}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Ürün detaylarını, barkod ve görselini tanımlayın."
                                   FontSize="11" Foreground="#80FFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="✕"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#80FFFFFF" FontSize="14" Cursor="Hand"
                            Command="{Binding IptalKomutu}"/>
                </Grid>
            </Border>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="600">
                <StackPanel Margin="24,20">
                    
                    <!-- Satır 1: Resim Seçimi -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Resim Önizleme -->
                        <Border Grid.Column="0" Width="90" Height="90" CornerRadius="8" 
                                Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" 
                                ClipToBounds="True" HorizontalAlignment="Left">
                            <Grid>
                                <TextBlock Text="📦" FontSize="40" Foreground="#9CA3AF" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding ResimYolu}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="Ürün Görseli" Style="{StaticResource EtiketMetin}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="🖼️ Resim Seç" Command="{Binding ResimSecKomutu}"
                                        Width="120" Height="36" Margin="0,0,8,0"
                                        Background="#EEF2FF" BorderThickness="0" Foreground="#4F46E5"
                                        FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                                <Button Content="✕ Kaldır" Command="{Binding ResimKaldirKomutu}"
                                        Width="90" Height="36"
                                        Background="#FEF2F2" BorderThickness="0" Foreground="#DC2626"
                                        FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                        Visibility="{Binding ResimYolu, Converter={StaticResource BosBoslukDonusturucu}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Satır 2: Barkod + Kod -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Barkod" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Barkod, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40"
                                     ToolTip="Barkod okuyucu ile okutabilirsiniz."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Kısa Kod *" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding Kod, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Satır 3: Ad -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Ürün Adı *" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource ModernMetinKutusu}" Height="40"/>
                    </StackPanel>

                    <!-- Satır 4: Merkezi ürün tanımları -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Kategori" Style="{StaticResource EtiketMetin}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Kategoriler}" DisplayMemberPath="Ad" SelectedItem="{Binding SeciliKategori}" Height="40"/>
                                <Button Grid.Column="1" Content="+" Tag="URUN_KATEGORISI" Click="TanimYonet_Click" Margin="4,0,0,0" ToolTip="Kategorileri yönet"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Marka" Style="{StaticResource EtiketMetin}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Markalar}" DisplayMemberPath="Ad" SelectedItem="{Binding SeciliMarka}" Height="40"/>
                                <Button Grid.Column="1" Content="+" Tag="MARKA" Click="TanimYonet_Click" Margin="4,0,0,0" ToolTip="Markaları yönet"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Birim" Style="{StaticResource EtiketMetin}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Birimler}" DisplayMemberPath="Ad" SelectedItem="{Binding SeciliBirim}" Height="40"/>
                                <Button Grid.Column="1" Content="+" Tag="BIRIM" Click="TanimYonet_Click" Margin="4,0,0,0" ToolTip="Birimleri yönet"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Satır 5: Fiyatlar (Toptan / Perakende) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Alış (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding AlisFiyati, UpdateSourceTrigger=PropertyChanged, StringFormat='N2', ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Toptan (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding ToptanSatisFiyati, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Perakende (₺)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding PerakendeSatisFiyati, UpdateSourceTrigger=PropertyChanged, StringFormat='N2', ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="KDV (%)" Style="{StaticResource EtiketMetin}"/>
                            <ComboBox ItemsSource="{Binding KdvOranlari}"
                                      SelectedItem="{Binding KdvOrani}"
                                      Height="40" FontSize="13" Padding="6,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Satır 6: Stok -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Mevcut Stok Miktarı" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding StokMiktari, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Minimum Stok (Uyarı Seviyesi)" Style="{StaticResource EtiketMetin}"/>
                            <TextBox Text="{Binding MinimumStok, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernMetinKutusu}" Height="40"/>
                        </StackPanel>
                    </Grid>

                    <!-- Aktif -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox IsChecked="{Binding Aktif}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Ürün aktif (Satışa uygun)" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Hata Mesajı -->
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="12,8"
                            Margin="0,8,0,0"
                            Visibility="{Binding HataMesaji, Converter={StaticResource BosBoslukDonusturucu}}">
                        <TextBlock Text="{Binding HataMesaji}" Foreground="#DC2626" FontSize="12"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Alt Düğmeler -->
            <Border Grid.Row="2" Background="#F9FAFB"
                    BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="İptal" Command="{Binding IptalKomutu}"
                            Width="90" Height="38" Margin="0,0,8,0"
                            Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                            Foreground="#374151" FontSize="13" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="8"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="{Binding Kaydediliyor, Converter={x:Static yardimci:KaydediliyorMetinDonusturucu.Ornek}}"
                            Command="{Binding KaydetKomutu}"
                            Width="110" Height="38"
                            Style="{StaticResource AnaDugme}" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
