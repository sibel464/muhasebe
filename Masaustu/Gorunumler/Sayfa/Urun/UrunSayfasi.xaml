<UserControl x:Class="Masaustu.Gorunumler.Sayfa.UrunSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:yardimcilar="clr-namespace:Masaustu.Yardimcilar"
             xmlns:urun="clr-namespace:Masaustu.Gorunumler.Sayfa.Urun"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1024"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimcilar:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/> <!-- Master-Detail Yan Panel -->
        </Grid.ColumnDefinitions>

        <!-- LİSTE ALANI (Master) -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 1. Başlık ve Aksiyonlar -->
                <RowDefinition Height="Auto"/> <!-- 2. Filtre Barı -->
                <RowDefinition Height="*"/>    <!-- 3. DataGrid Listesi -->
                <RowDefinition Height="Auto"/> <!-- 4. Alt Seçili Satır Aksiyonları -->
            </Grid.RowDefinitions>

            <!-- 1. ÜST PANEL: Başlık ve Aksiyon Butonları -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource BaslikIkonKutusu}">
                        <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Stok &amp; Ürün Yönetimi" Style="{StaticResource SayfaBasligi}"/>
                        <TextBlock Text="Stok envanteri, birim fiyatlar, kritik stok seviyeleri ve hareket geçmişi." Style="{StaticResource SayfaAltBaslik}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Sağ Üst Aksiyonlar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding YenileKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Yenile" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding YeniEkleKomutu}" Style="{StaticResource BirinciDugme}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Yeni Ürün Ekle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. FİLTRELEME BARI -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                    BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Ürün Adı Ara" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Style="{StaticResource FiltreKutusu}" Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Barkod / Ürün Kodu" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Style="{StaticResource FiltreKutusu}" Text="{Binding AramaKodu, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Kategori" Style="{StaticResource EtiketMetin}"/>
                        <TextBox Style="{StaticResource FiltreKutusu}" Text="{Binding AramaKategori, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Hızlı Filtre Checkbox'ları -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="0,0,0,8" Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding SadeceAktifler}" Content="Sadece Aktifler" 
                                  Foreground="{StaticResource TextPrimaryFirca}" FontSize="12" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding SadeceKritikStok}" Content="⚠️ Kritik Stok"
                                  Foreground="{StaticResource DangerDarkFirca}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. DATAGRID TABLO -->
            <Border Grid.Row="2" Background="White" CornerRadius="10"
                    BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Urunler}" 
                          SelectedItem="{Binding SeciliUrun, Mode=TwoWay}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ÜRÜN KODU" Binding="{Binding Kod}" Width="120" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="BARKOD" Binding="{Binding Barkod}" Width="110"/>
                        <DataGridTextColumn Header="ÜRÜN ADI" Binding="{Binding Ad}" Width="2*"/>
                        <DataGridTextColumn Header="KATEGORİ" Binding="{Binding Kategori}" Width="110"/>
                        <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="2*"/>
                        <DataGridTextColumn Header="BİRİM" Binding="{Binding Birim}" Width="70"/>
                        <DataGridTextColumn Header="ALIŞ FİYATI" Binding="{Binding AlisFiyati, StringFormat='{}{0:N2} ₺'}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryFirca}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="SATIŞ FİYATI" Binding="{Binding PerakendeSatisFiyati, StringFormat='{}{0:N2} ₺'}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryDarkFirca}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="STOK MİKTARI" Binding="{Binding StokMiktari, StringFormat='{}{0:N2}'}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="MİN. STOK" Binding="{Binding MinimumStok, StringFormat='{}{0:N2}'}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedFirca}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 4. ALT SEÇİLİ SATIR AKSİYON BARI -->
            <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="14,10" Margin="0,12,0,0"
                    BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Seçili Ürün:" FontSize="13" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SeciliUrun.Ad}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding StoklarKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Stok Hareketleri" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding DuzenleKomutu}" Style="{StaticResource BirinciDugme}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✏️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Düzenle" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SilKomutu}" Style="{StaticResource TehlikeliDugme}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sil" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- MASTER-DETAIL DÜZENLEME PANELİ -->
        <Border Grid.Column="1" Width="380" Background="White" CornerRadius="12" Padding="20" Margin="16,0,0,0"
                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1"
                Visibility="{Binding FormAcik, Converter={StaticResource BoolToVis}}">
            <urun:UrunDetayGurunumu DataContext="{Binding FormGorunumModeli}"/>
        </Border>
    </Grid>
</UserControl>
