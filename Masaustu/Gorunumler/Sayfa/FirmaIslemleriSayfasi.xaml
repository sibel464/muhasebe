<UserControl x:Class="Masaustu.Gorunumler.Sayfa.FirmaIslemleriSayfasi" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="#F6F8FC" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="FİRMA İŞLEMLERİ" FontSize="25" FontWeight="Bold"/><TextBlock Text="Kayıtlı firmalarınızı, şubelerinizi ve mali dönemlerinizi yönetin." Foreground="#64748B"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="+ Yeni Firma" Command="{Binding YeniKomutu}" Padding="18,9"/><Button Content="Yenile" Command="{Binding YenileKomutu}" Padding="18,9" Margin="8,0,0,0"/></StackPanel></Grid>
  <Grid Grid.Row="1" Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="Toplam Firma" Foreground="#64748B"/><TextBlock Text="{Binding ToplamFirma}" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="Aktif Firma" Foreground="#64748B"/><TextBlock Text="{Binding AktifFirma}" FontSize="22" FontWeight="Bold"/></StackPanel></Border></Grid>
  <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Arama,UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="10"/><Button Grid.Column="1" Content="Ara" Command="{Binding YenileKomutu}" Padding="20,8" Margin="8,0,0,0"/></Grid>
  <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Firmalar}" SelectedItem="{Binding SeciliFirma}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Firma Kodu" Binding="{Binding SirketKodu}" Width="130"/><DataGridTextColumn Header="Firma Ünvanı" Binding="{Binding Unvan}" Width="*"/><DataGridTextColumn Header="VKN / TCKN" Binding="{Binding VergiNo}" Width="130"/><DataGridTextColumn Header="Vergi Dairesi" Binding="{Binding VergiDairesi}" Width="150"/><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding AktifMi}" Width="70"/><DataGridTemplateColumn Header="İşlemler" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Düzenle" Click="Duzenle_Click" Padding="8,3"/><Button Content="Aktif/Pasif" Command="{Binding DataContext.DurumKomutu,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="8,3" Margin="5,0,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Grid.Row="1" Text="{Binding Mesaj}" Foreground="#047857" FontWeight="SemiBold" Margin="0,10,0,0"/></Grid>
  <Grid Grid.Row="3" Background="#F6F8FC">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,10,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <DockPanel Margin="4,2,4,10"><TextBlock Text="FİRMALAR" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/><Button Content="Düzenle" Command="{Binding DuzenleKomutu}" Padding="14,6" HorizontalAlignment="Right"/></DockPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Firmalar}" SelectedItem="{Binding SeciliFirma}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
      <DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding SirketKodu}" Width="110"/><DataGridTextColumn Header="Firma Ünvanı" Binding="{Binding Unvan}" Width="*"/><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding AktifMi}" Width="55"/></DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="4,0,4,10"><TextBlock Text="{Binding SeciliFirma.Unvan,TargetNullValue=Firma seçilmedi}" FontSize="19" FontWeight="Bold"/><TextBlock Foreground="#64748B"><Run Text="Firma kodu: "/><Run Text="{Binding SeciliFirma.SirketKodu}"/><Run Text="   •   VKN/TCKN: "/><Run Text="{Binding SeciliFirma.VergiNo,TargetNullValue=-}"/></TextBlock></StackPanel>
     <TabControl Grid.Row="1">
      <TabItem Header="Şubeler"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><TextBlock Text="Firma şubeleri ve operasyon merkezleri" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="+ Yeni Şube" Command="{Binding YeniSubeKomutu}" Padding="12,5" HorizontalAlignment="Right"/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Subeler}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding SubeKodu}" Width="90"/><DataGridTextColumn Header="Şube Adı" Binding="{Binding SubeAdi}" Width="*"/><DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="120"/><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding AktifMi}" Width="55"/><DataGridTemplateColumn Header="İşlem" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Düzenle" Command="{Binding DataContext.SubeDuzenleKomutu,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/><Button Content="Durum" Command="{Binding DataContext.SubeDurumKomutu,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="4,0,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="Mali Dönemler"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><TextBlock Text="Muhasebe dönemleri ve işlem kilitleri" FontWeight="SemiBold"/><Button Content="+ Yeni Dönem" Command="{Binding YeniDonemKomutu}" Padding="12,5" HorizontalAlignment="Right"/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding MaliDonemler}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Dönem" Binding="{Binding DonemAdi}" Width="*"/><DataGridTextColumn Header="Başlangıç" Binding="{Binding Baslangic,StringFormat=dd.MM.yyyy}" Width="100"/><DataGridTextColumn Header="Bitiş" Binding="{Binding Bitis,StringFormat=dd.MM.yyyy}" Width="100"/><DataGridCheckBoxColumn Header="Kilitli" Binding="{Binding KilitliMi}" Width="55"/><DataGridTemplateColumn Header="İşlem" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Düzenle" Command="{Binding DataContext.DonemDuzenleKomutu,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/><Button Content="Kilitle/Aç" Command="{Binding DataContext.DonemKilitKomutu,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="4,0,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="Belge Serileri"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><TextBlock Text="Fatura, sipariş ve irsaliye numaraları" FontWeight="SemiBold"/><Button Content="+ Yeni Seri" Command="{Binding YeniSeriKomutu}" Padding="12,5" HorizontalAlignment="Right"/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding BelgeSerileri}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Belge Tipi" Binding="{Binding BelgeTipi}" Width="*"/><DataGridTextColumn Header="Seri" Binding="{Binding Seri}" Width="65"/><DataGridTextColumn Header="Ön Ek" Binding="{Binding Prefix}" Width="80"/><DataGridTextColumn Header="Son No" Binding="{Binding SonNumara}" Width="75"/><DataGridTemplateColumn Header="İşlem" Width="175"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Düzenle" Command="{Binding DataContext.SeriDuzenleKomutu,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/><Button Content="No Üret" Command="{Binding DataContext.NumaraOnizleKomutu,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="4,0,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem>
     </TabControl>
     <Border Grid.Row="2" Background="#EFF6FF" CornerRadius="6" Padding="10" Margin="0,10,0,0"><TextBlock Text="{Binding Mesaj}" Foreground="#1D4ED8" TextWrapping="Wrap"/></Border>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
