<UserControl x:Class="Masaustu.Gorunumler.Sayfa.AyarlarSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:yardimci="clr-namespace:Masaustu.Yardimcilar"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1024"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <yardimci:BosBoslukDonusturucu x:Key="BosBoslukDonusturucu"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ÜST PANEL: Başlık -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource BaslikIkonKutusu}">
                    <TextBlock Text="⚙️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sistem Yönetimi &amp; Güvenlik" Style="{StaticResource SayfaBasligi}"/>
                    <TextBlock Text="Firma bilgileri, vergi parametreleri, yazıcı şablonları ve Audit Log güvenlik geçmişi." Style="{StaticResource SayfaAltBaslik}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- SEKMELİ YÖNETİM ALANI -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: SİSTEM VE FİRMA AYARLARI -->
            <TabItem Header="🏢 Firma &amp; Parametreler" FontSize="13" FontWeight="SemiBold" Padding="16,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">

                        <!-- 1. FİRMA KÜNYE BİLGİLERİ -->
                        <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🏢 Resmi Firma Künye Bilgileri" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}" Margin="0,0,0,4"/>
                                <TextBlock Text="Fatura, irsaliye ve fişlerde yer alan resmi şirket kimliği." FontSize="12" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,0,14"/>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Firma Ünvanı *" Style="{StaticResource EtiketMetin}"/>
                                    <TextBox Text="{Binding FirmaUnvani, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Vergi Dairesi" Style="{StaticResource EtiketMetin}"/>
                                        <TextBox Text="{Binding VergiDairesi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Vergi Numarası" Style="{StaticResource EtiketMetin}"/>
                                        <TextBox Text="{Binding VergiNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Telefon" Style="{StaticResource EtiketMetin}"/>
                                        <TextBox Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="E-posta" Style="{StaticResource EtiketMetin}"/>
                                        <TextBox Text="{Binding Eposta, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Web Sitesi" Style="{StaticResource EtiketMetin}"/>
                                        <TextBox Text="{Binding WebSitesi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Mersis / Sicil No" Style="{StaticResource EtiketMetin}"/>
                                        <TextBox Text="{Binding MersisNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <TextBlock Text="Firma Açık Adresi" Style="{StaticResource EtiketMetin}"/>
                                    <TextBox Text="{Binding Adres, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. BELGE VE YAZICI ŞABLON AYARLARI -->
                        <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🖨️ Belge, Fatura &amp; Fiş Şablon Metinleri" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryFirca}" Margin="0,0,0,4"/>
                                <TextBlock Text="Yazdırılan dökümlerde alt bilgi ve para birimi görünümü." FontSize="12" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Varsayılan Para Birimi" Style="{StaticResource EtiketMetin}"/>
                                        <TextBox Text="{Binding ParaBirimiKodu, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Varsayılan KDV Oranı (%)" Style="{StaticResource EtiketMetin}"/>
                                        <TextBox Text="{Binding VarsayilanKdv, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Fatura Alt Bilgi (Footer Notu)" Style="{StaticResource EtiketMetin}"/>
                                    <TextBox Text="{Binding FaturaNotu, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="İrsaliye Alt Bilgi" Style="{StaticResource EtiketMetin}"/>
                                    <TextBox Text="{Binding IrsaliyeNotu, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Makbuz Alt Notu" Style="{StaticResource EtiketMetin}"/>
                                    <TextBox Text="{Binding FisFooter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormGirisKutusu}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- KAYDET BUTONU & DURUM BİLDİRİMİ -->
                        <Border Background="White" CornerRadius="10" Padding="14,12" Margin="0,0,0,24"
                                BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,260,0">
                                    <TextBlock Text="{Binding BasariMesaji}" Foreground="{StaticResource SuccessDarkFirca}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding HataMesaji}" Foreground="#DC3545" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Command="{Binding KaydetKomutu}" Style="{StaticResource BirinciDugme}" HorizontalAlignment="Right" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sistem Ayarlarını Kaydet" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: AUDIT LOG & GÜVENLİK İZLEME -->
            <TabItem Header="🛡️ Audit Log &amp; Güvenlik İzleme" FontSize="13" FontWeight="SemiBold" Padding="16,8">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Audit Filtre Barı -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,14"
                            BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Tablo / Entity Adı" Style="{StaticResource EtiketMetin}"/>
                                <TextBox Style="{StaticResource FiltreKutusu}" Text="{Binding AuditTabloArama, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Kullanıcı / Aktör" Style="{StaticResource EtiketMetin}"/>
                                <TextBox Style="{StaticResource FiltreKutusu}" Text="{Binding AuditKullaniciArama, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Command="{Binding AuditLoglariYenileKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" Margin="0,0,6,0"/>
                                        <TextBlock Text="Filtrele"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AuditLoglariYenileKomutu}" Style="{StaticResource UtilityDugme}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄" Margin="0,0,6,0"/>
                                        <TextBlock Text="Tümünü Getir"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Audit Log Tablosu -->
                    <Border Grid.Row="1" Background="White" CornerRadius="10"
                            BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding AuditLoglar}"
                                  Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="ZAMAN" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="140"/>
                                <DataGridTextColumn Header="İŞLEM TÜRÜ" Binding="{Binding IslemTuru}" Width="100" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="TABLO" Binding="{Binding TabloAdi}" Width="120"/>
                                <DataGridTextColumn Header="KAYIT ID" Binding="{Binding KayitId}" Width="80"/>
                                <DataGridTextColumn Header="KULLANICI" Binding="{Binding KullaniciAdi}" Width="110"/>
                                <DataGridTextColumn Header="DETAY" Binding="{Binding IslemDetayi}" Width="220"/>
                                <DataGridTextColumn Header="YENİ DEĞER (JSON)" Binding="{Binding YeniDegerJson}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="💾 Yedekleme" FontSize="13" FontWeight="SemiBold" Padding="16,8">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,14" Margin="0,0,0,14"
                            BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Veritabanı Yedekleri" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding YedekBilgisi}" TextWrapping="Wrap" FontWeight="Normal" Foreground="{StaticResource TextSecondaryFirca}"/>
                                <TextBlock TextWrapping="Wrap" FontWeight="Normal" Foreground="{StaticResource TextSecondaryFirca}" Margin="0,4,0,0">
                                    <Run Text="Yedek klasörü:"/>
                                    <Run Text="{Binding YedekKlasoru, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Text="{Binding YedekDurumu}" TextWrapping="Wrap" FontSize="13" Margin="0,10,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                <Button Command="{Binding YedekKlasoruAcKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📂" Margin="0,0,6,0"/>
                                        <TextBlock Text="Klasörü Aç"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DosyadanGeriYukleKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0"
                                        ToolTip="Başka bir klasördeki / USB bellekteki yedeği geri yükle">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📥" Margin="0,0,6,0"/>
                                        <TextBlock Text="Dosyadan Geri Yükle"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SeciliYedegiGeriYukleKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0"
                                        ToolTip="Listede seçili yedeği geri yükle">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏪" Margin="0,0,6,0"/>
                                        <TextBlock Text="Seçili Yedeği Geri Yükle"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding YedekAlKomutu}" Style="{StaticResource BirinciDugme}" Padding="16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾" Margin="0,0,6,0"/>
                                        <TextBlock Text="Şimdi Yedek Al"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="10"
                            BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding Yedekler}" SelectedItem="{Binding SeciliYedek}" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TARİH" Binding="{Binding OlusturmaTarihi, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                                <DataGridTextColumn Header="BOYUT" Binding="{Binding BoyutMetni}" Width="100"/>
                                <DataGridTextColumn Header="DOSYA" Binding="{Binding DosyaAdi}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="🔑 Lisans" FontSize="13" FontWeight="SemiBold" Padding="16,8">
                <StackPanel Margin="0,16,0,0" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Lisans" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LisansDurumMetni" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12"/>
                    <Button Content="Lisans Bilgisi / Lisans Yükle..." Click="Lisans_Click" Height="40" Width="260" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="🌐 Ağ" FontSize="13" FontWeight="SemiBold" Padding="16,8">
                <StackPanel Margin="0,16,0,0" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Ağ (Çok Kullanıcılı Kullanım)" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="AgDurumMetni" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12"/>
                    <Button Content="Ağ Ayarları..." Click="AgAyarlari_Click" Height="40" Width="260" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Tanımlar" FontSize="13" FontWeight="SemiBold" Padding="16,8">
                <StackPanel Margin="0,16,0,0" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Merkezi Tanımlar" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2">
                        <Button Content="Cari Tipleri" Click="CariTipleri_Click" Height="42" Margin="0,0,10,10"/>
                        <Button Content="Ürün Kategorileri" Tag="URUN_KATEGORISI" Click="MerkeziTanim_Click" Height="42" Margin="0,0,10,10"/>
                        <Button Content="Markalar" Tag="MARKA" Click="MerkeziTanim_Click" Height="42" Margin="0,0,10,10"/>
                        <Button Content="Birimler" Tag="BIRIM" Click="MerkeziTanim_Click" Height="42" Margin="0,0,10,10"/>
                    </UniformGrid>
                    <TextBlock Text="Şube ve depo tanımları şirket/şube bağlamı üzerinden yönetilir." Foreground="{StaticResource TextSecondaryFirca}" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
