<UserControl x:Class="Masaustu.Gorunumler.Sayfa.Muhasebe.MizanSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ÜST BAŞLIK -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource BaslikIkonKutusu}">
                    <TextBlock Text="⚖️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GENEL VE DÖNEMSEL MİZAN" Style="{StaticResource SayfaBasligi}"/>
                    <TextBlock Text="Bütün Hesapların Toplam Borç/Alacak ve Borç/Alacak Bakiye Denetimi" Style="{StaticResource SayfaAltBaslik}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ExcelAktarKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" Margin="0,0,6,0"/>
                        <TextBlock Text="Excel"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding PdfAktarKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" Margin="0,0,6,0"/>
                        <TextBlock Text="PDF"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding YenileKomutu}" Style="{StaticResource IkinciDugme}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0"/>
                        <TextBlock Text="Yenile"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. DATAGRID MİZAN -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Mizan.Satirlar}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hesap Kodu" Binding="{Binding HesapKodu}" Width="140" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Hesap Adı" Binding="{Binding HesapAdi}" Width="*"/>
                    <DataGridTextColumn Header="Borç Toplamı" Binding="{Binding BorcToplam, StringFormat={}{0:N2} TL}" Width="150" ElementStyle="{StaticResource SagHizaliMetin}"/>
                    <DataGridTextColumn Header="Alacak Toplamı" Binding="{Binding AlacakToplam, StringFormat={}{0:N2} TL}" Width="150" ElementStyle="{StaticResource SagHizaliMetin}"/>
                    <DataGridTextColumn Header="Borç Bakiye" Binding="{Binding BorcBakiye, StringFormat={}{0:N2} TL}" Width="150" FontWeight="Bold" ElementStyle="{StaticResource SagHizaliMetin}"/>
                    <DataGridTextColumn Header="Alacak Bakiye" Binding="{Binding AlacakBakiye, StringFormat={}{0:N2} TL}" Width="150" FontWeight="Bold" ElementStyle="{StaticResource SagHizaliMetin}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 3. DURUM BARI -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding DurumMesaji}" Foreground="#64748B" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
