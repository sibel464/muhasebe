<UserControl x:Class="Masaustu.Gorunumler.Sayfa.Muhasebe.MuhasebeBaglantiSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ÜST BAŞLIK -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource BaslikIkonKutusu}">
                    <TextBlock Text="⚙️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MUHASEBE BAĞLANTI KODLARI" Style="{StaticResource SayfaBasligi}"/>
                    <TextBlock Text="Ticari İşlem Kategorilerinin Varsayılan Muhasebe Hesap Eşleşmeleri" Style="{StaticResource SayfaAltBaslik}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding KaydetKomutu}" Style="{StaticResource BirinciDugme}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" Margin="0,0,6,0"/>
                        <TextBlock Text="Değişiklikleri Kaydet"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding YenileKomutu}" Style="{StaticResource IkinciDugme}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0"/>
                        <TextBlock Text="Yenile"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. DATAGRID BAĞLANTI KODLARI -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Kodlar}" 
                      SelectedItem="{Binding SeciliKod}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="38">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kategori Kodu" Binding="{Binding KategoriKodu}" Width="150" IsReadOnly="True" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Kategori Adı" Binding="{Binding KategoriAdi}" Width="220" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Varsayılan Hesap Kodu" Binding="{Binding VarSayilanHesapKodu}" Width="180" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding AktifMi}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 3. DURUM BARI -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding DurumMesaji}" Foreground="#64748B" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
