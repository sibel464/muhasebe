<Window x:Class="Masaustu.Gorunumler.Sayfa.Muhasebe.PersonelPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Baslik}" Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="20,16">
        <TextBlock Text="{Binding Baslik}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                <TextBlock Text="Ad soyad *" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding AdSoyad}" Style="{StaticResource FormMetinKutusu}" MaxLength="200"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                <TextBlock Text="Kod (boş bırakılırsa verilir)" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding Kod}" Style="{StaticResource FormMetinKutusu}" MaxLength="50"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                <TextBlock Text="T.C. kimlik no" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding TcKimlikNo}" Style="{StaticResource FormMetinKutusu}" MaxLength="11"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                <TextBlock Text="Görev" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding Gorev}" Style="{StaticResource FormMetinKutusu}" MaxLength="100"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                <TextBlock Text="Departman" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding Departman}" Style="{StaticResource FormMetinKutusu}" MaxLength="100"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                <TextBlock Text="Ücret gider hesabı *" Style="{StaticResource EtiketMetni}"/>
                <ComboBox ItemsSource="{Binding GiderHesaplari}" SelectedItem="{Binding GiderHesabi}" Style="{StaticResource FormComboBox}"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,10">
                <TextBlock Text="İşe giriş tarihi *" Style="{StaticResource EtiketMetni}"/>
                <DatePicker SelectedDate="{Binding IseGirisTarihi}"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,10">
                <TextBlock Text="İşten çıkış tarihi (ayrıldıysa)" Style="{StaticResource EtiketMetni}"/>
                <DatePicker SelectedDate="{Binding IstenCikisTarihi}"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,10">
                <TextBlock Text="Telefon" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding Telefon}" Style="{StaticResource FormMetinKutusu}" MaxLength="30"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,10">
                <TextBlock Text="E-posta" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding Eposta}" Style="{StaticResource FormMetinKutusu}" MaxLength="200"/>
            </StackPanel>
            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,10">
                <TextBlock Text="IBAN (maaş hesabı)" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding Iban}" Style="{StaticResource FormMetinKutusu}" MaxLength="40"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="AYLIK ÜCRET (bordrodaki tutarlar)" FontWeight="Bold" Foreground="#334155" Margin="0,4,0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,8"
                   Text="Tutarları mali müşavirinizin hazırladığı bordrodan yazın. Maaş tahakkukunda bu tutarlar önerilir ve her tahakkukta son tutarlarla güncellenir."/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                <TextBlock Text="Net ücret (TL)" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding NetUcret, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormMetinKutusu}"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                <TextBlock Text="Gelir vergisi" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding GelirVergisi, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormMetinKutusu}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                <TextBlock Text="SGK işçi payı" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding SgkIsciPayi, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormMetinKutusu}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                <TextBlock Text="Damga vergisi" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding DamgaVergisi, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormMetinKutusu}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                <TextBlock Text="İşsizlik sigortası işçi payı" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding IssizlikIsciPayi, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormMetinKutusu}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                <TextBlock Text="SGK işveren payı" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding SgkIsverenPayi, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormMetinKutusu}"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,10">
                <TextBlock Text="İşsizlik sigortası işveren payı" Style="{StaticResource EtiketMetni}"/>
                <TextBox Text="{Binding IssizlikIsverenPayi, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormMetinKutusu}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding UcretOzeti}" FontWeight="SemiBold" Foreground="#1E3A8A" Margin="0,0,0,10"/>
        <TextBlock Text="Açıklama" Style="{StaticResource EtiketMetni}"/>
        <TextBox Text="{Binding Aciklama}" Style="{StaticResource FormMetinKutusu}" MaxLength="500"/>

        <TextBlock Text="{Binding Hata}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Vazgeç" IsCancel="True" Style="{StaticResource IkinciDugme}" Width="110" Margin="0,0,10,0"/>
            <Button Content="Kaydet" IsDefault="True" Command="{Binding KaydetKomutu}" Style="{StaticResource BirinciDugme}" Width="110"/>
        </StackPanel>
    </StackPanel>
</Window>
