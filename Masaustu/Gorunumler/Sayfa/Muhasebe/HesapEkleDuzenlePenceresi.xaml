<Window x:Class="Masaustu.Gorunumler.Sayfa.Muhasebe.HesapEkleDuzenlePenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding PencereBasligi}" Height="600" Width="480" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </Window.Resources>
    
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding KapatKomutu}"/>
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📋" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PencereBasligi}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- FORM -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Hesap Kodu *" Style="{StaticResource EtiketMetni}"/>
                        <TextBox Text="{Binding HesapKodu, UpdateSourceTrigger=PropertyChanged}" 
                                 IsEnabled="{Binding HesapKoduDegistirilebilir}"
                                 Style="{StaticResource FormMetinKutusu}" 
                                 MaxLength="20"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Hesap Tipi *" Style="{StaticResource EtiketMetni}"/>
                        <ComboBox ItemsSource="{Binding HesapTipleri}" 
                                  SelectedValue="{Binding SeciliHesapTipi}" 
                                  IsEnabled="{Binding KritikAlanlarDegistirilebilir}"
                                  DisplayMemberPath="Value" SelectedValuePath="Key"
                                  Style="{StaticResource FormComboBox}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Hesap Adı *" Style="{StaticResource EtiketMetni}"/>
                    <TextBox Text="{Binding HesapAdi, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource FormMetinKutusu}" 
                             MaxLength="100"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Üst Hesap" Style="{StaticResource EtiketMetni}"/>
                    <ComboBox ItemsSource="{Binding TumHesaplar}" 
                              SelectedValue="{Binding SeciliUstHesapId}" 
                              IsEnabled="{Binding KritikAlanlarDegistirilebilir}"
                              DisplayMemberPath="HesapAdKoduGosterimi" SelectedValuePath="Id"
                              Style="{StaticResource FormComboBox}"/>
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Bakiye Yönü *" Style="{StaticResource EtiketMetni}"/>
                        <ComboBox ItemsSource="{Binding BakiyeYonleri}" 
                                  SelectedValue="{Binding SeciliBakiyeYonu}" 
                                  IsEnabled="{Binding KritikAlanlarDegistirilebilir}"
                                  DisplayMemberPath="Value" SelectedValuePath="Key"
                                  Style="{StaticResource FormComboBox}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Para Birimi *" Style="{StaticResource EtiketMetni}"/>
                        <ComboBox ItemsSource="{Binding ParaBirimleri}" 
                                  SelectedItem="{Binding SeciliParaBirimi}" 
                                  IsEnabled="{Binding KritikAlanlarDegistirilebilir}"
                                  Style="{StaticResource FormComboBox}"/>
                    </StackPanel>
                </Grid>
                
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Açıklama" Style="{StaticResource EtiketMetni}"/>
                    <TextBox Text="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource FormMetinKutusu}" 
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="200"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox IsChecked="{Binding AktifMi}" Content="Hesap Aktif (Kullanılabilir)"/>
                </StackPanel>
                
                <Border Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,16,0,0"
                        Visibility="{Binding HataMesajiGorunurMu, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding HataMesaji}" Foreground="#DC2626" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding DurumMesaji}" Foreground="#16A34A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                
                <Button Grid.Column="2" Command="{Binding KapatKomutu}" Style="{StaticResource IkinciDugme}" Content="İptal" Width="100" Margin="0,0,12,0"/>
                <Button Grid.Column="3" Command="{Binding KaydetKomutu}" Content="Kaydet" Width="120">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BirinciDugme}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IslemYapiliyor}" Value="True">
                                    <Setter Property="Content" Value="Kaydediliyor..."/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
