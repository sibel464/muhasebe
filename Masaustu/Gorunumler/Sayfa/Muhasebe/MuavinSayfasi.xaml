<UserControl x:Class="Masaustu.Gorunumler.Sayfa.Muhasebe.MuavinSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ÜST BAŞLIK -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource BaslikIkonKutusu}">
                    <TextBlock Text="📑" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MUAVİN DEFTERİ" Style="{StaticResource SayfaBasligi}"/>
                    <TextBlock Text="Seçilen Hesabın Ayrıntılı Hareket Dökümü ve Yürüyen Bakiyesi" Style="{StaticResource SayfaAltBaslik}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ExcelAktarKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" Margin="0,0,6,0"/>
                        <TextBlock Text="Excel"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding PdfAktarKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" Margin="0,0,6,0"/>
                        <TextBlock Text="PDF"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding YenileKomutu}" Style="{StaticResource IkinciDugme}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0"/>
                        <TextBlock Text="Yenile"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. HESAP SEÇİM BARI -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Hesap Seçin:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,12,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Hesaplar}" SelectedItem="{Binding SeciliHesap}" DisplayMemberPath="HesapKodu" Height="36"/>
            </Grid>
        </Border>

        <!-- 3. DATAGRID MUAVİN SATIRLARI -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Muavin.Satirlar}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                    <DataGridTextColumn Header="Fiş No" Binding="{Binding FisNo}" Width="130" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Belge No" Binding="{Binding BelgeNo}" Width="120"/>
                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*"/>
                    <DataGridTextColumn Header="Borç" Binding="{Binding Borc, StringFormat={}{0:N2} TL}" Width="130" ElementStyle="{StaticResource SagHizaliMetin}"/>
                    <DataGridTextColumn Header="Alacak" Binding="{Binding Alacak, StringFormat={}{0:N2} TL}" Width="130" ElementStyle="{StaticResource SagHizaliMetin}"/>
                    <DataGridTextColumn Header="Yürüyen Bakiye" Binding="{Binding YuruyenBakiye, StringFormat={}{0:N2} TL}" Width="150" FontWeight="Bold" ElementStyle="{StaticResource SagHizaliMetin}"/>
                    <DataGridTextColumn Header="Bakiye Yönü" Binding="{Binding BakiyeYonu}" Width="110" FontWeight="Bold"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. DURUM BARI -->
        <StatusBar Grid.Row="3" Background="Transparent" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding DurumMesaji}" Foreground="#64748B" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
