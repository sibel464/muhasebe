<UserControl x:Class="Masaustu.Gorunumler.Sayfa.Muhasebe.HesapPlaniSayfasi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Style="{DynamicResource SayfaGecisAnimasyonu}"
             Background="#F8FAFC">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding HesapEkleKomutu}"/>
        <KeyBinding Key="F5" Command="{Binding YenileKomutu}"/>
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ÜST BAŞLIK ve TOOLBAR -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource BaslikIkonKutusu}">
                    <iconPacks:PackIconMaterial Kind="FolderTextOutline" Width="24" Height="24" Foreground="{StaticResource InfoDarkFirca}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HESAP PLANI" Style="{StaticResource SayfaBasligi}"/>
                    <TextBlock Text="Tekdüzen Hesap Planı Yönetimi ve Bakiye İzleme" Style="{StaticResource SayfaAltBaslik}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding HesapEkleKomutu}" Style="{StaticResource BirinciDugme}" Margin="0,0,8,0" ToolTip="Yeni Hesap Ekle (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Yeni Hesap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding HesapDuzenleKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0" ToolTip="Seçili Hesabı Düzenle">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="PencilOutline" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Düzenle" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding HesapDurumDegistirKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0" ToolTip="Seçili Hesabı Pasife Al / Aktifleştir">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Sync" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Aktif / Pasif" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding Hesap360AcKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0" ToolTip="Hesap ile ilgili tüm detayları görüntüle">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ChartPie" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Hesap 360°" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding YenileKomutu}" Style="{StaticResource UtilityDugme}" ToolTip="Listeyi Yenile (F5)">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Yenile" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. FİLTRELER -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource AramaMetinKutusu}" 
                         ToolTip="Hesap Kodu veya Hesap Adı Ara..." 
                         Margin="0,0,12,0"/>

                <ComboBox Grid.Column="1" SelectedItem="{Binding SeciliDurumFiltresi, UpdateSourceTrigger=PropertyChanged}" 
                          ItemsSource="{Binding DurumFiltreleri}"
                          Style="{StaticResource FormAcilirKutu}" Margin="0,0,12,0"/>

                <ComboBox Grid.Column="2" SelectedItem="{Binding SeciliTipFiltresi, UpdateSourceTrigger=PropertyChanged}" 
                          ItemsSource="{Binding TipFiltreleri}"
                          Style="{StaticResource FormAcilirKutu}" Margin="0,0,12,0"/>

                <CheckBox Grid.Column="3" Content="Sadece Hareket Görenler" 
                          IsChecked="{Binding SadeceHareketGorenler, UpdateSourceTrigger=PropertyChanged}" 
                          VerticalAlignment="Center" FontWeight="Medium" Foreground="{StaticResource TextPrimaryFirca}"/>
            </Grid>
        </Border>

        <!-- 3. DATA GRID & EMPTY STATE -->
        <Grid Grid.Row="2">
            <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding GosterilenHesaplar}" 
                          SelectedItem="{Binding SeciliHesap}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding Hesap360AcKomutu}" />
                        <KeyBinding Key="Enter" Command="{Binding HesapDuzenleKomutu}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="HESAP KODU" Binding="{Binding HesapKodu}" Width="150" FontWeight="Bold"/>
                        <DataGridTextColumn Header="HESAP ADI" Binding="{Binding HesapAdi}" Width="*"/>
                        <DataGridTextColumn Header="TİP" Binding="{Binding Tip}" Width="100"/>
                        <DataGridTextColumn Header="SEVİYE" Binding="{Binding Seviye}" Width="70" ElementStyle="{StaticResource SagHizaliMetin}"/>
                        <DataGridTextColumn Header="BAKİYE YÖNÜ" Binding="{Binding BakiyeYonuStr}" Width="100"/>
                        <DataGridTextColumn Header="BİRİM" Binding="{Binding ParaBirimiKodu}" Width="70" ElementStyle="{StaticResource SagHizaliMetin}"/>
                        
                        <DataGridTextColumn Header="BAKİYE" Binding="{Binding Bakiye, StringFormat={}{0:N2}}" Width="140" FontWeight="Bold" ElementStyle="{StaticResource SagHizaliMetin}"/>
                        
                        <DataGridTextColumn Header="DURUM" Binding="{Binding DurumStr}" Width="90" FontWeight="SemiBold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- EMPTY STATE -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource EmptyStatePanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GosterilenHesaplar.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <iconPacks:PackIconMaterial Kind="DatabaseRemoveOutline" Style="{StaticResource EmptyStateIkon}"/>
                <TextBlock Text="Kayıt Bulunamadı" Style="{StaticResource EmptyStateBaslik}"/>
                <TextBlock Text="Arama kriterlerinize uygun hesap bulunamadı veya henüz hesap açılmamış." Style="{StaticResource EmptyStateAciklama}"/>
            </StackPanel>

            <!-- LOADING OVERLAY -->
            <Border Style="{StaticResource LoadingOverlay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="4" Margin="0,0,0,12"/>
                    <TextBlock Text="Veriler yükleniyor..." FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. DURUM BARI -->
        <StatusBar Grid.Row="3" Background="Transparent" Margin="0,12,0,0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DurumMesaji}" Foreground="{StaticResource TextSecondaryFirca}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text=" | " Foreground="{StaticResource BorderDarkFirca}"/>
                    <TextBlock Text="💡 İpucu: Listede çift tıklayarak Hesap 360 detaylarına ulaşabilirsiniz." Foreground="{StaticResource TextMutedFirca}" FontSize="12" FontStyle="Italic"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
