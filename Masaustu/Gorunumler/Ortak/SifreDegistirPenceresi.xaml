<Window x:Class="Masaustu.Gorunumler.Ortak.SifreDegistirPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şifre Değiştir" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Background="#F8F9FA">

    <StackPanel Margin="24">
        <TextBlock x:Name="BaslikMetni" Text="Şifrenizi değiştirin" FontSize="16" FontWeight="SemiBold"
                   Foreground="#212529" Margin="0,0,0,6"/>
        <TextBlock x:Name="AciklamaMetni" TextWrapping="Wrap" FontSize="12" Foreground="#6C757D" Margin="0,0,0,16"
                   Text="Yeni şifre en az 8 karakter olmalı, harf ve rakam içermeli ve kullanıcı adınızı içermemelidir."/>

        <TextBlock Text="Mevcut şifre" FontSize="12" Foreground="#495057" Margin="0,0,0,4"/>
        <PasswordBox x:Name="MevcutSifreKutusu" Height="34" Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

        <TextBlock Text="Yeni şifre" FontSize="12" Foreground="#495057" Margin="0,0,0,4"/>
        <PasswordBox x:Name="YeniSifreKutusu" Height="34" Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

        <TextBlock Text="Yeni şifre (tekrar)" FontSize="12" Foreground="#495057" Margin="0,0,0,4"/>
        <PasswordBox x:Name="YeniSifreTekrarKutusu" Height="34" Padding="8,6" FontSize="13" Margin="0,0,0,8"/>

        <TextBlock x:Name="HataMetni" TextWrapping="Wrap" Foreground="#DC3545" FontSize="12"
                   Visibility="Collapsed" Margin="0,4,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="IptalDugmesi" Content="İptal" Width="100" Height="35" Margin="0,0,10,0"
                    Background="#E9ECEF" Foreground="#495057" BorderThickness="0"
                    Click="IptalTiklandi" Cursor="Hand" FontWeight="SemiBold"/>
            <Button x:Name="KaydetDugmesi" Content="Kaydet" Width="100" Height="35" IsDefault="True"
                    Background="#0D6EFD" Foreground="White" BorderThickness="0"
                    Click="KaydetTiklandi" Cursor="Hand" FontWeight="SemiBold"/>
        </StackPanel>
    </StackPanel>
</Window>
