<Window x:Class="Masaustu.Gorunumler.Ortak.VadeTakvimiPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vade Takvimi" Width="1180" Height="680" WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Masaustu;component/Kaynaklar/Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TutarMetni" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#B91C1C"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tahsilat}" Value="True">
                        <Setter Property="Foreground" Value="#15803D"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="GecikmeMetni" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Foreground" Value="#B91C1C"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding GecikmeGun}" Value="0">
                        <Setter Property="Visibility" Value="Hidden"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Önümüzdeki" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Gunler}" DisplayMemberPath="Ad" SelectedValuePath="Deger" SelectedValue="{Binding Gun}" Width="90" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Yonler}" SelectedItem="{Binding Yon}" Width="100" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Button Command="{Binding YenileKomutu}" Style="{StaticResource IkinciDugme}" Margin="0,0,8,0"><TextBlock Text="🔄 Yenile"/></Button>
                <Button Command="{Binding ExcelKomutu}" Style="{StaticResource IkinciDugme}"><TextBlock Text="📊 Excel"/></Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📅" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Vade Takvimi" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
            <TextBlock Text="{Binding Ozet}" FontWeight="SemiBold" Foreground="#1E3A8A" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderFirca}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Kalemler}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="VADE" Binding="{Binding Vade, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                    <DataGridTextColumn Header="YÖN" Binding="{Binding Yon}" Width="85"/>
                    <DataGridTextColumn Header="KAYNAK" Binding="{Binding Kaynak}" Width="115"/>
                    <DataGridTextColumn Header="BELGE" Binding="{Binding BelgeNo}" Width="140"/>
                    <DataGridTextColumn Header="CARİ" Binding="{Binding CariUnvan}" Width="*" MinWidth="180"/>
                    <DataGridTextColumn Header="TUTAR" Binding="{Binding Tutar, StringFormat={}{0:N2}}" Width="120" ElementStyle="{StaticResource TutarMetni}"/>
                    <DataGridTextColumn Header="GECİKME" Binding="{Binding GecikmeGun, StringFormat={}{0} gün}" Width="85" ElementStyle="{StaticResource GecikmeMetni}"/>
                    <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Aciklama}" Width="190"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Kapat" IsCancel="True" Style="{StaticResource IkinciDugme}" Width="100"/>
            <TextBlock Text="Açık faturalar, ödemeler en eski vadeden başlayarak düşüldükten sonra kalan tutarlarla listelenir; çek ve senetler portföydeki / verilmiş olanlardır. Vadesi geçmişler de listededir."
                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryFirca}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>
        <TextBlock Grid.Row="2" Text="{Binding Durum}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#334155"/>
    </Grid>
</Window>
