<Window x:Class="Masaustu.Gorunumler.Ortak.MetinGirisPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding PencereBasligi}" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FocusManager.FocusedElement="{Binding ElementName=TxtGiris}"
        WindowStyle="ToolWindow" Background="#F8F9FA">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="{Binding AciklamaMetni}" 
                   TextWrapping="Wrap" Margin="0,0,0,10"
                   FontSize="14" FontWeight="SemiBold" Foreground="#333333"/>
                   
        <TextBox Grid.Row="1" x:Name="TxtGiris" 
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Height="80"
                 Padding="10" FontSize="14" BorderBrush="#CED4DA" BorderThickness="1" />
                 
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="İptal" Width="100" Height="35" Margin="0,0,10,0"
                    Background="#E9ECEF" Foreground="#495057" BorderThickness="0"
                    Click="BtnIptal_Click" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="Onayla" Width="100" Height="35"
                    Background="#DC3545" Foreground="White" BorderThickness="0"
                    Click="BtnOnay_Click" Cursor="Hand" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
