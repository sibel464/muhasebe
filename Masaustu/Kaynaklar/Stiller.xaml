<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <!-- ═══════════════════════════════════════════════
         1. MERKEZİ RENK PALETİ (Kurumsal Slate & Indigo)
    ═══════════════════════════════════════════════ -->
    <Color x:Key="RenkPrimary">#2563EB</Color>
    <Color x:Key="RenkPrimaryDark">#1D4ED8</Color>
    <Color x:Key="RenkPrimaryLight">#EFF6FF</Color>

    <Color x:Key="RenkBackground">#F8FAFC</Color>
    <Color x:Key="RenkSurface">#FFFFFF</Color>
    <Color x:Key="RenkBorder">#E2E8F0</Color>
    <Color x:Key="RenkBorderDark">#CBD5E1</Color>

    <Color x:Key="RenkTextPrimary">#0F172A</Color>
    <Color x:Key="RenkTextSecondary">#64748B</Color>
    <Color x:Key="RenkTextMuted">#94A3B8</Color>

    <Color x:Key="RenkSuccess">#10B981</Color>
    <Color x:Key="RenkSuccessLight">#DCFCE7</Color>
    <Color x:Key="RenkSuccessDark">#166534</Color>

    <Color x:Key="RenkWarning">#F59E0B</Color>
    <Color x:Key="RenkWarningLight">#FEF3C7</Color>
    <Color x:Key="RenkWarningDark">#92400E</Color>

    <Color x:Key="RenkDanger">#EF4444</Color>
    <Color x:Key="RenkDangerLight">#FEE2E2</Color>
    <Color x:Key="RenkDangerDark">#991B1B</Color>

    <Color x:Key="RenkInfo">#3B82F6</Color>
    <Color x:Key="RenkInfoLight">#EEF2FF</Color>
    <Color x:Key="RenkInfoDark">#1E40AF</Color>

    <!-- Menü Renkleri -->
    <Color x:Key="RenkSidebar">#0F172A</Color>
    <Color x:Key="RenkSidebarHover">#1E293B</Color>
    <Color x:Key="RenkSidebarActive">#2563EB</Color>

    <!-- Fırçalar (Brushes) -->
    <SolidColorBrush x:Key="PrimaryFirca" Color="{StaticResource RenkPrimary}"/>
    <SolidColorBrush x:Key="PrimaryDarkFirca" Color="{StaticResource RenkPrimaryDark}"/>
    <SolidColorBrush x:Key="PrimaryLightFirca" Color="{StaticResource RenkPrimaryLight}"/>

    <SolidColorBrush x:Key="BackgroundFirca" Color="{StaticResource RenkBackground}"/>
    <SolidColorBrush x:Key="SurfaceFirca" Color="{StaticResource RenkSurface}"/>
    <SolidColorBrush x:Key="BorderFirca" Color="{StaticResource RenkBorder}"/>
    <SolidColorBrush x:Key="BorderDarkFirca" Color="{StaticResource RenkBorderDark}"/>

    <SolidColorBrush x:Key="TextPrimaryFirca" Color="{StaticResource RenkTextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryFirca" Color="{StaticResource RenkTextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedFirca" Color="{StaticResource RenkTextMuted}"/>

    <SolidColorBrush x:Key="SuccessFirca" Color="{StaticResource RenkSuccess}"/>
    <SolidColorBrush x:Key="SuccessLightFirca" Color="{StaticResource RenkSuccessLight}"/>
    <SolidColorBrush x:Key="SuccessDarkFirca" Color="{StaticResource RenkSuccessDark}"/>

    <SolidColorBrush x:Key="WarningFirca" Color="{StaticResource RenkWarning}"/>
    <SolidColorBrush x:Key="WarningLightFirca" Color="{StaticResource RenkWarningLight}"/>
    <SolidColorBrush x:Key="WarningDarkFirca" Color="{StaticResource RenkWarningDark}"/>

    <SolidColorBrush x:Key="DangerFirca" Color="{StaticResource RenkDanger}"/>
    <SolidColorBrush x:Key="DangerLightFirca" Color="{StaticResource RenkDangerLight}"/>
    <SolidColorBrush x:Key="DangerDarkFirca" Color="{StaticResource RenkDangerDark}"/>

    <SolidColorBrush x:Key="InfoFirca" Color="{StaticResource RenkInfo}"/>
    <SolidColorBrush x:Key="InfoLightFirca" Color="{StaticResource RenkInfoLight}"/>
    <SolidColorBrush x:Key="InfoDarkFirca" Color="{StaticResource RenkInfoDark}"/>

    <SolidColorBrush x:Key="SidebarFirca" Color="{StaticResource RenkSidebar}"/>
    <SolidColorBrush x:Key="SidebarHoverFirca" Color="{StaticResource RenkSidebarHover}"/>
    <SolidColorBrush x:Key="SidebarActiveFirca" Color="{StaticResource RenkSidebarActive}"/>

    <!-- Geriye Uyumluluk Fırçaları & Takma Adlar -->
    <SolidColorBrush x:Key="AnaRenkFirca" Color="#2563EB"/>
    <SolidColorBrush x:Key="PanelArkaPlanFirca" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="LacivertKoyuFirca" Color="#0F172A"/>
    <SolidColorBrush x:Key="LacivertOrtaFirca" Color="#1E293B"/>
    <SolidColorBrush x:Key="LacivertAcikFirca" Color="#2563EB"/>
    <SolidColorBrush x:Key="LacivertVurguFirca" Color="#3B82F6"/>
    <SolidColorBrush x:Key="BeyazAnaFirca" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GriAcikFirca" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="GriOrtaFirca" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="GriMetinFirca" Color="#64748B"/>
    <SolidColorBrush x:Key="KoyuMetinFirca" Color="#0F172A"/>
    <SolidColorBrush x:Key="VurguMaviFirca" Color="#2563EB"/>
    <SolidColorBrush x:Key="BasariYesilFirca" Color="#10B981"/>
    <SolidColorBrush x:Key="HataKirmiziFirca" Color="#EF4444"/>

    <!-- Modern TabControl Style Alias -->
    <Style x:Key="ModernTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Gradient Fırça - Menü -->
    <LinearGradientBrush x:Key="MenuGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F172A" Offset="0"/>
        <GradientStop Color="#1E293B" Offset="1"/>
    </LinearGradientBrush>

    <!-- Gradient Fırça - Giriş -->
    <LinearGradientBrush x:Key="GirisGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F172A" Offset="0"/>
        <GradientStop Color="#1E40AF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══════════════════════════════════════════════
         2. DÜĞME STİLLERİ (Button Styles)
    ═══════════════════════════════════════════════ -->

    <!-- Birinci Düğme (Primary Button) -->
    <Style x:Key="BirinciDugme" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryFirca}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDarkFirca}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ana Düğme (Primary alias) -->
    <Style x:Key="AnaDugme" TargetType="Button" BasedOn="{StaticResource BirinciDugme}"/>

    <!-- İkinci Düğme (Secondary Button) -->
    <Style x:Key="IkinciDugme" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceFirca}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkFirca}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BackgroundFirca}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TextMutedFirca}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BorderFirca}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tehlikeli Düğme (Danger Button) -->
    <Style x:Key="TehlikeliDugme" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DangerLightFirca}"/>
        <Setter Property="Foreground" Value="{StaticResource DangerDarkFirca}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="BorderBrush" Value="#FECACA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#FCA5A5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FECDD3"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Yardımcı / Utility Düğme (Muted Gray Icon Button) -->
    <Style x:Key="UtilityDugme" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BackgroundFirca}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryFirca}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderFirca}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#EDF2F7"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tablo Satır İçi Aksiyon Düğmesi (Table Action Button) -->
    <Style x:Key="TabloAksiyonDugme" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource InfoLightFirca}"/>
        <Setter Property="Foreground" Value="{StaticResource InfoDarkFirca}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mikro Sil Düğmesi (DataGrid Satır Silme) -->
    <Style x:Key="MikroSilDugme" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DangerLightFirca}"/>
        <Setter Property="Foreground" Value="{StaticResource DangerDarkFirca}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Content" Value="🗑️"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="5"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FECDD3"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Alt Panel Düğmesi (Geriye Uyumluluk) -->
    <Style x:Key="AltPanelDugme" TargetType="Button" BasedOn="{StaticResource BirinciDugme}"/>

    <!-- ═══════════════════════════════════════════════
         3. MENÜ ÖĞELERİ (Sidebar Items)
    ═══════════════════════════════════════════════ -->
    <Style x:Key="MenuAyirici" TargetType="Separator">
        <Setter Property="Background" Value="#30FFFFFF"/>
        <Setter Property="Height" Value="1"/>
    </Style>

    <Style x:Key="MenuOgeDugme" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#94A3B8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="6" Margin="6,2"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SidebarHoverFirca}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SidebarActiveFirca}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AktifMenuOgeDugme" TargetType="Button" BasedOn="{StaticResource MenuOgeDugme}">
        <Setter Property="Background" Value="{StaticResource PrimaryFirca}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ═══════════════════════════════════════════════
         4. FORM VE GİRİŞ KONTROLLERİ (Input Styles)
    ═══════════════════════════════════════════════ -->
    <Style x:Key="FormGirisKutusu" TargetType="TextBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkFirca}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryFirca}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernMetinKutusu" TargetType="TextBox" BasedOn="{StaticResource FormGirisKutusu}"/>

    <!-- Şifre Kutusu (PasswordBox) -->
    <Style x:Key="FormSifreKutusu" TargetType="PasswordBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkFirca}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryFirca}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernSifreKutusu" TargetType="PasswordBox" BasedOn="{StaticResource FormSifreKutusu}"/>

    <Style x:Key="FormAcilirKutu" TargetType="ComboBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkFirca}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ModernAcilirKutu" TargetType="ComboBox" BasedOn="{StaticResource FormAcilirKutu}"/>

    <!-- ═══════════════════════════════════════════════
         5. FİLTRELEME BARI (Filter Bar Components)
    ═══════════════════════════════════════════════ -->
    <Style x:Key="FiltreKutusu" TargetType="TextBox" BasedOn="{StaticResource FormGirisKutusu}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <Style x:Key="FiltreAcilirKutu" TargetType="ComboBox" BasedOn="{StaticResource FormAcilirKutu}">
        <Setter Property="Height" Value="36"/>
    </Style>

    <!-- ═══════════════════════════════════════════════
         6. KPI / ÖZET KART STİLLERİ (KPI Card Components)
    ═══════════════════════════════════════════════ -->
    <Style x:Key="KpiKarti" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderFirca}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.04"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KartBorder" TargetType="Border" BasedOn="{StaticResource KpiKarti}"/>

    <!-- ═══════════════════════════════════════════════
         7. DURUM ROZETLERİ (Status Badge Components)
    ═══════════════════════════════════════════════ -->
    <Style x:Key="DurumRozeti" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Başarı Rozeti (Yeşil) -->
    <Style x:Key="BasariRozeti" TargetType="Border" BasedOn="{StaticResource DurumRozeti}">
        <Setter Property="Background" Value="{StaticResource SuccessLightFirca}"/>
    </Style>

    <!-- Uyarı Rozeti (Sarı/Turuncu) -->
    <Style x:Key="UyariRozeti" TargetType="Border" BasedOn="{StaticResource DurumRozeti}">
        <Setter Property="Background" Value="{StaticResource WarningLightFirca}"/>
    </Style>

    <!-- Tehlike/İptal Rozeti (Kırmızı) -->
    <Style x:Key="HataRozeti" TargetType="Border" BasedOn="{StaticResource DurumRozeti}">
        <Setter Property="Background" Value="{StaticResource DangerLightFirca}"/>
    </Style>

    <!-- Taslak Rozeti (Gri) -->
    <Style x:Key="TaslakRozeti" TargetType="Border" BasedOn="{StaticResource DurumRozeti}">
        <Setter Property="Background" Value="#F1F5F9"/>
    </Style>

    <!-- Bilgi Rozeti (Mavi) -->
    <Style x:Key="BilgiRozeti" TargetType="Border" BasedOn="{StaticResource DurumRozeti}">
        <Setter Property="Background" Value="{StaticResource InfoLightFirca}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════
         8. METİN VE BAŞLIK HİYERARŞİSİ
    ═══════════════════════════════════════════════ -->
    <Style x:Key="SayfaBasligi" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SayfaAltBaslik" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryFirca}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="EtiketMetin" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryFirca}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- Başlık İkon Rozeti -->
    <Style x:Key="BaslikIkonKutusu" TargetType="Border">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{StaticResource InfoLightFirca}"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ═══════════════════════════════════════════════
         9. DATAGRID STİLİ (Modern Table)
    ═══════════════════════════════════════════════ -->
    <Style x:Key="ModernDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderFirca}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource BackgroundFirca}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderFirca}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="RowHeight" Value="32"/> <!-- Daha kompakt satırlar -->
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryFirca}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderFirca}"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource PrimaryLightFirca}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkFirca}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SagHizaliMetin" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AramaMetinKutusu" TargetType="TextBox" BasedOn="{StaticResource FormGirisKutusu}"/>

    <!-- ═══════════════════════════════════════════════
         10. ANİMASYONLAR VE EFEKTLER (150ms Hızlı Geçişler)
    ═══════════════════════════════════════════════ -->
    <!-- Sayfa yüklendiğinde tetiklenecek animasyon -->
    <Style x:Key="SayfaGecisAnimasyonu" TargetType="UserControl">
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                        <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,10,0,-10" To="0,0,0,0" Duration="0:0:0.15">
                            <ThicknessAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseOut" />
                            </ThicknessAnimation.EasingFunction>
                        </ThicknessAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════
         11. EMPTY STATE & LOADING STATE (Merkezi Durumlar)
    ═══════════════════════════════════════════════ -->
    <!-- Tablo Boş Durum (Empty State) Gösterimi -->
    <Style x:Key="EmptyStatePanel" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,40"/>
    </Style>

    <Style x:Key="EmptyStateIkon" TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedFirca}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="EmptyStateBaslik" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryFirca}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="EmptyStateAciklama" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedFirca}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Yükleniyor Ekranı (Loading Overlay) -->
    <Style x:Key="LoadingOverlay" TargetType="Border">
        <Setter Property="Background" Value="#A0FFFFFF"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Yukleniyor}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <!-- FORMS & INPUTS (Geriden uyumluluk için eski isimler) -->
    <Style x:Key="EtiketMetni" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryFirca}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="FormMetinKutusu" TargetType="TextBox">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="{StaticResource SurfaceFirca}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderFirca}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
    </Style>

    <Style x:Key="FormComboBox" TargetType="ComboBox">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="{StaticResource SurfaceFirca}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderFirca}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryFirca}"/>
    </Style>
</ResourceDictionary>
