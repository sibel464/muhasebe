<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════
         RENK PALETİ
    ═══════════════════════════════════════════════ -->
    <Color x:Key="LacivertKoyu">#0D1B3E</Color>
    <Color x:Key="LacivertOrta">#1A2F5E</Color>
    <Color x:Key="LacivertAcik">#243F7A</Color>
    <Color x:Key="LacivertVurgu">#2D5096</Color>
    <Color x:Key="BeyazAna">#FFFFFF</Color>
    <Color x:Key="GriAcik">#F4F6FA</Color>
    <Color x:Key="GriOrta">#E8ECF2</Color>
    <Color x:Key="GriMetin">#6B7280</Color>
    <Color x:Key="KoyuMetin">#1F2937</Color>
    <Color x:Key="VurguMavi">#3B82F6</Color>
    <Color x:Key="BasariYesil">#10B981</Color>
    <Color x:Key="UyariSarı">#F59E0B</Color>
    <Color x:Key="HataKirmizi">#EF4444</Color>
    <Color x:Key="MenuSeciliArka">#FFFFFF1A</Color>

    <!-- Fırçalar -->
    <SolidColorBrush x:Key="LacivertKoyuFirca" Color="{StaticResource LacivertKoyu}"/>
    <SolidColorBrush x:Key="LacivertOrtaFirca" Color="{StaticResource LacivertOrta}"/>
    <SolidColorBrush x:Key="LacivertAcikFirca" Color="{StaticResource LacivertAcik}"/>
    <SolidColorBrush x:Key="LacivertVurguFirca" Color="{StaticResource LacivertVurgu}"/>
    <SolidColorBrush x:Key="BeyazAnaFirca" Color="{StaticResource BeyazAna}"/>
    <SolidColorBrush x:Key="GriAcikFirca" Color="{StaticResource GriAcik}"/>
    <SolidColorBrush x:Key="GriOrtaFirca" Color="{StaticResource GriOrta}"/>
    <SolidColorBrush x:Key="GriMetinFirca" Color="{StaticResource GriMetin}"/>
    <SolidColorBrush x:Key="KoyuMetinFirca" Color="{StaticResource KoyuMetin}"/>
    <SolidColorBrush x:Key="VurguMaviFirca" Color="{StaticResource VurguMavi}"/>
    <SolidColorBrush x:Key="BasariYesilFirca" Color="{StaticResource BasariYesil}"/>
    <SolidColorBrush x:Key="HataKirmiziFirca" Color="{StaticResource HataKirmizi}"/>

    <!-- Gradient Fırça - Menü -->
    <LinearGradientBrush x:Key="MenuGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource LacivertKoyu}" Offset="0"/>
        <GradientStop Color="{StaticResource LacivertOrta}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Gradient Fırça - Giriş Arkaplanı -->
    <LinearGradientBrush x:Key="GirisGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource LacivertKoyu}" Offset="0"/>
        <GradientStop Color="{StaticResource LacivertVurgu}" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══════════════════════════════════════════════
         DÜĞME STİLLERİ
    ═══════════════════════════════════════════════ -->

    <!-- Ana Düğme -->
    <Style x:Key="AnaDugme" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource LacivertVurguFirca}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="kk" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource LacivertVurgu}" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="kk" Property="Background" Value="{StaticResource LacivertAcikFirca}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="kk" Property="Background" Value="{StaticResource LacivertKoyuFirca}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="kk" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menü Öğesi Düğmesi -->
    <Style x:Key="MenuOgeDugme" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#B8C5DC"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8" Margin="8,2"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aktif Menü Öğesi -->
    <Style x:Key="AktifMenuOgeDugme" TargetType="Button" BasedOn="{StaticResource MenuOgeDugme}">
        <Setter Property="Background" Value="#2AFFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ═══════════════════════════════════════════════
         METİN KUTUSU STİLİ
    ═══════════════════════════════════════════════ -->
    <Style x:Key="ModernMetinKutusu" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource GriAcikFirca}"/>
        <Setter Property="Foreground" Value="{StaticResource KoyuMetinFirca}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GriOrtaFirca}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource LacivertVurguFirca}"/>
                            <Setter TargetName="bd" Property="Background" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ŞİFRE KUTUSU STİLİ -->
    <Style x:Key="ModernSifreKutusu" TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource GriAcikFirca}"/>
        <Setter Property="Foreground" Value="{StaticResource KoyuMetinFirca}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GriOrtaFirca}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource LacivertVurguFirca}"/>
                            <Setter TargetName="bd" Property="Background" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════
         KART STİLİ
    ═══════════════════════════════════════════════ -->
    <Style x:Key="KartBorder" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.06"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════
         ETİKET STİLLERİ
    ═══════════════════════════════════════════════ -->
    <Style x:Key="SayfaBasligi" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource KoyuMetinFirca}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="SayfaAltBaslik" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource GriMetinFirca}"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="EtiketMetin" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource GriMetinFirca}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ═══════════════════════════════════════════════
         SEPARATOR
    ═══════════════════════════════════════════════ -->
    <Style x:Key="MenuAyirici" TargetType="Separator">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Margin" Value="16,8"/>
        <Setter Property="Height" Value="1"/>
    </Style>

</ResourceDictionary>
